@using RNF_Web.Models;
@model string
@{

}
@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}
<h4 id="Mensaje_PinpepOld"></h4>
<table id="table_PinpepOld" class=" table table-striped">
    <tr>
        <th>
            Expediente
        </th>
        <th>
            Finca y Lugar
        </th>
        <th>
            Modalidad
        </th>
        <th>
            Propietario
        </th>
        <th>
            Ultima Area Certificada
        </th>
        <th>
            Ultima Fase Certificada
        </th>
        <th></th>
    </tr>
    <tr>
        <td>
            <label class="form-label" id="lbl_Expediente_PinpepOld"></label>
        </td>
        <td>
            <label class="form-label" id="lbl_FincaLugar_PinpepOld"></label>
        </td>
        <td>
            <label class="form-label" id="lbl_Modalidad_PinpepOld"></label>
        </td>
        <td>
            <label class="form-label" id="lbl_Propietarios_PinpepOld"></label>
        </td>
        <td>
            <label class="form-label" id="lbl_UltimaAreaCertificada_PinpepOld"></label>
        </td>
        <td>
            <label class="form-label" id="lbl_UltimaFaseCertificada_PinpepOld"></label>
        </td>
        <td>
            <input type="button" class="btn btn-primary" id="Solicitud_PinpedOld" name="Solicitud_PinpedOld" value="Ingresar Expediente" onclick="IngresarSolicitud_PinpepOld('@Model')" style="visibility:hidden;" />
        </td>
    </tr>
</table>
<table id="table_ExpedientePinpepOld" class="table table-striped" style="visibility:hidden;">
    <tr>
        <th>
            <label class="control-label col-md-12">DPI de Titular</label>
        </th>
        <td colspan="2">
            <input type="text" id="DPI_Titular" name="DPI_Titular" class="form-control" onchange="consultarDPI()" />
        </td>
    </tr>
    <tr>
        <th>
            <label class="control-label col-md-12">Nombre de Propietario</label>
        </th>
        <td colspan="2">
            <input type="text" id="Nombre" name="Nombre" class="form-control" readonly />
        </td>
    </tr>
    <tr>
        <th>
            Tipo de Proyecto
        </th>
        <th>
            Región
        </th>
        <th>
            SubRegión
        </th>
    </tr>
    <tr>
        <td>
            <label class="form-label" id="lbl_TipoProyecto_PinpepOld"></label>
        </td>
        <td>
            <label class="form-label" id="lbl_Region_PinpepOld"></label>
        </td>
        <td>
            <label class="form-label" id="lbl_SubRegion_PinpepOld"></label>
        </td>
    </tr>
</table>
<div id="div_CreateConRegion"></div>
<div align="right">
    <input type="button" id="iniciarSolicitud" name="iniciarSolicitud" value="Iniciar Solicitud" class="btn btn-success" style="visibility:hidden;" onclick="CrearSolicitud()" />
</div>


<script>
    var Solicitud_PinpedOld = document.getElementById("Solicitud_PinpedOld");

    function agregarPropietarioIndividual_PinpepOld() {

    }

    function agregarPropietarioJuridico_PinpepOld() {

    }

    $(document).ready(function () {

        Solicitud_PinpedOld.style.visibility = "hidden";

        var Expediente = '@Model';
        var url = "@Url.Action("GetExpedientePinpepOld", "API_Probosque")";

        if ((Expediente.trim() != "") || (Expediente != null))
        {
            var data = {
                Expediente: Expediente
            };

            $.post(url, data).done(function (jsonRespuesta) {

                var oJSON = JSON.parse(jsonRespuesta);
                var Mensaje = oJSON.Mensaje;
                var table_PinpepOld = document.getElementById("table_PinpepOld");
                var Result = oJSON.Result;

                console.log(oJSON);

                if (Result != 1) {

                    Solicitud_PinpedOld.style.visibility = "hidden";
                    table_PinpepOld.style.visibility = "hidden";

                } else {

                    var Data = oJSON.Data;
                    var proyecto = Data.proyecto;

                    var Modalidad = proyecto.Modalidad;
                    var FincaLugar = proyecto.FincaLugar;
                    var UltimaAreaCertificada = proyecto.UltimaAreaCertificada;
                    var UltimaFaseCertificada = proyecto.UltimaFaseCertificada;
                    var Propietarios = proyecto.Propietarios;
                    var Propietarios_NoDPI = Propietarios.NoDPI;
                    var Propietarios_Nit = Propietarios.Nit;
                    var Propietarios_NombreCopmleto = Propietarios.NombreCompleto;

                    let fases = ['Mantenimiento 4', 'Mantenimiento 5', 'Manejo 9', 'Manejo 10']

                        Solicitud_PinpedOld.style.visibility = "visible";
                    if (fases.includes(UltimaFaseCertificada)) {
                    }


                    Expediente = proyecto.Expediente;

                    var lbl_Expediente = document.getElementById("lbl_Expediente_PinpepOld");
                    var lbl_FincaLugar = document.getElementById("lbl_FincaLugar_PinpepOld");
                    var lbl_UltimaAreaCertificada = document.getElementById("lbl_UltimaAreaCertificada_PinpepOld");
                    var lbl_Modalidad = document.getElementById("lbl_Modalidad_PinpepOld");
                    var lbl_UltimaFaseCertificada = document.getElementById("lbl_UltimaFaseCertificada_PinpepOld");
                    var lbl_Propietarios = document.getElementById("lbl_Propietarios_PinpepOld");

                    lbl_Expediente.innerHTML = Expediente;
                    lbl_FincaLugar.innerHTML = FincaLugar;
                    lbl_UltimaAreaCertificada.innerHTML = UltimaAreaCertificada;
                    lbl_Modalidad.innerHTML = Modalidad;
                    lbl_UltimaFaseCertificada.innerHTML = UltimaFaseCertificada;
                    lbl_Propietarios.innerHTML = "<strong>DPI:</strong> " + Propietarios_NoDPI + "<br><strong>Nit:</strong> " + Propietarios_Nit + "<br><strong>Nombre Completo:</strong> " + Propietarios_NombreCopmleto;

                }

            }).fail(function (jsonRespuesta) {

                var oJSON = JSON.parse(jsonRespuesta);
                var oJSON = jsonRespuesta;

            });
        }

    });
</script>
