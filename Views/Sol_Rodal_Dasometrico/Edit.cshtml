@using RNF_Web.Models;
@using System.Data.SqlClient;
@model RNF_Web.Models.Tbl_Sol_Rodal_Dasometrico

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}


@{
    Layout = "~/Views/Shared/_LayoutSimple.cshtml";

    db_RNFEntities db = new db_RNFEntities();

    Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(Session[Constants.session_Solicitud]);

    int intSubCategoria = db.Tbl_Sol_Solicitud_Sub_Categoria.Where(Obj => Obj.Categoria_id == tbl_sol_solicitud.Categoria_id && Obj.Sub_Categoria_id == tbl_sol_solicitud.Sub_Categoria_id && (Obj.Descripcion.Contains("linea") || Obj.Descripcion.Contains("línea"))).Count();
    int intSubSubCategoria = db.Tbl_Sol_Solicitud_Sub_Sub_Categoria.Where(Obj => Obj.Categoria_id == tbl_sol_solicitud.Categoria_id && Obj.Sub_Categoria_id == tbl_sol_solicitud.Sub_Categoria_id && Obj.Sub_Sub_Categoria_id == tbl_sol_solicitud.Sub_Sub_Categoria_id && (Obj.Descripcion.Contains("linea") || Obj.Descripcion.Contains("línea"))).Count();

    if ((intSubCategoria > 0) || (intSubSubCategoria > 0))
    {
        ViewBag.ArbolesEnLinea = 1;
    }
    else
    {
        ViewBag.ArbolesEnLinea = 0;
    }

    int intCategoria = db.Tbl_Sol_Solicitud_Categoria.Where(Obj => Obj.Categoria_id == tbl_sol_solicitud.Categoria_id && (Obj.Descripcion.Contains("SEMILLERA") || Obj.Descripcion.Contains("Semillera"))).Count();
    intSubCategoria = db.Tbl_Sol_Solicitud_Sub_Sub_Categoria.Where(Obj => Obj.Categoria_id == tbl_sol_solicitud.Categoria_id && Obj.Sub_Categoria_id == tbl_sol_solicitud.Sub_Categoria_id && (Obj.Descripcion.Contains("bosque") || Obj.Descripcion.Contains("Bosque"))).Count();

    if ((intCategoria > 0))
    {
        ViewBag.Semillera = 1;
    }
    else
    {
        ViewBag.Semillera = 0;

    }

    if ((intSubCategoria > 0))
    {
        ViewBag.Bosque = 1;
    }
    else
    {
        ViewBag.Bosque = 0;
    }


}


<script src="~/Scripts/jquery-3.6.0.js"></script>
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.js"></script>

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<script>
    $(document).ready(function () {

        var AnioEstablecimiento = $('#Anio_Establecimiento').val();
        var TdToShowA = document.getElementById("DeclaracionJurada");
        if (AnioEstablecimiento <= 1996 && AnioEstablecimiento >= 1300) {
            TdToShowA.style.display = "block";
        }
        else {
            TdToShowA.style.display = "none";
        }


        var var_rodal_id = $('#Rodal_id').val();
          $.ajax({
                type: 'POST',
                url: "@(Url.Action("GetTipoArea", "Sol_Rodal_Dasometrico"))",
                     dataType: 'json',
                    data: { rodal_id: var_rodal_id},
                   success: function (doc) {
                       $('#titulo').html('Datos dasométricos de ' + doc);
                    },
                    error: function (ex) {
                        alert('Ocurrio un error aqui. ' + ex.status);
                    }

                });

        $(document).on('change', '#Anio_Establecimiento', function () {

            var AnioEstablecimiento = $('#Anio_Establecimiento').val();
            var TdToShowA = document.getElementById("DeclaracionJurada");
            if (AnioEstablecimiento <= 1996) {
                TdToShowA.style.display = "block";
            }
            else
            {
                TdToShowA.style.display = "none";
            }

        }); // -----Fin de Change ddlDepartamento

        $(document).on('change', '#Rodal_id', function () {

            var var_rodal_id = $('#Rodal_id').val();

                $.ajax({
                type: 'POST',
                url: "@(Url.Action("GetTipoArea", "Sol_Rodal_Dasometrico"))",
                     dataType: 'json',
                    data: { rodal_id: var_rodal_id},
                   success: function (doc) {
                       $('#titulo').html('Datos dasométricos de ' + doc);
                    },
                    error: function (ex) {
                        alert('Ocurrio un error aqui. ' + ex.status);
                    }

                });




        }); // -----Fin de Change ddlDepartamento



    });

</script>

