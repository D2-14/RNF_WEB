@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}



@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}



@{
    db_RNFEntities db = new db_RNFEntities();
    Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(Session[Constants.session_Solicitud]);

    ViewBag.Categoria_id = tbl_sol_solicitud.Categoria_id;
}


<script>

    $(document).ready(function () {

        $('#datosdasometricos').load('/ReportePV/Index?Solicitud_id=@ViewBag.Solicitudid')

        $('#gestionCultivos').load('/Sol_Rodal_Cultivo/Create?Guid=@ViewBag.Guid')

    });



</script>

<div id="section_RodalDasometricos">
    @model IEnumerable<RNF_Web.Models.Tbl_Sol_Rodal_Dasometrico>
    <div class="container-fluid">
        <div class="titulo-dos">
            <h4>Detalle de datos dasométricos cargados</h4>
        </div>

        <div class="row mt-2">
            <div class="col">
            </div>
            <div class="col">
            </div>
            <div class="col text-center">
                <div class="d-grid gap-2">

                    <button class="btn-next-ic" onclick="AgregarRodalDasometricos(); return false;">
                        <i class="fa in fa-plus-circle" aria-hidden="true"></i><br />Agregar datos dasométricos
                    </button>

                    <a href="/Content/SoporteAudioVisualUsuario/006_Poligonos.mp4" target="_blank">
                        <img width="50" height="auto" src="~/Content/icons/VideoTutoria.gif" />
                    </a>

                </div>
            </div>
            <div>
            </div>
        </div>


        <br />

        <a href="/Sol_Rodal_Dasometrico/DatosDasometricosCargados?Solicitud_id=@ViewBag.Solicitudid&firma=@ViewBag.Guid" target="_blank">
            <input type="button" class="btn-next-ic" value="Visualizar datos cargados" />
        </a>

        <br />
        <br />

    </div>

    <div id="datosdasometricos"></div>


    @if (ViewBag.Categoria_id == 4)
    {
        <div id="gestionCultivos"></div>
    }
    else
    {
        <div id="gestionCultivos" hidden></div>
    }

</div>