@model RNF_Web.Models.Tbl_RNF_ArrendatarioPersonaIndividual
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@{

    Layout = "~/Views/Shared/_LayoutSimple.cshtml";
    EdicionRNFGrants objRNFGrants = (EdicionRNFGrants)Session[Constants.session_EdicionRNFGrants];

}

<script src="~/Scripts/jquery-3.6.0.js"></script>
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.js"></script>

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>



<script>

    $(document).ready(function () {


        $("#Fecha_Nacimiento").datepicker({
            dateFormat: "dd/mm/yy",
            yearRange: "-120:+0",
            changeMonth: true,
            changeYear: true
        });


        $(document).on('change', '#No_Documento', function () {
            var Constancia = $('#DocumentoID_Tipo').val();
            var No_Documento = $('#No_Documento').val();


            if (Constancia == 0) {
                document.getElementById("mensaje").innerHTML = "Debe especificar el tipo de documento de identificación";
            }
            else {
                if (Constancia == 1) {
                    if (isNaN(No_Documento) || No_Documento < 1000000000000 || No_Documento > 9999999999999) {
                        text = "El número de DPI es invalido.";
                    }
                    else {
                        text = "";
                    }

                    document.getElementById("mensaje").innerHTML = text;
                }
                else {
                    document.getElementById("mensaje").innerHTML = "";
                }
            }




        });

        $(document).on('change', '#DepartamentoDPI_id', function () {

            var url = "@Url.Action("GetMunicipios", "Sol_Solicitud")";
            var Departamento = $('#DepartamentoDPI_id').val();
            var data = { Departamento: Departamento};

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#MunicipioDPI_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text: municipio.Text
                    }));

                });


            }).fail(manejarErrorAjax).always(function () {
            });


        }); // -----Fin de Change ddlDepartamento


    }); // -----Fin

</script>
<br />

