@using RNF_Web.Models;
@model Tbl_Sol_Motosierra_Marca_Modelo
@{
    db_RNFEntities db = new db_RNFEntities();
    Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(Session[Constants.session_Solicitud]);
    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    string Nombre_Div = "div_Sol_Motosierra_MarcaModelo_Create";
    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }
    fc_Gral_Sol_Configuracion_Result permisos = db.fc_Gral_Sol_Configuracion(tbl_sol_solicitud.Solicitud_id, controllerName, boolEsInterno).FirstOrDefault();
}

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
    <div id="@Nombre_Div"></div>
}
<br />
<div style='height: 30px; width: 100%; background-color: #66bb6a; color: white; '>
    <h4>Listado de maquinaria utilizada</h4>
</div>


@if ((bool)permisos.Agregar)
{
    <table class="table">
        <tr>
            <th>
                Marca y Modelo
            </th>
            <th>
            </th>
        </tr>
        <tr>
            <td>
                <input type="text" name="Marca" id="Marca" value="" placeholder="Marca" class="form-control" />
            </td>
            <td>
                <input type="text" name="Modelo" id="Modelo" value="" placeholder="Modelo" class="form-control" />
            </td>
        </tr>
    </table>
    <div class="col-sm-12 col-md-12" align="right">
        <input align="right" type="button" name="Agregar" id="Agregar" value="Agregar" onclick="agregarMotosierraMarcaModelo()" class="btn btn-sm btn-success" />
    </div>

}

<script>
    function visualizarPermisos(solicitudid, controllername, esinterno, nombrediv) {
        var solicitudId = solicitudid;
        var controllerName = controllername;
        var esInterno = esinterno;

        var mySolPermisos = document.getElementById(nombrediv);
        if (mySolPermisos) {
            $("#" + nombrediv).load("/Gral_SolicitudConfiguracion/PermisosRecibidos?Solicitud_id=" + solicitudId + "&controllerName=" + controllerName + "&EsInterno=" + esInterno);
        }

    }

    function refreshViewMotosierraMarcaModelo() {
        $('#listadoMotosierrasMarcaModelo').load('/Sol_Motosierra_MarcaModelo/Index?Solicitud_id=@ViewBag.Solicitud_id');
    }

    $(document).ready(function () {
        visualizarPermisos('@tbl_sol_solicitud.Solicitud_id', '@controllerName', '@objUs.EsInterno', '@Nombre_Div');
        refreshViewMotosierraMarcaModelo();
    });


    function agregarMotosierraMarcaModelo() {
        var Solicitud_id = '@ViewBag.Solicitud_id';
        var Marca = document.getElementById("Marca").value;
        var Modelo = document.getElementById("Modelo").value;

        if ((Marca == null) || (Marca.trim() == "")) {
            alert("Error, debe indicar la marca a registrar");
            return;
        }

        if ((Modelo == null) || (Modelo.trim() == "")) {
            alert("Error, debe indicar el modelo a registrar");
            return;
        }

        var data = {
            Solicitud_id: Solicitud_id,
            Marca: Marca,
            Modelo: Modelo
        }

        var url = "@Url.Action("AgregarMotosierraMarcaModelo", "Sol_Motosierra_MarcaModelo")";

        $.post(url, data).done(function (jsonRespuesta) {
            var oJSON = JSON.parse(jsonRespuesta);
            var CodRespuesta = oJSON.CodRespuesta;
            var strRespuesta = oJSON.strRespuesta;

            if (CodRespuesta == 1) {
                document.getElementById("Marca").value = "";
                document.getElementById("Modelo").value = "";
                refreshViewMotosierraMarcaModelo();

            } else {
                alert(strRespuesta);
                refreshViewMotosierraMarcaModelo();
            }

        }).fail(function (jsonRespuesta) {
            var oJSON = JSON.parse(jsonRespuesta);

        });

    }

</script>

<div id="listadoMotosierrasMarcaModelo"></div>
