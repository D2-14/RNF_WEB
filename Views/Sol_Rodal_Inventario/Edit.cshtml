@using RNF_Web.Models;
@using System.Data.SqlClient;
@model RNF_Web.Models.Tbl_Sol_Rodal_Inventario


@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}


@{
    Layout = "~/Views/Shared/_LayoutSimple.cshtml";

}


<script src="~/Scripts/jquery-3.6.0.js"></script>
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.js"></script>

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @Html.HiddenFor(model => model.Solicitud_id)

    @Html.HiddenFor(model => model.swcreatedby)
    @Html.HiddenFor(model => model.swdatecreated)
    @Html.HiddenFor(model => model.swcreatedbyinterno)

    @Html.HiddenFor(model => model.swdateupdated)
    @Html.HiddenFor(model => model.swupdatedby)
    @Html.HiddenFor(model => model.swupdatedbyinterno)
    @Html.HiddenFor(model => model.Estado_id)

    <div class="container">
        <div class="titulo-dos">
            <h3 id="titulo">Datos del árbol..</h3>
        </div>

        <table class="table table-condensed">
            <tr>
                <td>
                    @Html.LabelFor(model => model.Rodal_id, "Rodal_id", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("Rodal_id", null, htmlAttributes: new { @class = "form-select", @readonly = "readonly" })
                        @Html.ValidationMessageFor(model => model.Rodal_id, "", new { @class = "text-danger" })
                    </div>
                </td>
                <td>
                    @Html.LabelFor(model => model.Arbol_id, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Arbol_id, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.Arbol_id, "", new { @class = "text-danger" })
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    @Html.LabelFor(model => model.Especie_Id, "Especie_Id", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("Especie_Id", null, htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.Especie_Id, "", new { @class = "text-danger" })
                    </div>
                </td>
                <td>
                    @Html.LabelFor(model => model.InventarioClase_id, "InventarioClase_id", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("InventarioClase_id", null, htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.InventarioClase_id, "", new { @class = "text-danger" })
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    @Html.LabelFor(model => model.GTMX, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.GTMX, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.GTMX, "", new { @class = "text-danger" })
                    </div>
                </td>
                <td>
                    @Html.LabelFor(model => model.GTMY, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.GTMY, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.GTMY, "", new { @class = "text-danger" })
                    </div>

                </td>
            </tr>
            <tr>
                <td>
                    @Html.LabelFor(model => model.DAP, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.DAP, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.DAP, "", new { @class = "text-danger" })
                    </div>
                </td>
                <td>
                    @Html.LabelFor(model => model.Altura, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Altura, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Altura, "", new { @class = "text-danger" })
                    </div>
                </td>
            </tr>
            <tr>
                <td></td>
                <td>
                    @Html.LabelFor(model => model.EstadoFitosanitario_id, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("EstadoFitosanitario_id", null, htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.EstadoFitosanitario_id, "", new { @class = "text-danger" })
                    </div>
                </td>
            </tr>
        </table>

        <div class="col-sm-12 col-md-12" align="right">
            <h4>@ViewBag.Mensaje</h4>
            <input type="submit" value="Guardar cambios" class="btn-next" />
        </div>


    </div>
}




