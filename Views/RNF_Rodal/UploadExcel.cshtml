
@using RNF_Web.Models;
@{
    Layout = "~/Views/Shared/_LayoutMoreSimple.cshtml";
    string No_Registro = ViewBag.No_Registro;


    if (Session[Constants.session_Tabulador] == null)
    {
        Session[Constants.session_Tabulador] = "defaultArea";
    }

}
@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

<script src="~/Scripts/jquery-3.6.0.js"></script>
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.js"></script>

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>


<style>
    body {
        font-family: Arial;
    }

    /* Style the tab */
    .tab {
        overflow: hidden;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.3s;
            font-size: 17px;
            border-color: #6C8EAA;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
                border-radius: .50em;
                border: .2em solid #fff;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #6C8EAA;
                color: white;
                border-color: #6C8EAA;
                border-radius: .50em;
                border: .2em solid #fff;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 6px 12px;
        -webkit-animation: fadeEffect 1s;
        background: #FAFAC1;
        animation: fadeEffect 1s;
        padding: 2em 3em;
        border-radius: .50em;
        border: .2em solid #fff;
        border-color: #6C8EAA;
    }
</style>

<div class="tab">
    <button class="tablinks" onclick="openCity(event, 'Area')" id="defaultArea">Polígono</button>
    <button class="tablinks" onclick="openCity(event, 'Descuento')" id="defaultDescuento">Polígonos de descuento</button>
    <button class="tablinks" onclick="openCity(event, 'Dasometricos')" id="defaultDasometricos">Datos dasométricos</button>
</div>
<div id="Area" class="tabcontent">
    <div id="CargaArea"></div>
</div>

<div id="Descuento" class="tabcontent">
    <div id="CargaAreaDescuento"></div>
</div>

<div id="Dasometricos" class="tabcontent">
    <br />
    <div id="CargaDasometricos"></div>
</div>


<script>

    $(document).ready(function () {
        //loaderPantalla(false);
        $('#CargaArea').load("/RNF_Rodal/UploadExcelAreas?No_Registro=@No_Registro");
        $('#CargaAreaDescuento').load("/RNF_Rodal/UploadExcelAreasDescuento?No_Registro=@No_Registro");
        $('#CargaDasometricos').load("/RNF_Rodal/UploadDatosDasometricos?No_Registro=@No_Registro");
    });

</script>



<script>
    function openCity(evt, cityName) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tabcontent");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }
        tablinks = document.getElementsByClassName("tablinks");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }
        document.getElementById(cityName).style.display = "block";
        evt.currentTarget.className += " active";
    }

    // Get the element with id="defaultOpen" and click on it
    /**/
    document.getElementById('@Session[Constants.session_Tabulador]').click();
</script>