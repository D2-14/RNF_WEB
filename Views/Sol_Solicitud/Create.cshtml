@model RNF_Web.Models.Tbl_Sol_Solicitud
@using RNF_Web.Models;


@{
    db_RNFEntities db = new db_RNFEntities();

    ViewBag.Title = "Create";

    bool DeshabilitarOpcion = false;

    decimal resultante = Model.SolicitudTipo_id - Math.Truncate(Model.SolicitudTipo_id);
    if ((resultante > 0.00M) || (Model.Procedencia_PinpepNew) || (Model.Procedencia_PinpepOld) || (Model.Procedencia_Probosque) || (Model.Procedencia_secorf))
    {
        DeshabilitarOpcion = true;
    }

}


@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}

