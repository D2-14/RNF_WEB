<script src="~/Scripts/jquery-3.6.0.js"></script>
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.js"></script>

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<script>

    $(document).ready(function () {

        $(document).on('change', '#lstDepartamento', function () {

            var url = "@Url.Action("GetMunicipios", "Sol_Empresa_Entidad_ViveroForestal")";
            var Departamento = $('#lstDepartamento').val();
            var data = { Departamento: Departamento};

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#lstMunicipio");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text: municipio.Text
                    }));

                });


            });


        }); // -----Fin de Change ddlDepartamento


    });

    function AgregarViveroForestal() {

        var No_Registro = '@No_Registro';
        var EspecieId = $('#lstEspecie').val();
        var ProduccionAnual = $('#ProduccionAnual').val();
        var NombreFinca = $('#NombreFinca').val();
        var DepartamentoId = $('#lstDepartamento').val();
        var MunicipioId = $('#lstMunicipio').val();
        var PaisId = $('#lstPais').val();
        var CodigoRNF = $('#CodigoRNF').val();
        var NumeroNotaControl = $('#NumeroNotaControl').val();

        var url = "@Url.Action("AgregarViveroForestal", "RNF_Empresa_Entidad_ViveroForestal")";
        var data = {
            No_Registro: No_Registro,
            EspecieId: EspecieId,
            ProduccionAnual: ProduccionAnual,
            NombreFinca: NombreFinca,
            DepartamentoId: DepartamentoId,
            MunicipioId: MunicipioId,
            PaisId: PaisId,
            CodigoRNF: CodigoRNF,
            NumeroNotaControl: NumeroNotaControl
        };

        $.post(url, data).done(function (jsonRespuesta) {

            var objJSON = JSON.parse(jsonRespuesta);
            var Cod_Respuesta = objJSON.CodRespuesta;
            var Texto_Respuesta = objJSON.strRespuesta;

            alert(Texto_Respuesta);

            $('#tbodyTransTemp').html(Tabla_Temp_Orig);
            mensaje.text("");

        });


    }


</script>

