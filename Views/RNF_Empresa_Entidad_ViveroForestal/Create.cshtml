                </div>
            </td>
            <td>
                <div class="col-md-12">
                    <input type="text" id="ProduccionAnual" name="ProduccionAnual" class="form-control" />
                </div>
            </td>
            <td>
                <div class="col-md-12">
                    <input type="text" id="NombreFinca" name="NombreFinca" class="form-control" />
                </div>
            </td>
        </tr>
        <tr>
            <td>
                @Html.LabelFor(model => model.Departamento_Vivero, "Departamento", htmlAttributes: new { @class = "control-label col-md-4" })

            </td>
            <td>
                @Html.LabelFor(model => model.Municipio_Vivero, "Municipio", htmlAttributes: new { @class = "control-label col-md-4" })
            </td>
            <td>
                @Html.LabelFor(model => model.Pais_Procedencia, "Pais", htmlAttributes: new { @class = "control-label col-md-4" })
            </td>
        </tr>
        <tr>
            <td>
                <div class="col-md-12">
                    @Html.DropDownList("lstDepartamento", null, htmlAttributes: new { @class = "form-select" })
                </div>
            </td>

            <td>
                <div class="col-md-12">
                    @Html.DropDownList("lstMunicipio", null, htmlAttributes: new { @class = "form-select" })
                </div>
            </td>

            <td>
                <div class="col-md-12">
                    @Html.DropDownList("lstPais", null, htmlAttributes: new { @class = "form-select" })
                </div>
            </td>
        </tr>
        <tr>
            <td>
                @Html.LabelFor(model => model.Codigo_RNF, "Codigo RNF", htmlAttributes: new { @class = "control-label col-md-12" })
            </td>
            <td>
                @Html.LabelFor(model => model.Numero_Nota_Control_Semilla_Certificada, "No. Nota Control", htmlAttributes: new { @class = "control-label col-md-12" })
            </td>
