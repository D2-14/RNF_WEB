    function changeRegionGrant(region_id, subregion_id, nuevoestado) {

        var url = "@Url.Action("CambioAsignacionRegion", "Seg_Usuario")";
        var data = { usuario_id: @Model.Usuario_id, region_id: region_id, subregion_id: subregion_id, nuevoestado: nuevoestado};

        $.post(url, data).done(function (Listdata) {
        //  here inicio
            $('#autoSubRegionesAsignadas').load('/Seg_Usuario/UsuarioPermisosRegion/'+ @Model.Usuario_id)
        }).fail(manejarErrorAjax).always(function () {

         $('#autoSubRegionesAsignadas').load('/Seg_Usuario/UsuarioPermisosRegion/'+ @Model.Usuario_id)

        });

         $('#autoSubRegionesAsignadas').load('/Seg_Usuario/UsuarioPermisosRegion/'+ @Model.Usuario_id)

    }




    function change(rol_id, nuevoestado) {

        var url = "@Url.Action("CambioAsignacion", "Seg_Usuario")";
        var data = { usuario_id: @Model.Usuario_id, rol_id: rol_id, nuevoestado: nuevoestado};

        $.post(url, data).done(function (Listdata) {
        //  here inicio
         $('#autoRolesAsignados').load('/Seg_Usuario/UsuarioPermisos/'+ @Model.Usuario_id)
        }).fail(manejarErrorAjax).always(function () {

         $('#autoRolesAsignados').load('/Seg_Usuario/UsuarioPermisos/'+ @Model.Usuario_id)

        });

         $('#autoRolesAsignados').load('/Seg_Usuario/UsuarioPermisos/'+ @Model.Usuario_id)

    }


     function GrabarUsuario() {

         var EnviarWhatsapp = document.querySelector('#chkNotificacionWhatsapp');

         var varUsuario_id = $('#Usuario_id').val();
         var varNombre = $('#Nombre').val();
         var varApellidos = $('#Apellidos').val();
         var varUsuario = null;
         var varemail = $('#email').val();
         var varwhatsapp = $('#whatsapp').val();
         var varPalabraClave = $('#PalabraClave').val();
         var varswdatecreated = $('#swdatecreated').val();
         var varswcreatedby = $('#swcreatedby').val();

         var varEstado = document.querySelector('#chkEstado');
         var varEstadoEmpleado = varEstado.checked;

         var varCasillero = document.querySelector('#chkCasilleroElectronico');
         var varCasilleroElectronico = varCasillero.checked;

         var DocumentoID_Tipo = $('#DocumentoID_Tipo').val();
         var No_Documento = $('#No_Documento').val();



         var varEmpleado_id = $('#Empleado_id').val();
         var varNotificacionWhatsapp = EnviarWhatsapp.checked;

        var url = "@Url.Action("GrabarUsuario", "Seg_Usuario")";

         var data = {
             Usuario_id: varUsuario_id,
             Nombre: varNombre,
             Apellidos: varApellidos,
             Usuario: varUsuario,
             email: varemail,
             whatsapp: varwhatsapp,
             PalabraClave: varPalabraClave,
             swdatecreated: varswdatecreated,
             swcreatedby: varswcreatedby,
             Estado: varEstadoEmpleado,
             Empleado_id: varEmpleado_id,
             NotificacionWhatsapp: varNotificacionWhatsapp,
             CasilleroElectronico: varCasilleroElectronico,
             DocumentoID_Tipo: DocumentoID_Tipo,
             No_Documento: No_Documento
         };


         $.post(url, data).done(function (Listdata) {
             var objJSON = JSON.parse(Listdata);
             var Cod_Respuesta = objJSON.CodRespuesta;
             var Texto_Respuesta = objJSON.strRespuesta;

             if (Cod_Respuesta == 0) {
                 $('#lblMensaje').text(Texto_Respuesta);
             } else if (Cod_Respuesta == 1) {
                 alert(Texto_Respuesta);
             }

        }).fail(manejarErrorAjax).always(function () {
            alert('Error no identificado.');
        });

    }


</script>


