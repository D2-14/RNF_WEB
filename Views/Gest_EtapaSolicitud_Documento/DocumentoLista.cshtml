@using RNF_Web.Models;
@model IEnumerable<RNF_Web.Models.Tbl_Gest_EtapaSolicitud_Documento>
@{
    db_RNFEntities db = new db_RNFEntities();
    string Guid_id = ViewBag.Guid_id;
    string GuidEtapa_id = ViewBag.GuidEtapa_id;
    int etapa_id = ViewBag.etapa_id;
    decimal etaparuta_id = ViewBag.etaparuta_id;
    int correlativoetapa_id = ViewBag.correlativoetapa_id;
    long Solicitud_id = ViewBag.Solicitud_id;

    Tbl_Sol_Solicitud tbl_Sol_Solicitud = db.Tbl_Sol_Solicitud.Find(Solicitud_id);

    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    string actionName = HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString();
    Layout = null;
}


<script type="text/javascript">



    $(document).ready(function () {

        $("#btnHideModal").click(function () {
            $("#imgModal").modal('hide');
        });
        $("#btnHideModalCerrar").click(function () {
            $("#imgModal").modal('hide');
        });

        $("#btnRecepcionDocs").click(function () {
            $("#imgModal").modal('show');
        });

    });

    function hide_myModal() {
        $("#imgModal").modal('hide');
    }





    // ----------------------DOCUMENTACION IMPORTANTE----------------------
    //  Cuando la vista parcial está metida en puntos donde no puede llegar a mostrar correctamente algún dato
    //  se usará la función que se encuentra comentada en lugar de la existente



    function gestEtapaSolicitudDocumentoMostrar(id, filename) {
        var Solicitud_id = '@tbl_Sol_Solicitud.Solicitud_id';
        var Etapa_id = '@etapa_id';
        var EtapaRuta_id = '@etaparuta_id';
        var CorrelativoEtapa_id = '@correlativoetapa_id';
        var Documento_id = id;
        var dataData = {
            Solicitud_id: Solicitud_id,
            Etapa_id: Etapa_id,
            EtapaRuta_id: EtapaRuta_id,
            CorrelativoEtapa_id: CorrelativoEtapa_id,
            Documento_id: Documento_id
        }

        var url = "@(Url.Action("Obtenerhref", controllerName))";

        $.post(url, dataData).done(function (doc) {
            var extension = filename.substr((filename.lastIndexOf(".") + 1 - filename.length));
            extension = extension.toLowerCase();
            console.log(extension);
            var imgDoc = document.getElementById("imDoc");
            var ifDoc = document.getElementById("ifDoc");
            var miHref = document.getElementById("miHref");
            //jQuery.noConflict();

            if (extension == "pdf" || extension == "jpg" || extension == "bmp" || extension == "png" || extension == "gif") {

                if (extension == "pdf") {
                    imgDoc.src = "";
                    ifDoc.src = doc;
                    ifDoc.style.visibility = "visible";
                    miHref.href = doc;

                    $("#imgModal").modal('show');

                }
                else {

                    ifDoc.src = "";
                    imgDoc.src = doc;
                    miHref.href = doc;
                    $("#imgModal").modal('show');
                    ifDoc.style.visibility = "hidden";
                }
            }
            else {
                window.location.href = doc;
            }
        }).fail(function (ex) {
            console.log(ex);
            alert('error. ' + ex.status);
        });

        return false;

    }

