@using RNF_Web.Models;
@model IEnumerable<RNF_Web.Models.Tbl_Sol_Rodal>
@{ 

}
@if(Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}
@if(Model.Count() > 0)
{
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Finca_id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rodal_Id)
            </th>
            <th>
                Tipo de Area
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GTMX)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GTMY)
            </th>
            <th>
                Tipo de Registro Secorf
            </th>
            <th>
            </th>
        </tr>

    @foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Finca_id)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Rodal_Id)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Tbl_Sol_Rodal_Tipo.Descripcion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.GTMX)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.GTMY)
        </td>
        <td>
            @if (item.Secorf_TipoRegistro_id != null)
            {
                @(item.Tbl_Gral_Secorf_TipoRegistro.Descripcion??"")
            }
        </td>
        <td>
            <input type="button" class="btn btn-primary" value="Editar" onclick="EditarRodalSecorf('@item.Finca_id','@item.Rodal_Id','@item.Tipo_de_Area')" />
        </td>
    </tr>
    }

    </table>
}
