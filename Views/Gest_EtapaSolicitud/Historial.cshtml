@using RNF_Web.Models;
@model Tbl_Sol_Solicitud



@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Url.Action("Historial", "Gest_EtapaSolicitud")
}


@{
    //Layout = null;

    if (ViewBag.Layout == "Si")
    {
        Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_LayoutSimple.cshtml";
    }
    ViewBag.Title = "Etapas por las que ha pasado la solicitud";
    ViewBag.SubTitle = null;
    ViewBag.swdateinicio = String.Format("{0:yyyy-MM-dd}", ViewBag.FechaInicio);
    ViewBag.swdatefinal = String.Format("{0:yyyy-MM-dd}", ViewBag.FechaFin);
}





<div class="titulo-dos">
    <h4>@ViewBag.Title</h4>
</div>


<div align="center" class="form-group">
    <table class="table table-striped">
        <tr>
            <th scope="col" class="form-label">Fecha Inicio</th>
            <th scope="col" class="form-label">Fecha Fin</th>
        </tr>
        <tr>
            <td><input type="date" class="form-control fechainicio" name="FechaInicio" id="FechaInicio" value="@ViewBag.swdateinicio" onchange=" cambiofechainicio() " /></td>
            <td><input type="date" class="form-control fechafin" name="FechaFin" id="FechaFin" value="@ViewBag.swdatefinal" onchange=" cambiofechafin() " /></td>
        </tr>
    </table>
</div>

<div id="div_Historial"></div>


<script>
    $(document).ready(function () {
        var myHistorial = document.getElementById('div_Historial');
        if (myHistorial) {
            $('#div_Historial').load("/Gest_EtapaSolicitud/IndexHistorial?Expediente=@Model.Guid_id");
        }

        $("#btnHideModal").click(function () {

              $('#section_Link_II').load('@ViewBag.section_Link_II')
              $('#section_Link_III').load('@ViewBag.section_Link_III')
              $('#section_Link_IV').load('@ViewBag.section_Link_IV')
              $('#section_Link_V').load('@ViewBag.section_Link_V')

              $("#myModal").modal('hide');
        });


        $("#btnHideModal_Close").click(function () {


              $('#section_Link_II').load('@ViewBag.section_Link_II')
              $('#section_Link_III').load('@ViewBag.section_Link_III')
              $('#section_Link_IV').load('@ViewBag.section_Link_IV')
              $('#section_Link_V').load('@ViewBag.section_Link_V')


                $("#myModal").modal('hide');
        });


    });

    var fechainiciojs = document.querySelector('.FechaInicio').value;
    var fechafinjs = document.querySelector('.FechaFin').value;


    function cambiofechainicio() {
        fechainiciojs = document.querySelector('.FechaInicio').value;
        actualizaHistorial();
    }

    function cambiofechafin() {
        fechafinjs = document.querySelector('.FechaFin').value;
        actualizaHistorial();
    }

    function cambioparametrobusqueda() {
        expedientejs = document.getElementById('Expediente').value;
        actualizaHistorial();
    }

    function actualizaHistorial() {
        var myHistorialActualizar = document.getElementById('div_Historial');
        if (myHistorialActualizar)
        {
            $('#div_Historial').load("/Gest_EtapaSolicitud/IndexHistorial?FechaInicio=" + fechainiciojs + "&FechaFin=" + fechafinjs + "&Expediente=@Model.Guid_id"  );
        }

    }




    $("#myModal").on('show.bs.modal', function () {
        var modal = $(this)
        modal.find('.modal-title').text(document.getElementById("Titulo").value);
        modal.find('.modal-body').html(document.getElementById("Pagina").value);
    });




</script>