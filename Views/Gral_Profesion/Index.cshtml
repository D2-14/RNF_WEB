
@model IEnumerable<RNF_Web.Models.Tbl_Gral_Profesion>
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}


@{
    Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
    ViewBag.Title = "Profesiones";
    ViewBag.SubTitle = "Listado de profesiones";
}

@Html.Partial("_PartialPageEncabezado")

<button class="btn-secondary" style="position: absolute; right: 0;" rel="tooltip" title="Agregar" onclick="location.href='@Url.Action("Create", "Gral_Profesion")'">
    <i><img src="~/Content/icons/add_simple.png" style="border-radius: 30%; width: 45px; height: auto" /></i>
    <div class="ripple-container"></div>
</button>

<br />
<br />

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Descripcion)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Tecnico)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Profesional)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Regente)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ElaboradorDePlanesManejoForestal)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ElaboradorDeEstudiosUsodelSuelo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CertificadorDeFuentesSemilleras)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tecnico)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Profesional)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Regente)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ElaboradorDePlanesManejoForestal)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ElaboradorDeEstudiosUsodelSuelo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CertificadorDeFuentesSemilleras)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.Profesion_id }) |
                @Html.ActionLink("Details", "Details", new { id = item.Profesion_id }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.Profesion_id })
            </td>
        </tr>
    }

</table>


@Html.Partial("_PartialPageEncabezadoCierre")




