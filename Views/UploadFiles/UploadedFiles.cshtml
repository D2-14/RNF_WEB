    function Mostrar(id, filename) {
        $.ajax({
                    type: 'POST',
                    url: "@(Url.Action("Obtenerhref", "UploadFiles"))",
                    dataType: 'json',
            data: { id: id, varfilename: filename, solicitud_id: @ViewBag.solicitud_id , firma: '@ViewBag.firma' },
            success: function (doc) {


                var imgDoc = document.getElementById("imDoc");
                var ifDoc = document.getElementById("ifDoc");
                var miHref = document.getElementById("miHref");

                if (filename.split(".")[1] == "pdf" || filename.split(".")[1] == "PDF" ||
                    filename.split(".")[1] == "jpg" || filename.split(".")[1] == "JPG" ||
                    filename.split(".")[1] == "bmp" || filename.split(".")[1] == "BMP" ||
                    filename.split(".")[1] == "png" || filename.split(".")[1] == "PNG" ||
                    filename.split(".")[1] == "gif" || filename.split(".")[1] == "GIF") {

                    if (filename.split(".")[1] == "pdf" || filename.split(".")[1] == "PDF") {
                        imgDoc.src = "";
                        ifDoc.src = doc;
                        ifDoc.style.visibility = "visible";
                        miHref.href = doc;
                        $("#imgModal").modal('show');
                    }
                    else {

                        ifDoc.src = "";
                        imgDoc.src = doc;
                        miHref.href = doc;
                        $("#imgModal").modal('show');
                        ifDoc.style.visibility = "hidden";
                    }
                }
                else {
                    window.location.href = doc;
                }

            },
            error: function (ex) {
                alert('error. ' + ex.status);
            }

        });
        return false;

    }


    // Inicio Subir Documento
    // Inicio Validar Tipo de Documento
    function ValidateExtension() {
        var allowedFiles = [".doc", ".docx", ".pdf", ".jpg", ".png", ".bmp", ".gif", ".xlsx",".xls"];
        var fileUpload = document.getElementById("fileUpload");


        var lblError = document.getElementById("lblError");
        var regex = new RegExp("([a-zA-Z0-9\s_\\.\-:])+(" + allowedFiles.join('|') + ")$");
        if (!regex.test(fileUpload.value.toLowerCase())) {
            $('#DivDoctosSubidos').load('/UploadFiles/Index')
            lblError.innerHTML = "Por favor, el archivo debe se seleccionado y no debe contener caracteres como '(', '-' o caracteres especiales. Recuerde, únicamente puede subir archivos con extensión: <b>" + allowedFiles.join(', ') + "</b> .";
            return false;
        }

        lblError.innerHTML = "";

        return true;
    }


    $(function () {
        $("#fileUpload").change(function () {
            var file = document.getElementById('fileUpload').files[0];
            alert(" El archivo seleccionador fué  👉 : "+ file.name);

        });

    });

    function SubirDocumento(DocumentoASubir) {
        loaderPantalla(true);
        setTimeout(function () {

            var file = document.getElementById('fileUpload').files[0];
            var e = DocumentoASubir;


            var componente = "Hand_" + e;

            var x = document.getElementById(componente);
            console.log("File:",e.value)

            x.src = "/Content/icons/ImagenVacia.png";


            if (e.value == 0) {
                loaderPantalla(false);
                alert("Debe indicar el tipo de documento a agregar.");
            }
            else {
                    if (ValidateExtension()) {

                                var formData = new FormData();


                                formData.append("archivo_a_grabar", file);
                                formData.append("Tipo_De_Archivo", e);
                                formData.append("Nombre_Archivo", file.name);

                                formData.append("solicitud_id", @ViewBag.solicitud_id);
                                formData.append("firma", '@ViewBag.firma');

                                $.ajax({
                                    type: "POST",
                                    url: "@(Url.Action("UploadFile", "UploadFiles"))",
                                    data: formData,
                                    processData: false,
                                    contentType: false,
                                    success: function (response) {
                                        loaderPantalla(false);
                                        refreshImagenes(DocumentoASubir);
                                        lblError.innerHTML = "";
                                    },
                                    error: function (response) {
                                        loaderPantalla(false);
                                        alert("Error: No se pudo subir el archivo subido de forma exitosa.");
                                    }

                                });
                    }
                }

        }, 2000);
    }
</script>

