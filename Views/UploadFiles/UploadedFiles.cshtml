    function DescargarPlantacionVoluntariaJuridico(varSolicitud_id, varPersonaJuridica) {
        loaderPantalla(true);
        setTimeout(function () {
            var data = {
                Solicitud_id: varSolicitud_id,
                firma: '@ViewBag.firma'
            };
            var url = "@Url.Action("GenerarFormularioDeSolicitud", "ReportePV")";

            $.post(url, data).done(function (jsonrespuesta) {
                loaderPantalla(false);
                var oJSON = JSON.parse(jsonrespuesta);
                var NombreDocumento = oJSON.Ubicacion;
                var Result = oJSON.Result;
                var Mensaje = oJSON.Mensaje;

                if (Result == 1) {
                    window.open('/Documentos/' + NombreDocumento, '_blank');
                } else {
                    alert(Mensaje);
                }

            }).fail(function (jsonRespuesta) {
                loaderPantalla(false);
            });
        }, 2000);

    }

