@{
    EdicionSolicitudGrants objGrant = (EdicionSolicitudGrants)Session[Constants.session_EdicionSolicitudGrants];
    ViewBag.Edicion = objGrant.boolSubirDocumentos;

    db_RNFEntities db = new db_RNFEntities();
    Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(ViewBag.solicitud_id);
    ViewBag.Solicitud_id = tbl_sol_solicitud.Solicitud_id;

    ViewBag.Estado = tbl_sol_solicitud.Estado_id;

    string sqlQuery;

    sqlQuery = " Select * \n";
    sqlQuery += " From Tbl_Gest_EtapaSolicitud \n";
    sqlQuery += " Where Solicitud_id = " + tbl_sol_solicitud.Solicitud_id.ToString() + "  \n";
    sqlQuery += " and EtapaSolicitudEstado_id = 1  \n";
    sqlQuery += " and exists  \n";
    sqlQuery += " ( \n";
    sqlQuery += " Select * \n";
    sqlQuery += " From Tbl_Gest_Etapa \n";
    sqlQuery += " Where EtapaRuta_id = Tbl_Gest_EtapaSolicitud.EtapaRuta_id \n";
    sqlQuery += "  and Etapa_id   = Tbl_Gest_EtapaSolicitud.Etapa_id \n";
    sqlQuery += "     and Rol_id in \n";
    sqlQuery += "         ( \n";
    sqlQuery += "     Select UsuarioExterno \n";
    sqlQuery += "     From Tbl_Gral_PerfilesRol \n";
    sqlQuery += "     ) \n";
    sqlQuery += "     	  ) \n";

    ViewBag.etapaSolicitudcantidad = db.Database.SqlQuery<Tbl_Gest_EtapaSolicitud>(sqlQuery).ToList().Count();

    ViewBag.etapaSolicitud = db.Database.SqlQuery<Tbl_Gest_EtapaSolicitud>(sqlQuery).ToList();


    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    string Nombre_Div = "div_Sol_Permisos_UploadedFiles";
    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;

    if (objUs.EsInterno == 1)
    {
        // boolEsInterno me permite habilitar la opciones para subir documentos
        boolEsInterno = true;
    }

    decimal truncsolicitudtipoid = Math.Truncate(tbl_sol_solicitud.SolicitudTipo_id);
    decimal solicitudtipoid = tbl_sol_solicitud.SolicitudTipo_id - truncsolicitudtipoid;

}

