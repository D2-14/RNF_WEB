
@model IEnumerable<RNF_Web.Models.Tbl_RNF_Empresa_Entidad_Materia_Prima>
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@{
    Layout = null;
    ViewBag.Title = "Materia Prima";
    ViewBag.SubTitle = "Listado de Materia Prima";
    db_RNFEntities db = new db_RNFEntities();

    string No_Registro = ViewBag.No_Registro;

    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }

    EdicionRNFGrants objRNFGrants = (EdicionRNFGrants)Session[Constants.session_EdicionRNFGrants];

}

<br />
<br />

<table class="table">
    <tr>
        <th>
            Nombre
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Tbl_Gral_Materia_Prima.Nombre_Tecnico)
            </td>
            <td>
                @if (objRNFGrants.Borrar)
                {
                    <img src="~/Content/icons/trash_green.png" onclick="Borrar_MateriaPrima('@item.No_Registro', @item.Materia_Prima_id)" width="25" height="25" />
                }
            </td>
        </tr>
    }

</table>


<script>

    $(document).ready(function () {

    });

</script>
