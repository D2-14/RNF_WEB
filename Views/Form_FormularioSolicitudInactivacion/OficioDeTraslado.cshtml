    function reiniciarParrafos() {

        var Solicitud_id = '@Model.Solicitud_id';
        var Doc_TecPro_Tipo_id = '@Model.Doc_TecPro_Tipo_id';
        var GuidEtapa_id = '@GuidEtapa_id';
        var Guid_id = '@Guid_id';
        var etapa_id = '@etapa_id';
        var etaparuta_id = '@etaparuta_id';
        var correlativoetapa_id = '@correlativoetapa_id';

        var data = {
            Solicitud_id: Solicitud_id,
            Solicitud_Guid_id: Guid_id,
            GuidEtapa_id: GuidEtapa_id,
            Doc_TecPro_Tipo_id: Doc_TecPro_Tipo_id,
            Etapa_id: etapa_id,
            EtapaRuta_id: etaparuta_id,
            CorrelativoEtapa_id: correlativoetapa_id
        }
        var url = "@Url.Action("ReiniciarParrafos", "Form_FormularioSolicitudInactivacion")";

        $.post(url, data).done(function (jsonRespuesta) {
            var objJSON = jsonRespuesta;

            var parrafo1 = objJSON.Parrafo_1;
            var parrafo2 = objJSON.Parrafo_2;
            var parrafo3 = objJSON.Parrafo_3;
            var parrafo4 = objJSON.Parrafo_4;
            var parrafo5 = objJSON.Parrafo_5;
            var parrafo6 = objJSON.Parrafo_6;
            var parrafo7 = objJSON.Parrafo_7;
            var parrafo8 = objJSON.Parrafo_8;
            var parrafo9 = objJSON.Parrafo_9;
            var parrafo10 = objJSON.Parrafo_10;

            document.getElementById("ta_Parrafo1").value = parrafo1;
            document.getElementById("ta_Parrafo2").value = parrafo2;
            document.getElementById("ta_Parrafo3").value = parrafo3;
            document.getElementById("ta_Parrafo4").value = parrafo4;
            document.getElementById("ta_Parrafo5").value = parrafo5;
            document.getElementById("ta_Parrafo6").value = parrafo6;
            document.getElementById("ta_Parrafo7").value = parrafo7;
            document.getElementById("ta_Parrafo8").value = parrafo8;
            document.getElementById("ta_Parrafo9").value = parrafo9;
            document.getElementById("ta_Parrafo10").value = parrafo10;

            grabarParrafos();

        }).fail(function (jsonRespuesta) {
            alert("Ocurrió un error");
        });

    }

