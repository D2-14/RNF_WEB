@model RNF_Web.Models.Tbl_RNF_Finca
@using RNF_Web.Models;
@using System.Data.SqlClient;

@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}


@{
    string No_Registro = ViewBag.No_Registro;
    db_RNFEntities db = new db_RNFEntities();

    Tbl_RNF_Registro tbl_RNF_Registro = db.Tbl_RNF_Registro.Where(Obj => Obj.No_Registro == No_Registro).FirstOrDefault();

    //Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(Session[Constants.session_Solicitud]);


    int intCategoria = db.Tbl_Sol_Solicitud_Categoria.Where(Obj => Obj.Categoria_id == tbl_RNF_Registro.Categoria_id && (Obj.Descripcion.Contains("Sistemas agroforestales") || Obj.Descripcion.Contains("Plantaciones forestales"))).Count();

    long MinFinca;

    try
    {
        MinFinca = db.Tbl_RNF_Finca.Where(Obj => Obj.No_Registro == tbl_RNF_Registro.No_Registro).OrderBy(P => P.Finca_Id).First().Finca_Id;
        MinFinca++;

    }
    catch
    {
        MinFinca = 0;
    }

    ViewBag.MinFinca = MinFinca;




    if ((intCategoria > 0))
    {
        ViewBag.intCategoria = 1;
    }
    else
    {
        ViewBag.intCategoria = 0;
    }

    Layout = "~/Views/Shared/_LayoutSimple.cshtml";

    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }
    fc_Gral_RNF_Configuracion_Result permisos = db.fc_Gral_RNF_Configuracion(tbl_RNF_Registro.No_Registro, objUs.intUsuario_id, boolEsInterno).FirstOrDefault();
    EdicionRNFGrants objRNFGrants = (EdicionRNFGrants)Session[Constants.session_EdicionRNFGrants];
}


