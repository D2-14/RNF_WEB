<script>
    $(document).ready(function () {

        const tmArea_SIGAP = document.querySelector('#Area_SIGAP');
        const tmNo_Sigap = document.querySelector('#No_Sigap');

        if (tmArea_SIGAP.checked) {
            var TdHiddeA = document.getElementById("No_Sigap");
