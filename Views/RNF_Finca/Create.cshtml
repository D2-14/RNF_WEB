                    @Html.ValidationMessageFor(model => model.Ubicacion, "", new { @class = "text-danger" })
                </div>

            </td>
        </tr>
        <tr>
            <td>
                @Html.LabelFor(model => model.AreaTotal, htmlAttributes: new { @class = "control-label col-md-12" })

            </td>
            <td>
                @Html.LabelFor(model => model.AreaARegistrar, htmlAttributes: new { @class = "control-label col-md-12" })

            </td>
        </tr>
        <tr>

            <td>
                <div class="form-group">

                    <div class="col-md-10">
                        @Html.EditorFor(model => model.AreaTotal, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AreaTotal, "", new { @class = "text-danger" })
                    </div>
                </div>
            </td>
            <td>
                <div class="form-group">
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.AreaARegistrar, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AreaARegistrar, "", new { @class = "text-danger" })
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td>
            </td>
            <td>
                @if (ViewBag.intCategoria > 0)
                {
                    @Html.LabelFor(model => model.ObjetivoDeLaPlantacion, "Objetivo de la plantación", htmlAttributes: new { @class = "control-label col-md-4" })
                }
            </td>
        </tr>
        <tr>
            <td>
            </td>
            <td>
                @if (ViewBag.intCategoria > 0)
                {
                    <div class="col-md-10">
                        @Html.DropDownList("ObjetivoDeLaPlantacion", null, htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.ObjetivoDeLaPlantacion, "", new { @class = "text-danger" })
                    </div>


                }
                else
                {
                    @Html.HiddenFor(model => model.ObjetivoDeLaPlantacion)

                }

            </td>
        </tr>
        <tr>
            <td>
                <table>
                    <tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
                    <tr><td></td><td colspan="5">@Html.LabelFor(model => model.OtrosRegistrosRNF, "¿Existe otro registro (RNF) en la misma finca?", htmlAttributes: new { @class = "control-label col-md-12" })</td></tr>

                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td>
                            <div class="checkbox">
                                @Html.EditorFor(model => model.OtrosRegistrosRNF)
                                @Html.ValidationMessageFor(model => model.OtrosRegistrosRNF, "", new { @class = "text-danger" })
                            </div>
                        </td>
                        <td>Si</td>
                        <td>
                            <div class="checkbox">
                                @Html.EditorFor(model => model.NoOtrosRegistrosRNF)
                                @Html.ValidationMessageFor(model => model.NoOtrosRegistrosRNF, "", new { @class = "text-danger" })
                            </div>
                        </td>
                        <td>No</td>
                    </tr>
                </table>
            </td>
            <td colspan="2" id="tdOtroRegistroRNF" style="display:none;">
                @Html.LabelFor(model => model.Registros, "Registro(s): ", htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Registros, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Registros, "", new { @class = "text-danger" })
                </div>

            </td>
        </tr>
    </table>

    <div class="col-sm-12 col-md-12" align="right">
        <span class="label warning">@ViewBag.Mensaje</span>
        @if (objRNFGrants.Agregar)
        {
            <input type="submit" value="Grabar e ingresar datos de la siguiente finca" class="btn btn-default" />
        }
    </div>
</div>
}

