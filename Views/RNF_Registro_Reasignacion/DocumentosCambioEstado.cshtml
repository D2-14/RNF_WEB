@using RNF_Web.Models;
@model IEnumerable<RNF_Web.Models.Tbl_RNF_Registro_BitacoraDocumento>
@{
    db_RNFEntities db = new db_RNFEntities();
    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    string actionName = HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString();
    Layout = null;
    Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
    long usuarioid = 0;
    string nombreusuario = "";
    EdicionRNFGrants objRNFGrants = (EdicionRNFGrants)Session[Constants.session_EdicionRNFGrants];
}
@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}

<script>

    function hide_myModal() {
        $("#imgModal").modal('hide');
    }

    function Mostrar(No_Registro, Bitacora_id, Documento_id, filename) {
        $.ajax({
            type: 'POST',
            url: "@(Url.Action("Obtenerhref", "RNF_Registro_Reasignacion"))",
            dataType: 'json',
            data: { No_Registro: No_Registro, Bitacora_id: Bitacora_id, Documento_id: Documento_id },
            success: function (doc) {


                var imgDoc = document.getElementById("imDoc");
                var ifDoc = document.getElementById("ifDoc");
                var miHref = document.getElementById("miHref");

                if (filename.split(".")[1] == "pdf" || filename.split(".")[1] == "PDF" ||
                    filename.split(".")[1] == "jpg" || filename.split(".")[1] == "JPG" ||
                    filename.split(".")[1] == "bmp" || filename.split(".")[1] == "BMP" ||
                    filename.split(".")[1] == "png" || filename.split(".")[1] == "PNG" ||
                    filename.split(".")[1] == "gif" || filename.split(".")[1] == "GIF") {

                    if (filename.split(".")[1] == "pdf" || filename.split(".")[1] == "PDF") {
                        imgDoc.src = "";
                        ifDoc.src = doc;
                        ifDoc.style.visibility = "visible";
                        miHref.href = doc;
                        $("#imgModal").modal('show');
                    }
                    else {

                        ifDoc.src = "";
                        imgDoc.src = doc;
                        miHref.href = doc;
                        $("#imgModal").modal('show');
                        ifDoc.style.visibility = "hidden";
                    }
                }
                else {
                    window.location.href = doc;
                }

            },
            error: function (ex) {
                alert('error. ' + ex.status);
            }

        });
        return false;

    }

</script>


@Html.Raw(ViewBag.MensajeDocumento)

<table width="100%">
    <tr>
        <td width="50%"></td>
        <td width="30%">
        </td>
        <td width="10%">
            <button rel="tooltip" title="Regresar" onclick="location.href='@Url.Action("", "RNF_Gestor", new { No_Registro = ViewBag.No_Registro })'">
                <i><img src="~/Content/icons/regresar.png" style="border-radius: 30%; width: 40px; height: auto" /></i>
                <div class="ripple-container"></div>
                Regresar
            </button>
        </td>
        <td width="10%"></td>
    </tr>
</table>

@if (objRNFGrants.Agregar) {
    using (Html.BeginForm(actionName, controllerName, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <input type="hidden" id="No_Registro" name="No_Registro" value="@ViewBag.No_Registro" />
        <input type="hidden" id="Bitacora_id" name="Bitacora_id" value="@ViewBag.Bitacora_id" />
        <table width="100%">
            <tr>
                <td>
                    <label>
                        <img src="~/Content/icons/btnSubirArchivo.png" width="180" height="auto" id="upfile1" style="cursor:pointer" />
                        <input type="file" id="upload" name="upload" style="display:none">
                    </label>
                </td>
                <td>
                    <input type="submit" id="btsubir" class="btn btn-primary btn-outlined" width="100%" value="Subir archivo" />
                </td>
            </tr>
        </table>
    }
}

@if(Model.Count() > 0)
{
    <table class="table">
        <tr>
            <th>
                Nombre de Archivo
            </th>
            <th>
                Fecha de Creación
            </th>
            <th>
                Registrado por
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.NombreArchivo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.swdatecreated)
        </td>
        <td>
            @if ((bool)item.swcreatedbyinterno)
            {
                usuarioid = (long)item.swcreatedby;
                Tbl_Seg_Usuario tbl_Seg_Usuario = (from d in db.Tbl_Seg_Usuario
                                                   where d.Usuario_id == usuarioid
                                                   select d).FirstOrDefault();
                if (tbl_Seg_Usuario != null)
                {
                    nombreusuario = (tbl_Seg_Usuario.Nombre ?? "") + " " + (tbl_Seg_Usuario.Apellidos ?? "");
                    @Html.Raw("Personal Interno: " + nombreusuario)
                }
            }
            else
            {
                usuarioid = (long)item.swcreatedby;
                Tbl_Seg_UsuarioExterno tbl_Seg_Usuario = (from d in db.Tbl_Seg_UsuarioExterno
                                                          where d.Usuario_id == usuarioid
                                                          select d).FirstOrDefault();
                if (tbl_Seg_Usuario != null)
                {
                    nombreusuario = (tbl_Seg_Usuario.Nombres ?? "") + " " + (tbl_Seg_Usuario.Apellidos ?? "");
                    @Html.Raw("Usuario: " + nombreusuario)
                }
            }
        </td>
        <td>
            <img src="~/Content/icons/ver.png" onclick="Mostrar('@item.No_Registro', '@item.Bitacora_id', '@item.Documento_id', '@item.NombreArchivo')" width="50" />
        </td>
    </tr>
        }

    </table>
}



<div class="modal fade bd-example-modal-lg" tabindex="-1" id="imgModal" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true" width: 700px;>
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" onclick="hide_myModal()">
                    X
                </button>
                <h4 class="modal-title">Vista preliminar del documento cargado</h4>
            </div>
            <div class="modal-body">
                @*<a ID="miHref" name="miHref" href="" target="_blank">Ver en pagina Completa</a>*@

                <a ID="miHref" name="miHref" href="" target="_blank" style="display:none">Ver en pagina Completa</a>
                <button class="btn-next" onclick="MostrarCompleta()">Mostrar en página completa</button>


                <img src="~/Content/icons/click_hand.gif" width="80" />
                <img style="max-height:1000px;max-width:800px;height:auto;width:auto;" id="imDoc" Visible="false" />
                <iframe ID="ifDoc" style="height:600px;width:800px;" visible="false"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-info" onclick="hide_myModal()">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>