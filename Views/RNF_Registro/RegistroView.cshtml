    function procesoInactivacion() {
        loaderPantalla(true);
        var var_motivoInactivacion = document.getElementById("motivoInactivacion");
        var motivoInactivacion = var_motivoInactivacion.value;
        var Solicitud_id = '@soltry';
        var No_Registro = '@registrotry';
        var var_TipoInactivacion_id = document.getElementById("TipoInactivacion_id");
        var TipoInactivacion_id = var_TipoInactivacion_id.value;
        var url = "@Url.Action("GrabarMotivoInactivacion", "Sol_Solicitud_Inactivacion")";

        setTimeout(function () {

            motivoInactivacion = motivoInactivacion.trim();

            if (TipoInactivacion_id == 0) {
                alert("Debe seleccionar el tipo de inactivación");
                return;
            }

            if ((motivoInactivacion == null) || (motivoInactivacion == "")) {
                alert("El motivo de Inactivación no puede quedarse en blanco");
                document.getElementById("motivoInactivacion").value = "";
                loaderPantalla(false);
            } else {
                var confirmarInactivacion = confirm("¿Está seguro de que desea realizar la inactivación del registro " + No_Registro + " ?");
                if (confirmarInactivacion) {

                    var data = {
                        Descripcion_Inactivacion: motivoInactivacion,
                        Solicitud_id: Solicitud_id,
                        TipoInactivacion_id: TipoInactivacion_id
                    };

                    $.post(url, data).done(function (jsonRespuesta) {
                        var oJSON = JSON.parse(jsonRespuesta);
                        var ubicacion = oJSON.ubicacion;
                        // window.open(ubicacion, '_blank');
                        download(ubicacion, "FormularioInactivacion.pdf")

                        loaderPantalla(false);
                    }).fail(function (jsonRespuesta) {
                        var oJSON = JSON.parse(jsonRespuesta);
                        loaderPantalla(false);
                        alert("Algo salió mal");
                    });

                } else {
                    loaderPantalla(false);
                    alert("Se ha cancelado el proceso de inactivación para el registro " + No_Registro);
                    document.getElementById("motivoInactivacion").value = "";
                }
            }


        }, 2000);

    }

    function eliminarMotosierraMarcaModelo(Solicitud_id, Motosierra_id) {

        loaderPantalla(true);
        var url = "@Url.Action("EliminarMotosierraMarcaModelo", "Sol_Motosierra_MarcaModelo")";

        var data = {
            Solicitud_id: Solicitud_id,
            Motosierra_id: Motosierra_id
        };

        $.post(url, data).done(function (jsonRespuesta) {
            var oJSON = JSON.parse(jsonRespuesta);
            var CodRespuesta = oJSON.CodRespuesta;
            var strRespuesta = oJSON.strRespuesta;
            loaderPantalla(false);
            if (CodRespuesta != 1) {
                alert(strRespuesta);
            } else {
                refreshViewMotosierraMarcaModelo();
            }

        }).fail(function (jsonRespuesta) {
            var oJSON = JSON.parse(jsonRespuesta);
            loaderPantalla(false);
            alert("Algo salió mal");
        });

    }

</script>


