    function Agregarme_Como_Arrendatario(varSolicitudId, varTipo) {
        if (document.getElementById('PersoneriaArrendatario')) {
            var e = document.getElementById("PersoneriaArrendatario");

            if (e.value == 1) {

                $.ajax({
                    type: 'POST',
                    url: "@(Url.Action("AgregarmeComoArrendatarioRepresentante", "Home"))",
                    dataType: 'json',
                    data: { tipo: varTipo},
                    success: function (doc) {

                        $('#section_Link_II').load('@ViewBag.section_Link_II')
                        $('#section_Link_III').load('@ViewBag.section_Link_III')
                        $('#section_Link_IV').load('@ViewBag.section_Link_IV')
                        $('#section_Link_V').load('@ViewBag.section_Link_V')
                    },
                    error: function (ex) {
                        alert('Ocurrio un error aqui. ' + ex.status);
                    }

                });
            }
            else {
                Agregar_Arrendatario()
            }
        }
        else
        {
                $.ajax({
                    type: 'POST',
                    url: "@(Url.Action("AgregarmeComoArrendatarioRepresentante", "Home"))",
                    dataType: 'json',
                    data: { tipo: varTipo },
                    success: function (doc) {

                        $('#section_Link_II').load('@ViewBag.section_Link_II')
                        $('#section_Link_III').load('@ViewBag.section_Link_III')
                        $('#section_Link_IV').load('@ViewBag.section_Link_IV')
                        $('#section_Link_V').load('@ViewBag.section_Link_V')
                    },
                    error: function (ex) {
                        alert('Ocurrio un error aqui. ' + ex.status);
                    }

                });
        }

        return false;
    }

