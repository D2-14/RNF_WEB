    function listarDocumentosRequeridos() {
        var No_Registro = '@Guid_id';

        var data = {
            No_Registro: No_Registro
        };


        var url = '@Url.Action("ConsultarDocumentosRequeridos", "RNF_UploadFiles")';

        $.post(url, data).done(function (RespuestaJSON) {

            var oJSON = RespuestaJSON;
            console.log(oJSON);



            for (let i = 0; i < oJSON.length; i++) {

                var ElementoActual = oJSON[i];
                var Tipo_Documento_id = ElementoActual.Tipo_Documento_id;

                var myEle = document.getElementById('DivDoctosSubidosEspecificos_' + Tipo_Documento_id);
                if (myEle) {
                    refreshImagenes(Tipo_Documento_id);
                }
            }




        }).fail(function (RespuestaJSON) {

            console.log(RespuestaJSON);

            alert('Ocurrió un error: ' + RespuestaJSON);

        });


    }

