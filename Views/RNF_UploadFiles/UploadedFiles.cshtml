<table class="table" id="docSubidosConAnterioridad">
    <tbody>
        @foreach (var itemDocumentos in ViewBag.DocumentosPendientes)
        {
            <tr>
                <td>@itemDocumentos.Tipo_Documento_id</td>
                <td>@itemDocumentos.Nombre</td>
                <td>
                    @if ((itemDocumentos.EjemploHref ?? "") != "")
                    {
                        <a href="@itemDocumentos.EjemploHref">Ejemplo de archivo</a>
                    }
                </td>
                <td>
                    @if (objRNFGrants.Agregar)
                    {
                        <label for="fileUpload" id="fileUpload_@itemDocumentos.Tipo_Documento_id" class="btn btn-primary btn-outlined" onclick="SeleccionarArchivo(@itemDocumentos.Tipo_Documento_id,this)">Seleccionar archivo</label>
                    }
                </td>
                <td>
                    <br />
                    @if (objRNFGrants.Agregar)
                    {
                        <input id="btnUploadDocumento" type="button" onclick="SubirDocumento(@itemDocumentos.Tipo_Documento_id)" value="Subir Documento" class="btn btn-success" />
                        <img src="~/Content/icons/ImagenVacia.png" id="Hand_@itemDocumentos.Tipo_Documento_id" name="Hand_@itemDocumentos.Tipo_Documento_id" width="60" />
                        <img src="~/Content/icons/refresh.png" type="button" onclick="refreshImagenes('@itemDocumentos.Tipo_Documento_id')" value="eliminar" width="30" />
                    }
                </td>
            </tr>
            <tr>
                <td></td>
                <td></td>
                <td colspan="2">
                    <div id='DivDoctosSubidosEspecificos_@itemDocumentos.Tipo_Documento_id'>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>


