@model IEnumerable<RNF_Web.Models.Tbl_RNF_DocumentoSubido>
@using RNF_Web.Models;
@using System.Data.SqlClient;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}


@{
    string Guid_id = ViewBag.Guid_id;
    db_RNFEntities db = new db_RNFEntities();
    Tbl_RNF_Registro tbl_rnf_registro = db.Tbl_RNF_Registro.Where(Obj => Obj.No_Registro == Guid_id).FirstOrDefault();

    EdicionRNFGrants objRNFGrants = (EdicionRNFGrants)Session[Constants.session_EdicionRNFGrants];
}




@if (Model.Count() > 0)
{
    @*<div style='height: 30px; width: 100%; background-color: #66bb6a; color: white; '>
            <h4> Documentos subidos actualmente </h4>
        </div>*@
    <table class="table">
        @foreach (var item in Model)
        {
            <tr>
                <td width="10"></td>
                <td width="60"></td>
                <td width="15"></td>
                <td width="15"></td>

            </tr>
            <tr>
                <td></td>
                <td>
                    @Html.DisplayFor(modelItem => item.FileName)
                </td>
                <td>
                    <img src="~/Content/icons/ver.png" onclick="Mostrar('@item.Tipo_Documento_id', '@item.FileName')" width="50" />
                </td>
                <td>
                    @if (objRNFGrants.Borrar)
                    {
                        <img src="~/Content/icons/trash_green.png" type="button" onclick="Borrar('@item.Tipo_Documento_id', '@item.FileName')" value="eliminar" width="30" />
                    }
                </td>

            </tr>
        }

    </table>
}

