@using RNF_Web.Models;
@using System.Data.SqlClient;


@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}


<div id="section_Rodal">
    @model IEnumerable<RNF_Web.Models.Tbl_Sol_Rodal_Descuento>

    @{
        db_RNFEntities db = new db_RNFEntities();
        Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(Session[Constants.session_Solicitud]);

        ViewBag.Estado = tbl_sol_solicitud.Estado_id;


        ViewBag.AreaTotal = db.Tbl_Sol_Rodal_Descuento.Where(Obj => Obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id).Sum(Obj => Obj.AreaTotal);
        ViewBag.AreaTotalCalculadaSistema = db.Tbl_Sol_Rodal_Descuento.Where(Obj => Obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id).Sum(Obj => Obj.AreaTotalCalculadaSistema);


        ViewBag.AreaTotal = ViewBag.AreaTotal ?? 0;
        ViewBag.AreaTotalCalculadaSistema = ViewBag.AreaTotalCalculadaSistema ?? 0;


        ViewBag.CantidadFincas = db.Tbl_Sol_Finca.Where(Obj => Obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id).Count();

        if (ViewBag.CantidadFincas > 0)
        {

            ViewBag.MaxFincaId = db.Tbl_Sol_Finca.Where(Finca => Finca.Solicitud_id == tbl_sol_solicitud.Solicitud_id).Max(u => u.Finca_Id);

        }
        else
        {
            ViewBag.MaxFincaId = 0;
        }

        string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
        string Nombre_Div = "div_Sol_Permisos_Sol_Rodal";
        Usuario objUs = (Usuario)Session["User"];
        bool boolEsInterno = false;
        if (objUs.EsInterno == 1)
        {
            boolEsInterno = true;
        }
        fc_Gral_Sol_Configuracion_Result permisos = db.fc_Gral_Sol_Configuracion(tbl_sol_solicitud.Solicitud_id, controllerName, boolEsInterno).FirstOrDefault();

    }
    @if (Constants.VisualizarInformacionDesarrollo == 1)
    {
        <div id="@Nombre_Div"></div>
    }


    <script type="text/javascript">
        function visualizarPermisos(solicitudid, controllername, esinterno, nombrediv) {
            var solicitudId = solicitudid;
            var controllerName = controllername;
            var esInterno = esinterno;

            var mySolPermisos = document.getElementById(nombrediv);
            if (mySolPermisos) {
                $("#" + nombrediv).load("/Gral_SolicitudConfiguracion/PermisosRecibidos?Solicitud_id=" + solicitudId + "&controllerName=" + controllerName + "&EsInterno=" + esInterno);
            }

        }

        function popUp(URL) {
            //    window.open(URL, 'Nombre de la ventana', 'toolbar=0,scrollbars=0,location=0,statusbar=0,menubar=0,resizable=1,width=1000,height=500,left = 300,top = 50');

            Editar_Rodal(URL);

        }

        function PlanoXFinca()
        {
            var MaxFincaId = @ViewBag.MaxFincaId;
            var NoFinca = $('#No_Finca').val();

            if (NoFinca == 0)
            {
                alert('El número de finca no debe ser cero, debe ser valido, entre 1 y ' + MaxFincaId + ',  acorde al ID de la finca para la que desea el plano')
            }
            else
            if (NoFinca > MaxFincaId)
            {
                alert('El número de finca debe ser valido, entre 1 y ' + MaxFincaId + ',  acorde al ID de la finca para la que desea el plano')
            }
            else
            {
                window.open('/Locacion/IndexFincaPlano?Guidid=@ViewBag.guidid&Finca_id=' + NoFinca, '_blank');
            }

        }

    </script>

    <div class="container-fluid">
        <div class="titulo-dos">
            <h4>Áreas de descuento</h4>
        </div>

        <br />

        <div class="col-sm-6 col-md-12">

            <table class="table">
                <tr>
                    <th>
                        Finca Id
                    </th>
                    <th>
                        Rodal Id
                    </th>
                    <th>
                        Id Descuento
                    </th>
                    <th>
                        Area total(ha)
                    </th>
                    <th>
                        Area calculada(ha)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.GTMX)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.GTMY)
                    </th>
                    <th></th>
                </tr>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Finca_id)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Rodal_Id)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Rodal_Descuento_Id)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.AreaTotal)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AreaTotalCalculadaSistema)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.GTMX)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.GTMY)
                        </td>
                        <td>
                            @if ((bool)permisos.Borrar)
                            {
                                <div class="div-icons-table" onclick="Borrar_RodalDescuento(@item.Finca_id, @item.Rodal_Id ,@item.Rodal_Descuento_Id)">
                                    <i class="fa in fa-trash-o" aria-hidden="true"></i>
                                </div>

                            }
                        </td>
                    </tr>
                }

                <hr />
                <hr />
                <tr>
                    <td></td>
                    <th>Área total</th>
                    <td></td>
                    <th>@ViewBag.AreaTotal</th>
                    <th>@ViewBag.AreaTotalCalculadaSistema</th>

                    <td>
                    </td>
                </tr>
            </table>
        </div>
    </div>

</div>


