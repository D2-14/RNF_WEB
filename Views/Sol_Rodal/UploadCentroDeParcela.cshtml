<div id="section_ExcelRodal">
    @model System.Data.DataTable
    @using System.Data;
    @using RNF_Web.Models;
    @using System.Data.SqlClient;

    @if (Constants.VisualizarInformacionDesarrollo == 1)
    {
        <h3>@this.Url.Action()</h3>
    }

    @{

        string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();

        db_RNFEntities db = new db_RNFEntities();
        Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(Session[Constants.session_Solicitud]);

        ViewBag.Estado = tbl_sol_solicitud.Estado_id;

        ViewBag.Title = "   Carga archivo de centro de parcelas";
        Usuario objUs = (Usuario)Session["User"];
        bool boolEsInterno = false;
        if (objUs.EsInterno == 1)
        {
            boolEsInterno = true;
        }

        fc_Gral_Sol_Configuracion_Result permisos = db.fc_Gral_Sol_Configuracion(tbl_sol_solicitud.Solicitud_id, "Sol_Rodal_Poligono", boolEsInterno).FirstOrDefault();
        Layout = null;

    }

    @if (Constants.VisualizarInformacionDesarrollo == 1)
    {
        <div style="visibility:visible">
            <table border="1">
                <tr>
                    <th>
                        Agregar
                    </th>
                    <th>
                        Editar
                    </th>
                    <th>
                        Borrar
                    </th>
                    <th>
                        Estado
                    </th>
                    <th>
                        Tipo
                    </th>
                    <th>
                        Controller Enviado
                    </th>
                    <th>
                        Controller Recibido
                    </th>
                </tr>
                <tr>
                    <td>
                        @permisos.Agregar
                    </td>
                    <td>
                        @permisos.Editar
                    </td>
                    <td>
                        @permisos.Borrar
                    </td>
                    <td>
                        @permisos.Estado_id
                    </td>
                    <td>
                        @permisos.SolicitudTipo_id
                    </td>
                    <td>
                        @permisos.Controlador_Recibido
                    </td>
                    <td>
                        @permisos.Controlador_Devuelto
                    </td>
                </tr>
            </table>
        </div>
    }

    <script src="~/Scripts/jquery-3.6.0.js"></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.12.1.js"></script>

    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <div style='height: 30px; width: 100%; background-color: green; color: white; '>
        <h4 class="title">&nbsp;&nbsp;&nbsp;@ViewBag.Title</h4>
    </div>

    @using (Html.BeginForm("UploadExcelCentroParcelas", "Sol_Rodal", null, FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary()

        <div class="form-group">
            <div class="col-sm-12">
                <form id="uploader">
                    <h1>@TempData["MensajeFileCentroParcela"]</h1>

                    @if ((bool)permisos.Editar)
                    {
                        <table>
                            <tr>
                                <td>
                                    <label>
                                        <label for="uploadCentroDeParcela" id="upfileuploadCentroDeParcela" class="btn-next-ic">&nbsp;&nbsp;&nbsp;&nbsp;Seleccionar archivo&nbsp;&nbsp;&nbsp;&nbsp;</label>
                                        <input type="file" id="uploadCentroDeParcela" name="uploadCentroDeParcela" style="display:none" />
                                    </label>
                                </td>
                                <td>
                                    <span id="nombre_CentroDeParcela"></span>
                                    <br />
                                    <input type="button" id="btsubirCentroDeParcela" class="btn btn-primary btn-outlined" width="100%"
                                           value="Subir archivo" style="display:none" />
                                </td>
                                <td>
                                    &nbsp;&nbsp;&nbsp;&nbsp;
                                </td>
                                <td>
                                    <a href="~/Content/Machotes/DatosCentroParcela_Vacio.xlsx">Archivo para carga de coordenadas de centro de parcela</a>
                                </td>
                                <td>
                                    &nbsp;&nbsp;&nbsp;&nbsp;
                                </td>
                                <td>
                                    <a href="~/Content/Machotes/DatosCentroParcela_Ejemplo.xlsx">Archivo ejemplo</a>
                                </td>
                            </tr>
                            <tr>
                            </tr>
                        </table>
                    }
                    <br /><br />

                </form>
            </div>
            <div class="col-sm-3"></div>
        </div>

    }


    <div style='height: 30px; width: 100%; background-color: green; color: white; '>
        <h4 class="text-bg-info">** Recuerde cargar los datos dasométricos previo cargar centros de parcela.</h4>
    </div>

    <div id="divDetalleParcelas"></div>

</div>

<script>


    $(document).ready(function () {
        var divDetalleParcelas = document.getElementById("divDetalleParcelas");
        if (divDetalleParcelas) {
            $("#divDetalleParcelas").load("/Sol_Rodal/CentroParcela?Solicitud_id=@ViewBag.Solicitud_id&firma=@ViewBag.firma")
        }
    });

    var ArchivoCentroParcela = ($("#uploadCentroDeParcela"))[0].files[0];
    $(function () {
        $("#uploadCentroDeParcela").change(function () {
            ArchivoCentroParcela = ($("#uploadCentroDeParcela"))[0].files[0];
            console.log(ArchivoCentroParcela);
            document.getElementById("nombre_CentroDeParcela").innerHTML = ArchivoCentroParcela.name;
            var botonSubir = document.getElementById("btsubirCentroDeParcela");

            if ((ArchivoCentroParcela != "") && (ArchivoCentroParcela != null)) {
                botonSubir.classList.add("btn-primary");
                botonSubir.style.display = "block";
            } else {
                botonSubir.classList.remove("btn-primary");
                botonSubir.disabled = true;
            }
        })


        $("#btsubirCentroDeParcela").click(function () {
            loaderPantalla(true);

            setTimeout(function () {

                ArchivoCentroParcela = ($("#uploadCentroDeParcela"))[0].files[0];
                console.log(ArchivoCentroParcela);

                var formData = new FormData();


                function adjuntarImagenCentroParcela() {
                    formData.append("upload", ArchivoCentroParcela);
                    formData.append("Solicitud_id", '@ViewBag.Solicitud_id');
                    formData.append("firma", '@ViewBag.firma');
                    $.ajax({
                        url: "UploadExcelCentroParcelas",
                        type: "POST",
                        data: formData,
                        contentType: false,
                        processData: false,
                        async: false,
                        success: function (data) {
                            loaderPantalla(false);
                            location.reload();
                        },
                        error: function (data) {
                            loaderPantalla(false);
                            location.reload();
                        }
                    });

                }

                if (ArchivoCentroParcela != null) {
                    adjuntarImagenCentroParcela();
                } else {
                    alert("No se ha seleccionado ningún archivo");
                }


            }, 2000);



        })
    })

</script>
