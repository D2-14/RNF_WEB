@model IEnumerable<RNF_Web.Models.Tbl_Gest_EtapaSolicitud>

@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}


@{
    string Query;


    Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
    ViewBag.Title = "Bandeja de solicitudes";
    ViewBag.SubTitle = null;
    db_RNFEntities db = new db_RNFEntities();
    string colorestatus = "";
    DateTime swdatenow = DateTime.Now;
    DateTime swdateinicio = ViewBag.swdateinicio;
    DateTime swdatefinal = ViewBag.swdatefinal;

    ViewBag.fecha_inicio = String.Format("{0:yyyy-MM-dd}", swdateinicio);
    ViewBag.fecha_fin = String.Format("{0:yyyy-MM-dd}", swdatefinal);
    string check = "checked";
    int Pendientes = 0;
    int Finalizados = 0;
    if (ViewBag.Pendientes != null)
    {
        Pendientes = 1;
    }
    if (ViewBag.Finalizados != null)
    {
        Finalizados = 1;
    }
    string Nombre_Etapa = ViewBag.Nombre_Etapa;
    Console.WriteLine(ViewBag.Nombre_Etapa);
    Console.WriteLine(Nombre_Etapa);



}

<script>

    String.fromHtmlEntities = function (string) {
        return (string + "").replace(/&#\d+;/gm, function (s) {
            return String.fromCharCode(s.match(/\d+/gm)[0]);
        })
    };





    function returnEtapa(varSolicitud_id, VarCorrelativoId, SelectedName) {
        var select = document.getElementById(SelectedName)
        var Etapa_id = select.options[select.selectedIndex].value;

        var url = "@Url.Action("JsonReturnEtapa", "Gest_EtapaSolicitud")";

        var data = { varSolicitud_id: varSolicitud_id, VarCorrelativoId: VarCorrelativoId, SelectedEtapaId: Etapa_id };


        var confirmRatificacion = confirm('Si está seguro de regresar la etapa, presione "Aceptar"')
        if (confirmRatificacion) {     
                    $.post(url, data).done(function (Listdata) {
                        var objJSON = JSON.parse(Listdata);
                        var Cod_Respuesta = objJSON.CodRespuesta;
                        var Texto_Respuesta = objJSON.strRespuesta;

                        alert(Texto_Respuesta);
                        location.reload();
                    }).fail(function (RespuestaJSON) {
                        console.log(RespuestaJSON)
                        alert('Error no identificado.');

                    });
        }
    }

    function loaddivparamsbusqueda() {
        loaderPantalla(true);
        var paramsbusqueda = document.getElementById('paramsbusqueda');
        if (paramsbusqueda) {
            var url = '@Url.Action("IndexReturnParams", "Gest_EtapaSolicitud")';
            var Pendientes = @Pendientes;
            var Finalizados = @Finalizados;

            var fecha_inicio = '@ViewBag.fecha_inicio';
            var fecha_fin = '@ViewBag.fecha_fin';
            var Nombre_Etapa = String.fromHtmlEntities('@Nombre_Etapa');
            Nombre_Etapa = encodeURI(Nombre_Etapa);

            var params = '?fecha_inicio=' + fecha_inicio + '&fecha_fin=' + fecha_fin + '&Nombre_Etapa_Param=' + Nombre_Etapa;// + Nombre_Etapa;
            if (Pendientes != 0) {
                params += '&Pendientes=' + Pendientes;
            }
            if (Finalizados != 0) {
                params += '&Finalizados=' + Finalizados;
            }
            console.log(url + params);
            $('#paramsbusqueda').load(url + params);
        }
    }

    $(document).ready(function () {

        loaddivparamsbusqueda();

        $("#btnHideModal").click(function () {

                $('#section_Link_II').load('@ViewBag.section_Link_II')
                $('#section_Link_III').load('@ViewBag.section_Link_III')
                $('#section_Link_IV').load('@ViewBag.section_Link_IV')
                $('#section_Link_V').load('@ViewBag.section_Link_V')

                $("#myModal").modal('hide');
        });


        $("#btnHideModal_Close").click(function () {


                $('#section_Link_II').load('@ViewBag.section_Link_II')
                $('#section_Link_III').load('@ViewBag.section_Link_III')
                $('#section_Link_IV').load('@ViewBag.section_Link_IV')
                $('#section_Link_V').load('@ViewBag.section_Link_V')


                $("#myModal").modal('hide');
        });

    });


    $('#myModal').modal({
        backdrop: 'static',
        keyboard: false
    })

    $("#myModal").on('show.bs.modal', function () {
        var modal = $(this)
        modal.find('.modal-title').text(document.getElementById("Titulo").value);
        modal.find('.modal-body').html(document.getElementById("Pagina").value);
    });


    function VisualizarSolicitud(varguid_id, varetapaid,varetaparutaid,varcorrelativo) {
        var Source = "/Home/SolicitudEtapaView?guid_id=" + varguid_id + "&etapaid=" + varetapaid + "&etaparutaid=" + varetaparutaid + "&correlativo=" + varcorrelativo+"";

        document.getElementById("Pagina").value = '<iframe src="' + Source + '" frameborder="0" width="100%" height="100%"></iframe>';
        document.getElementById("Titulo").value = 'Revision de solicitud';
        $("#myModal").modal("show");

    }

</script>


@Html.Partial("_PartialPageEncabezado")

<div id="paramsbusqueda"></div>

<table class="table" style="display: block; overflow-x: auto; ">
    <tr>
        <th width="10%">
            Número
        </th>
        <th>
            Fecha de la solicitud
        </th>
        <th>
            Fecha de la etapa
        </th>
        <th>
            Acción requerida
        </th>
        <th>
            Tipo de solicitud
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Tbl_Sol_Solicitud.Tbl_Seg_UsuarioExterno.Nombres)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Tbl_Sol_Solicitud.Tbl_Seg_UsuarioExterno.Apellidos)
        </th>

        <th>
            Historial
        </th>
        <th>
            Revisar <br />
            solicitud
        </th>
        <th>
            Etapa previa
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>
                @if (item.Tbl_Sol_Solicitud.Solicitud_NumeroExpediente != null)
                {
                    @Html.DisplayFor(modelItem => item.Tbl_Sol_Solicitud.Solicitud_NumeroExpediente)
                }
                else
                {
                    @Html.DisplayFor(modelItem => item.Tbl_Sol_Solicitud.Solicitud_NumeroTemporal)
                }
                <br />
                Ref.@item.Solicitud_id

            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Tbl_Sol_Solicitud.swdateupdated)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.swdatecreated)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tbl_Gest_Etapa.Nombre_Etapa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tbl_Sol_Solicitud.Tbl_Sol_Solicitud_Categoria.Descripcion)
                -
                @Html.DisplayFor(modelItem => item.Tbl_Sol_Solicitud.Tbl_Sol_Solicitud_Sub_Categoria.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tbl_Sol_Solicitud.Tbl_Seg_UsuarioExterno.Nombres)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tbl_Sol_Solicitud.Tbl_Seg_UsuarioExterno.Apellidos)
            </td>
            <td>

                <button class="btn" rel="tooltip" title="Revisar" onclick="window.open('/Gest_EtapaSolicitud/HistorialSolicitud?Guid_id=@item.Tbl_Sol_Solicitud.Guid_id')">
                    <i><img src="~/Content/icons/workflow.png" style="border-radius: 25%; width: 35px; height: auto" /></i>
                    <div class="ripple-container"></div>
                </button>
            </td>
            <td>

                <button class="btn" rel="tooltip" title="Revisar" onclick="window.open('/Home/SolicitudEtapaView?guid_id=@item.Tbl_Sol_Solicitud.Guid_id&etapaid=@item.Etapa_id&etaparutaid=@item.EtapaRuta_id&correlativo=@item.CorrelativoEtapa_id')">
                    <i><img src="~/Content/icons/etapas.png" style="border-radius: 25%; width: 35px; height: auto" /></i>
                    <div class="ripple-container"></div>
                </button>
            </td>
            <td>
                <div style=" display:flex; flex-direction:column; max-width:250px">
                    @{

                        Query = $"  Select *  \n";
                        Query += $"  From Tbl_Gest_Etapa \n";
                        Query += $"  Where exists \n";
                        Query += $"  ( \n";
                        Query += $"      Select *     \n";
                        Query += $"      From dbo.fc_Sol_GestEtapa_CorrelativosAnterioresDetallado(" + item.Solicitud_id.ToString() + ", " + item.CorrelativoEtapa_id + ") EtapasPrevias     \n";
                        Query += $"      Where Tbl_Gest_Etapa.Etapa_id = EtapasPrevias.Etapa_id     \n";
                        Query += $"        and Tbl_Gest_Etapa.EtapaRuta_id = EtapasPrevias.EtapaRuta_id     \n";
                        Query += $"  ) \n";

                        List<Tbl_Gest_Etapa> LstEtapas = db.Tbl_Gest_Etapa.SqlQuery(Query).ToList();


                        ViewBag.LstEtapas = new SelectList(LstEtapas, "Etapa_id", "Nombre_Etapa");


                    }

                    <select class="form-select-sm" name="selectList_@item.CorrelativoEtapa_id" id="selectList_@item.CorrelativoEtapa_id" style="margin-bottom:10px">
                        @foreach (Tbl_Gest_Etapa itemEtapa in LstEtapas)
                        {
                            <option value="@itemEtapa.Etapa_id">@itemEtapa.Nombre_Etapa</option>
                        }
                    </select>

                    <button class="btn-cancel" onclick="returnEtapa('@item.Solicitud_id', '@item.CorrelativoEtapa_id', 'selectList_@item.CorrelativoEtapa_id')">Reactivar Etapa</button>
                </div>
            </td>


        </tr>
    }

</table>

