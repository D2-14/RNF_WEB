@using RNF_Web.Models;
@model List<Tbl_Gest_EtapaSolicitud_OficioTecnico_Enmienda>
@{

}

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}


<table class="table table-striped table-hover" border="0">
    <thead>
        <tr>
            <th scope="col">
                Listado de enmiendas de Oficio Técnico
            </th>
            <th scope="col">
                Acción
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <label id="DescripcionTecnica_@item.Enmienda_id">@item.Descripcion</label>
                </td>
                <td>
                    <input type="button" class="btn btn-sm btn-primary" name="EnmiendaTecnico_id_@item.Enmienda_id" id="EnmiendaTecnico_id_@item.Enmienda_id" value="Agregar" onclick="agregarEnmiendaTecnico_listar(@item.Enmienda_id)" />
                </td>
            </tr>
        }
    </tbody>
</table>

