<style>
    body {
        font-family: Arial;
    }

    /* Style the tab */
    .tab {
        overflow: hidden;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.3s;
            font-size: 17px;
            border-color: #6C8EAA;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
                border-radius: .50em;
                border: .2em solid #fff;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #6C8EAA;
                color: white;
                border-color: #6C8EAA;
                border-radius: .50em;
                border: .2em solid #fff;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 6px 12px;
        -webkit-animation: fadeEffect 1s;
        background: #FAFAC1;
        animation: fadeEffect 1s;
        padding: 2em 3em;
        border-radius: .50em;
        border: .2em solid #fff;
        border-color: #6C8EAA;
    }
</style>



