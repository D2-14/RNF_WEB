@using RNF_Web.Models;

@{
    Layout = "~/Views/Shared/_LayoutMoreSimple.cshtml";



    if (Session[Constants.session_Tabulador] == null)
    {
        Session[Constants.session_Tabulador] = "defaultArea";
    }

    long Solicitud_id = ViewBag.Solicitud_id;
    db_RNFEntities db = new db_RNFEntities();
    Tbl_Sol_Solicitud tbl_Sol_Solicitud = db.Tbl_Sol_Solicitud.Find(Solicitud_id);
    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }
    fc_Gral_Sol_Configuracion_Result permisosPoligono = db.fc_Gral_Sol_Configuracion(tbl_Sol_Solicitud.Solicitud_id, "Sol_Rodal_Poligono", boolEsInterno).FirstOrDefault();
    fc_Gral_Sol_Configuracion_Result permisosDasometrico = db.fc_Gral_Sol_Configuracion(tbl_Sol_Solicitud.Solicitud_id, "Sol_Rodal_Dasometricos", boolEsInterno).FirstOrDefault();


}
