<div id="section_ExcelRodal">
    @model System.Data.DataTable
    @using System.Data;
    @using RNF_Web.Models;
    @using System.Data.SqlClient;


    @if (Constants.VisualizarInformacionDesarrollo == 1)
    {
        <h3>@this.Url.Action()</h3>
    }


    @{
        string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();

        db_RNFEntities db = new db_RNFEntities();
        Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(Session[Constants.session_Solicitud]);

        ViewBag.Estado = tbl_sol_solicitud.Estado_id;

        Usuario objUs = (Usuario)Session["User"];
        bool boolEsInterno = false;
        if (objUs.EsInterno == 1)
        {
            boolEsInterno = true;
        }

        ViewBag.Title = "   Carga de datos dasométricos";
        fc_Gral_Sol_Configuracion_Result permisos = db.fc_Gral_Sol_Configuracion(tbl_sol_solicitud.Solicitud_id, "Sol_Rodal_Dasometricos", boolEsInterno).FirstOrDefault();

        Layout = null;
    }

    @if (Constants.VisualizarInformacionDesarrollo == 1)
    {
        <div style="visibility:visible">
            <table border="1">
                <tr>
                    <th>
                        Agregar
                    </th>
                    <th>
                        Editar
                    </th>
                    <th>
                        Borrar
                    </th>
                    <th>
                        Estado
                    </th>
                    <th>
                        Tipo
                    </th>
                    <th>
                        Controller Enviado
                    </th>
                    <th>
                        Controller Recibido
                    </th>
                </tr>
                <tr>
                    <td>
                        @permisos.Agregar
                    </td>
                    <td>
                        @permisos.Editar
                    </td>
                    <td>
                        @permisos.Borrar
                    </td>
                    <td>
                        @permisos.Estado_id
                    </td>
                    <td>
                        @permisos.SolicitudTipo_id
                    </td>
                    <td>
                        @permisos.Controlador_Recibido
                    </td>
                    <td>
                        @permisos.Controlador_Devuelto
                    </td>
                </tr>
            </table>
        </div>
    }



    <div style='height: 30px; width: 100%; background-color: green; color: white; '>
        <h4 class="title">&nbsp;&nbsp;&nbsp;@ViewBag.Title</h4>
    </div>

    @using (Html.BeginForm("UploadDatosDasometricos", "Sol_Rodal", null, FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary()

        <div class="form-group">
            <div class="col-sm-12">
                <form id="uploader">

                    @if ((bool)permisos.Editar)
                    {
                        <table>
                            <tr>
                                <td>
                                    <label>
                                        @*<img src="~/Content/icons/btnSubirArchivo.png" id="upfile1" style="cursor:pointer" />*@
                                        <label for="uploadDasometricos" id="upfileuploadDasometricos" class="btn-next-ic">&nbsp;&nbsp;&nbsp;&nbsp;Seleccionar archivo&nbsp;&nbsp;&nbsp;&nbsp;</label>
                                        <input type="file" id="uploadDasometricos" name="uploadDasometricos" style="display:none">
                                    </label>
                                </td>
                                <td>
                                    <span id="nombre_ArchivoDasometricos"></span>
                                    <br />
                                    <input type="button" id="btsubirDasometricos" class="btn btn-primary btn-outlined" width="100%"
                                           value="Subir archivo" style="display:none" />
                                </td>
                                <td>
                                    &nbsp;&nbsp;&nbsp;&nbsp;
                                </td>
                                <td>
                                    @if (tbl_sol_solicitud.Categoria_id == 6)
                                    {
                                        <a href="~/Content/Machotes/DatosDasometricos_En_Blanco_FuenteSemillera.xlsx">Bajar archivo para carga de datos dasometricos</a>
                                    }
                                    else
                                    {
                                        <a href="~/Content/Machotes/DatosDasometricos_En_Blanco.xlsx">Bajar archivo para carga de datos dasometricos</a>
                                    }
                                </td>
                                <td>
                                    &nbsp;&nbsp;&nbsp;&nbsp;
                                </td>
                                <td>
                                    @if (tbl_sol_solicitud.Categoria_id == 6)
                                    {
                                        <a href="~/Content/Machotes/DatosDasometricos_Ejemplo_FuenteSemillera.xlsx">Archivo de ejemplo</a>
                                    }
                                    else
                                    {
                                        <a href="~/Content/Machotes/DatosDasometricos_Ejemplo.xlsx">Archivo de ejemplo</a>
                                    }
                                </td>
                            </tr>
                            <tr>
                            </tr>
                        </table>
                    }
                    <br /><br />

                </form>
            </div>
            <div class="col-sm-3"></div>
        </div>

    }

    @Html.Raw(TempData["MensajeFileDasom"])

</div>


<script>


    var ArchivoDasometricos = ($("#uploadDasometricos"))[0].files[0];
    $(function () {

        $("#uploadDasometricos").change(function () {
            ArchivoDasometricos = ($("#uploadDasometricos"))[0].files[0];
            console.log(ArchivoDasometricos);
            document.getElementById("nombre_ArchivoDasometricos").innerHTML = ArchivoDasometricos.name;
            var botonSubir = document.getElementById("btsubirDasometricos");
            if ((ArchivoDasometricos != "") && (ArchivoDasometricos != null)) {
                botonSubir.classList.add("btn-primary");
                botonSubir.style.display = "block";
            } else {
                botonSubir.classList.remove("btn-primary");
                botonSubir.disabled = true;
            }
        })



        $("#btsubirDasometricos").click(function () {
            loaderPantalla(true);
            setTimeout(function () {

                ArchivoDasometricos = ($("#uploadDasometricos"))[0].files[0];
                console.log(ArchivoDasometricos);

                var formData = new FormData();


                function adjuntarImagenDasometricos() {
                    formData.append("upload", ArchivoDasometricos);
                    formData.append("Solicitud_id", '@ViewBag.Solicitud_id');
                    formData.append("firma", '@ViewBag.firma');
                    $.ajax({
                        url: "UploadDatosDasometricos",
                        type: "POST",
                        data: formData,
                        contentType: false,
                        processData: false,
                        async: false,
                        success: function (data) {
                            loaderPantalla(false);
                            location.reload();
                        },
                        error: function (data) {
                            loaderPantalla(false);
                            location.reload();
                        }
                    });

                }

                if (ArchivoDasometricos != null) {
                    adjuntarImagenDasometricos();
                } else {
                    alert("No se ha seleccionado ningún archivo");
                }


            }, 2000);



        })
    })

</script>
