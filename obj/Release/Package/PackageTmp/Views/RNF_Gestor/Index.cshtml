<script>


    function loaderPantalla(activar) {
        var contenedor = document.getElementById('contenedor_carga');

        if (activar == true) {
            contenedor.style.visibility = 'visible';
            contenedor.style.opacity = '1';
        } else {
            contenedor.style.visibility = 'hidden';
            contenedor.style.opacity = '0';
        }

    }




    var key = CryptoJS.enc.Utf8.parse('@Constants.varkey');
    var iv = CryptoJS.enc.Utf8.parse('@Constants.variv');

    function EncryptParam(strParam) {
        var encrypted = CryptoJS.AES.encrypt(
            strParam,
            key,
            {
                iv: iv,
                mode: CryptoJS.mode.CBC,
                padding: CryptoJS.pad.Pkcs7
            }
        );
        return encrypted.toString();
    }

    function DecryptParam(strParam) {
        var decrypted = CryptoJS.AES.decrypt(
            strParam,
            key,
            {
                iv: iv,
                mode: CryptoJS.mode.CBC,
                padding: CryptoJS.pad.Pkcs7
            }
        );
        return decrypted.toString(CryptoJS.enc.Utf8);
    }

    function activarVisorDeDocumentos(ubicacion) {
        document.getElementById("ubicacionVisor").value = ubicacion;
        $("#VisorDeDocumentos").submit();
    }

    function activarVisorDeDocumentosFirmado(ubicacion) {
        document.getElementById("ubicacionVisorFirmado").value = ubicacion;
        $("#VisorDeDocumentosFirmado").submit();
    }

    function MostrarCompleta() {
        ubicacion = document.getElementById("miHref").href;
        activarVisorDeDocumentos(ubicacion)
    }

    $(document).ready(function () {

        $("#btnHideModal").click(function () {

            refreshPartialViewGestor();
            $("#myModal").modal('hide');
        });


        $("#btnHideModal_Close").click(function () {

            refreshPartialViewGestor();
            $("#myModal").modal('hide');
        });


        $('#myModal').modal({
            backdrop: 'static',
            keyboard: false
        })

        $("#myModal").on('show.bs.modal', function () {
            var modal = $(this)
            modal.find('.modal-title').text(document.getElementById("Titulo").value);
            modal.find('.h_iframe').html(document.getElementById("Pagina").value);
        });

        loaderPantalla(false);

    });

</script>

