<script src="~/Scripts/simplyCountdown.min.js"></script>
<script>
            $(function () {
        simplyCountdown('#conteo', {
        year: @oTempo.Year, // required
                month: @oTempo.Month, // required
                day: @oTempo.Day, // required
                hours: @oTempo.Hour, // Default is 0 [0-23] integer
                minutes: @oTempo.Minute, // Default is 0 [0-59] integer
                seconds: @oTempo.Second, // Default is 0 [0-59] integer
                words: { //words displayed into the countdown
            days: 'Día',
                    hours: 'Hora',
                    minutes: 'Minuto',
                    seconds: 'Segundo',
                    pluralLetter: 's'
                },
                plural: true, //use plurals
                inline: true, //set to true to get an inline basic countdown like : 24 days, 4 hours, 2 minutes, 5 seconds
                inlineClass: 'simply-countdown-inline', //inline css span class in case of inline = true
                // in case of inline set to false
                enableUtc: false, //Use UTC as default
            onEnd: function () {
                //Al finalizar el temporizador se recargará la página para prevenir que este mismo pueda seguirse editando una vez haya llegado al límite de tiempo
                location.reload();
                //document.getElementById('portada').classList.add('oculta');
                return;
            }, //Callback on countdown end, put your own function here
                refresh: 1000, // default refresh every 1s
                sectionClass: 'simply-section', //section css class
                amountClass: 'simply-amount', // amount css class
                wordClass: 'simply-word', // word css class
                zeroPad: false,
                countUp: false
                });
    })
</script>
