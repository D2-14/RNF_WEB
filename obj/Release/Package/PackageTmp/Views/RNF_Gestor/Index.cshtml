    function actualizarCategoriaRegistro() {



        var No_Registro = '@No_Registro';

        var url_query = "@Url.Action("ConsultaRegistroActual","RNF_Gestor")";

        var data_query = {
            No_Registro: No_Registro
        };
    var datosregistro = null;
        $.post(url_query, data_query).done(function (jsonRespuesta) {
        var oJSON = JSON.parse(jsonRespuesta);
        datosregistro = oJSON;
        console.log(datosregistro);


