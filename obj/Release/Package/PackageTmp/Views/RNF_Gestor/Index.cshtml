<div align="center">
    <table class="table">
        <tr>
            <td colspan="4" width="100%">
                <label id="label_Fecha_Vencimiento"><strong>Fecha de Vencimiento</strong> @FechaReal</label>
            </td>
        </tr>
        <tr>
            <td width="25%">
                @if ((Model.ConstanciaFirmada != null) && (Model.ConstanciaFirmada.Trim() != ""))
                {
                    <input type="button" class="btn btn-success" name="revisar" value="Constancia" onclick="ImprimirRegistro('@Model.ConstanciaFirmada')" style="width: 300px;" />
                }
                else
                {
                    @Html.Raw("Aún no se ha generado constancia")
                }
                <input type="button" value="Impresión de datos del Registro" class="btn btn-primary" onclick="TestReportePV_RNF()" style="width: 300px;" />
            </td>
            <td width="25%">
                @{
                    //Acá hay 4 flujos diferentes
                    // ->Cuando el administrador solicita una inactivación que puede ser temporal o definitiva
                    // ->Cuando el subregional solicita una inactivación que puede ser temporal o definitiva
                    // ->Cuando la secretaria solicita una inactivación que puede ser temporal o definitiva
                    // ->Cuando el técnico solicita una inactivación que puede ser temporal o definitiva


                    //2024-05-22 Si ya hay solicitudes en proceso, que no permita crear una nueva petición de inactivación o activación
                }
                @if (SolicitudActiva == 0)
                {

                    if (((Model.Estado_id == 1) || (Model.Estado_id == 4)) && (RolAdministrador))
                    {
                        <input type="button" name="Btn_Inactivar" value="Solicitar Inactivación Administrador" class="btn btn-danger" onclick="Inactivar_Registro('95')" style="width: 300px;" />
                    }
                    if (((Model.Estado_id == 1) || (Model.Estado_id == 4)) && (RolDirectorRegional))
                    {
                        <input type="button" name="Btn_Inactivar" value="Solicitar Inactivación Regional" class="btn btn-danger" onclick="Inactivar_Registro('96')" style="width: 300px;" />
                    }
                    if (((Model.Estado_id == 1) || (Model.Estado_id == 4)) && (RolSubRegional))
                    {
                        <input type="button" name="Btn_Inactivar" value="Solicitar Inactivación SubRegional" class="btn btn-danger" onclick="Inactivar_Registro('97')" style="width: 300px;" />
                    }
                    if (((Model.Estado_id == 2) || (Model.Estado_id == 3)) && (RolSubRegional))
                    {
                        <input type="button" name="Btn_Activar" value="Solicitar Activación SubRegional" class="btn btn-danger" onclick="Activacion_Registro('0.05')" style="width: 300px;" />
                    }
                    if (((Model.Estado_id == 1) || (Model.Estado_id == 4)) && (RolSecretaria))
                    {
                        <input type="button" name="Btn_Inactivar" value="Adjuntar documento de Juez" class="btn btn-danger" onclick="Inactivar_Registro('98')" style="width: 300px;" />
                    }
                    if (((Model.Estado_id == 1) || (Model.Estado_id == 4)) && (RolTecnicoForestal))
                    {

                        if (Model.Categoria_id != 7)
                        {
                            <input type="button" name="Btn_Inactivar" value="Solicitar Inactivación Técnico" class="btn btn-danger" onclick="Inactivar_Registro('99')" style="width: 300px;" />
                        }
                        else
                        {
                            <input type="button" name="Btn_Inactivar" value="Solicitar Inactivación Técnico" class="btn btn-danger" onclick="Inactivar_Registro('94')" style="width: 300px;" />
                        }

                    }
                }
            </td>
            <td width="25%">
                @if (objRNFGrants.Editar)
                {
                    <button class="btn btn-danger" onclick="Reasignacion_Titular()" style="width: 300px;">Reasignación de Titular</button>
                }
            </td>
            <td width="25%">
                @if (objRNFGrants.Editar)
                {
                    if (objRNFGrants.GenerarConstancia)
                    {
                        // Esta regla se coloca especialmente porque:
                        //*cuando son registros migrados de RNF anterior, no se tienen muchos datos como el informe técnico entre otros
                        //*cuando son registros inscritos desde RNF tampoco se tienen muchos datos como el informe técnico, resolución entre otros
                        //*2023/Septiembre/01 se agregó también para datos creados en RNF que pueda generarse constancia, cabe destacar que esto puede ser conflictivo si no se tienen los datos suficientes
                        //*2023/Septiembre/20 se retiró el bloqueo de generación de constancia para registros migrados, esto a petición de Estefany
                        //*     El riesgo de hacer esto, es que si el registro no cumple con la estructura que debe de tener el registro, saldrá incompleta la constancia
                        //*2023/Octubre/13 bajo indicación de Emanuel y Nancy se vuelve a colocar restricción de que solamente registros migrados no pueden generarse constancia
                        if (Model.Solicitud_id != 0)
                        {
                            <button class="btn btn-primary" onclick="GenerarNuevaConstancia()" style="width: 300px;">Generar Nueva Constancia</button>
                            <br />
                        }


                    }
                }
            </td>
        </tr>
        <tr>
            <td colspan="4" width="100%">
                @if (objRNFGrants.Editar)
                {
                    //if ((RolAdministrador ||8 RolSubRegional || RolDirectorRegional) && (oTempo > DateTime.Now))
                    if (oTempo > DateTime.Now)
                    {
                        //Esta regla habilita un contador en pantalla para identificar cuando un registro está abierto a modificaciones
                        //Reglas:
                        //  -> Un administrador puede modificar el registro sin importar esta regla
                        //  -> Un subregional puede modificar el registro solamente cuando el administrador ha liberado los permisos, en pantalla aparecerá el tiempo que tiene diponible para hacer los cambios necesarios,
                        //     una vez que el contador termina, la pantalla se actualiza y de este modo ya no permitirá realizar más cambios hasta que el administrador vuelva a habilitar la edición
                        //     cualquier otro rol que no corresponda a los anteriores mencionados solamente tendrá acceso a visualizar la información
                        <strong align="center">Modificación disponbile hasta @Model.FechaModificacionDisponible.ToString()</strong>
                        <br />
                        <div id="conteo"></div>
                    }
                }
            </td>
        </tr>
    </table>
</div>


