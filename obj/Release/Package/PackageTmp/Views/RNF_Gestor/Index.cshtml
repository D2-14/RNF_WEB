        var Sub_Sub_Categoria_id = cb_Sub_Sub_Categoria_id.value;

        var cb_Region_id = document.getElementById("Region_id");
        var Region_id = cb_Region_id.value;

        var cb_SubRegion_id = document.getElementById("SubRegion_id");
        var SubRegion_id = cb_SubRegion_id.value;

        var data = {
                No_Registro: No_Registro,
                Categoria_id: Categoria_id,
                Sub_Categoria_id: Sub_Categoria_id,
                Sub_Sub_Categoria_id: Sub_Sub_Categoria_id,
                Region_id: Region_id,
                SubRegion_id: SubRegion_id
            }

    var url = "@Url.Action("ActualizarCategoriaRegion_RNF","RNF_Registro")";
    var confirmacion1 = false;
    var confirmacion2 = false;

    if ((datosregistro.categoriaid != data.Categoria_id) || (datosregistro.subcategoriaid != data.Sub_Categoria_id) || (datosregistro.subsubcategoriaid != data.Sub_Sub_Categoria_id)) {
        confirmacion1 = confirm("¿Está seguro que desea actualizar Categoria/SubCategoria/Especificacion?");
        if (!confirmacion1) {
            data.Categoria_id = datosregistro.categoriaid;
            data.Sub_Categoria_id = datosregistro.subcategoriaid;
            data.Sub_Sub_Categoria_id = datosregistro.subsubcategoriaid;
        }
    } else {
        confirmacion1 = true;
    }

    if ((datosregistro.regionid != data.Region_id) || (datosregistro.subregionid != data.SubRegion_id)) {
        confirmacion2 = confirm("¿Está seguro que desea actualizar Region/SubRegion?");
        if (!confirmacion2) {
            data.Region_id = datosregistro.regionid;
            data.SubRegion_id = datosregistro.subregionid;
        }
    } else {
        confirmacion2 = true;
    }

    if ((confirmacion1) || (confirmacion2)) {

                $.post(url, data).done(function (jsonRespuetsa) {
            console.log(jsonRespuetsa);
            var oJSON = JSON.parse(jsonRespuetsa);
            console.log(oJSON);
            var CodRespuesta = oJSON.CodRespuesta;
            var strRespuesta = oJSON.strRespuesta;
            alert(strRespuesta);
            if (CodRespuesta == 1) {
                refreshPartialViewGestor();
            }
        }).fail(function (jsonRespuesta) {
            refreshPartialViewGestor();
            alert("Ocurrió un error");
        });

        setTimeout(function () {
            refreshPartialViewGestor();
        }, 500);

    } else {

        setTimeout(function () {
            refreshPartialViewGestor();
        }, 500);

    }




        }).fail(function (jsonRespuesta) {
        refreshPartialViewGestor();
    });

