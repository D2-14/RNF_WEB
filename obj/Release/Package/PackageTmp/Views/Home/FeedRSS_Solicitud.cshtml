    var dataUpdate = new FormData();
    var esinterno = @objUs.EsInterno;
    dataUpdate.append("usuario_id", usuarioid);
    dataUpdate.append("esinterno", esinterno);

    function UpdateRSS() {
        $.ajax({
            url: "UpdateRSS/",
            type: "POST",
            data: dataUpdate,
            contentType: false,
            processData: false,
            async: false,
            success: function (data) {

            },
            error: function (data){

            }
        });
    }

    $(document).ready(function () {

        UpdateRSS();

        /*if (esinterno == 0) {
