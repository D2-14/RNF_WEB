@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

<link href="/Content/Layout.css" rel="stylesheet" />

<div class="container-fluid">

    <img src="~/Content/images/bannerregistro.png" width="100%" />

    <h4>Este proceso enviará la solicitud para ser analizada</h4>
    <hr />
    <span>

        <h3>Se realizará un análisis integral de los datos y documentos adjuntos.</h3>
        <h3>En este momento no se ha generado expediente, si los datos y documentos estan completos se le enviará un mail solicitando los documentos físicos y el pago respectivo en la sede seleccionada de la solicitud.<hr width="100%" size="1" color="silver"></h3>
        <h3> <i>Presione el boton para confirmar que desea enviar la solicitud a análisis..</i></h3>

        @if (ViewBag.MensajeError != "")
        {
            <h3 style="color:red;">@Html.Raw(ViewBag.MensajeError)</h3>
        }
    </span>


    <div class="col-sm-10 col-md-10" align="right">
        <a href="../Home/EnviarSolicitud?intEnviar=1&solicitud_id=@ViewBag.id&firma=@ViewBag.firma">
            <input type="button" value="Enviar solicitud" class="btn-next-ic" />
        </a>
    </div>

</div>

