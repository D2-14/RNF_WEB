@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

<div class="container-fluid">

    <img src="~/Content/images/bannerregistro.png" width="100%" />

    <h4>Este proceso dejará anulada la solicitud</h4>
    <hr />
    <span>

        <h1>Cierre esta ventana si no desea anular la solicitud<hr width="100%" size="1" color="silver"></h1>
        <h2> <i>Presione el boton para confirmar que anulará esta solicitud.</i></h2>

    </span>
    <div class="col-sm-10 col-md-10" align="right">
        <a href="../Home/EliminarSolicitud?intEliminar=1&id=@ViewBag.id&firma=@ViewBag.firma">
            <input type="button" value="Cancelar el proceso" class="btn btn-danger" />
        </a>
    </div>

</div>


