@model IEnumerable<RNF_Web.Models.Tbl_Sol_Empresa_Entidad_TecnicoMateria_Prima>
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@{
    Layout = null;
    ViewBag.Title = "Materia Prima";
    ViewBag.SubTitle = "Listado de Materia Prima";
    db_RNFEntities db = new db_RNFEntities();
    Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(ViewBag.SolicitudId);
    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    controllerName = "Sol_Empresa_Entidad";
    string Nombre_Div = "div_Sol_Permisos_Empresa_Entidad_Materia_Prima_Index";
    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }
    fc_Gral_Sol_Configuracion_Result permisos = db.fc_Gral_Sol_Configuracion(tbl_sol_solicitud.Solicitud_id, controllerName, boolEsInterno).FirstOrDefault();

    ViewBag.Entidad_MateriaPrima = db.Tbl_Sol_Empresa_Entidad_Materia_Prima.Where(Obj => Obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id).ToList();

}
@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <div id="@Nombre_Div"></div>
}

<br />
<br />
<table class="table">
    <tr>
        <th>
            Indicados por el usuario
        </th>
        <th>Indicados por el técnico</th>
    </tr>
    <tr>
        <td>
            <table>
                @foreach (Tbl_Sol_Empresa_Entidad_Materia_Prima itemA in ViewBag.Entidad_MateriaPrima)
                {
                    <tr>
                        <td>
                            @itemA.Tbl_Gral_Materia_Prima.Nombre_Tecnico
                        </td>
                    </tr>
                }
            </table>
        </td>
        <td>
            <table>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Tbl_Gral_Materia_Prima.Nombre_Tecnico)
                        </td>
                        <td>
                            @if ((bool)permisos.Borrar)
                            {
                                <img src="~/Content/icons/trash_green.png" onclick="Borrar_MateriaPrima(@item.Solicitud_id, @item.Materia_Prima_id,)" width="25" height="25" />
                            }
                        </td>
                    </tr>
                }
            </table>
        </td>
    </tr>
</table>


<script>
    function visualizarPermisos(solicitudid, controllername, esinterno, nombrediv) {
        var solicitudId = solicitudid;
        var controllerName = controllername;
        var esInterno = esinterno;

        var mySolPermisos = document.getElementById(nombrediv);
        if (mySolPermisos) {
            $("#" + nombrediv).load("/Gral_SolicitudConfiguracion/PermisosRecibidos?Solicitud_id=" + solicitudId + "&controllerName=" + controllerName + "&EsInterno=" + esInterno);
        }

    }


    $(document).ready(function () {
        visualizarPermisos('@tbl_sol_solicitud.Solicitud_id', '@controllerName', '@objUs.EsInterno', '@Nombre_Div');
    });

</script>
