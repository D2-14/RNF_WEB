@using RNF_Web.Models;
@model Tbl_Gest_EtapaSolicitud
@{
    ViewBag.Title = "   Home page";
    string strDisabled = "disabled";
    string strSelected = "selected";

    db_RNFEntities db = new db_RNFEntities();

    Tbl_Sol_Solicitud tbl_Sol_Solicitud = db.Tbl_Sol_Solicitud.Find(Model.Solicitud_id);


    int intEtapas = db.Tbl_Gest_EtapaSolicitud.Where(Obj => Obj.Solicitud_id == Model.Solicitud_id && Obj.EtapaSolicitud_GUID_id != Model.EtapaSolicitud_GUID_id && Obj.EtapaSolicitudEstado_id == 1).Count();

    ViewBag.intEtapas = intEtapas;
    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    string actionName = HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString();

    bool EsInactivacion = false;
    decimal solicitudtipoentero = Math.Truncate(tbl_Sol_Solicitud.SolicitudTipo_id);
    decimal terminacioninactivacion = 0.04M;
    decimal TipoGestion = tbl_Sol_Solicitud.SolicitudTipo_id - Math.Truncate(tbl_Sol_Solicitud.SolicitudTipo_id);

    if (TipoGestion == terminacioninactivacion)
    {
        EsInactivacion = true;
    }


}

