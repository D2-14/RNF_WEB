<script>

    function generarResolucion() {
        var varSolicitud_Guid_id = $('#Solicitud_Guid_id').val();
        var varEtapaSolicitud_GUID_id = $('#EtapaSolicitud_GUID_id').val();
        var varEtapa_id = $('#Etapa_id').val();
        var varEtapaRuta_id = $('#EtapaRuta_id').val();
        var varCorrelativoEtapa_id = $('#CorrelativoEtapa_id').val();
        loaderPantalla(true);
        var data = {
            Solicitud_Guid_id: varSolicitud_Guid_id,
            EtapaSolicitud_GUID_id: varEtapaSolicitud_GUID_id,
            Etapa_id: varEtapa_id,
            EtapaRuta_id: varEtapaRuta_id,
            CorrelativoEtapa_id: varCorrelativoEtapa_id
        }
        var url = "@Url.Action("GeneraResolucionSubRegional", "Form_FormularioSubRegional")";

        $.post(url, data).done(function (jsonRespuesta) {
            loaderPantalla(false);

            var objJSON = JSON.parse(jsonRespuesta);
            var Texto_Respuesta = objJSON.Ubicacion;

            window.open('/Archivos_Generados_Que_Pueden_Borrar/' + Texto_Respuesta, '_blank');

            var TdHiddeA = document.getElementById("btnFirmarDocumento");
            TdHiddeA.style.display = "block";

        });
    }

    function grabarResolucion()
    {
        var varSolicitud_id = $('#Solicitud_id').val();
        var varEtapa_id = $('#Etapa_id').val();
        var varEtapaRuta_id = $('#EtapaRuta_id').val();
        var varCorrelativoEtapa_id = $('#CorrelativoEtapa_id').val();
        var varInforme_Tecnico = $('#Informe_Tecnico').val();
        var varResolucion = $('#NoResolucion').val();
        var varSolicitud_Guid_id = $('#Solicitud_Guid_id').val();
        var varEtapaSolicitud_GUID_id = $('#EtapaSolicitud_GUID_id').val();

        var Resolucion_Aprobadajs = false;
        var Resolucion_Denegadajs = true;
        var resultResolucion_Aprobada = $('#EstadoResolucion').val();
        if (resultResolucion_Aprobada == "aprobar") {
            Resolucion_Aprobadajs = true;
            Resolucion_Denegadajs = false;
        }

        var data =
        {
            Solicitud_id: varSolicitud_id,
            Etapa_id: varEtapa_id,
            EtapaRuta_id: varEtapaRuta_id,
            CorrelativoEtapa_id: varCorrelativoEtapa_id,
            Resolucion_Aprobada: Resolucion_Aprobadajs,
            Resolucion_Denegada: Resolucion_Denegadajs,
            Informe_Tecnico: varInforme_Tecnico,
            No_Resolucion: varResolucion,
            Solicitud_Guid_id: varSolicitud_Guid_id,
            EtapaSolicitud_GUID_id: varEtapaSolicitud_GUID_id
        }

        var url = "@Url.Action("GrabarResolucion", "Form_FormularioSubRegional")";
        var url2 = "@Url.Action("VistaPreviaResolucion", "Form_FormularioSubRegional")";

        $.post(url, data).done(function (jsonRespuesta) {

            var objJSON = JSON.parse(jsonRespuesta);
            var varResultado = objJSON.Resultado;
            $("#verPDF").show();

            $.post(url2, data).done(function (jsonRespuesta) {
                var objJSON = JSON.parse(jsonRespuesta);
                var parrafo1 = objJSON.Parrafo1;
                var parrafo2 = objJSON.Parrafo2;
                var parrafo3 = objJSON.Parrafo3;
                var parrafo4 = objJSON.Parrafo4;
                var parrafo5 = objJSON.Parrafo5;
                var parrafo6 = objJSON.Parrafo6;
                var parrafo7 = objJSON.Parrafo7;

                document.getElementById("ta_Parrafo1").value = parrafo1;
                document.getElementById("ta_Parrafo2").value = parrafo2;
                document.getElementById("ta_Parrafo3").value = parrafo3;
                document.getElementById("ta_Parrafo4").value = parrafo4;
                document.getElementById("ta_Parrafo5").value = parrafo5;
                document.getElementById("ta_Parrafo6").value = parrafo6;
                document.getElementById("ta_Parrafo7").value = parrafo7;

                actualizaParrafos();

            });

        });
    }

