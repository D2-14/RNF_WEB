@using RNF_Web.Models;
@model Tbl_Gest_EtapaSolicitud
@{
    db_RNFEntities db = new db_RNFEntities();
    long Solicitud_id = ViewBag.Solicitud_id;
    string GuidEtapa_id = ViewBag.GuidEtapa_id;
    string Guid_id = ViewBag.Guid_id;
    int etapa_id = ViewBag.etapa_id;
    decimal etaparuta_id = ViewBag.etaparuta_id;
    int correlativoetapa_id = ViewBag.correlativoetapa_id;
    string strSelected = "selected";
    int intEtapas = db.Tbl_Gest_EtapaSolicitud.Where(Obj => Obj.Solicitud_id == Model.Solicitud_id && Obj.EtapaSolicitud_GUID_id != Model.EtapaSolicitud_GUID_id && Obj.EtapaSolicitudEstado_id == 1).Count();

    Tbl_Sol_Solicitud tbl_Sol_Solicitud = db.Tbl_Sol_Solicitud.Find(Solicitud_id);

}
@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}

<script>

    $(document).ready(function () {
        cambiaEstadoSolvencia();
    })

    function grabarResolucion()
    {
        var varSolicitud_id = '@Model.Solicitud_id';
        var varEtapa_id = '@Model.Etapa_id';
        var varEtapaRuta_id = '@Model.EtapaRuta_id';
        var varCorrelativoEtapa_id = '@Model.CorrelativoEtapa_id';
        var varInforme_Tecnico = '@Model.NoInformeTecnico';
        var varResolucion = '@Model.NoResolucion';
        var varSolicitud_Guid_id = '@Model.Solicitud_Guid_id';
        var varEtapaSolicitud_GUID_id = '@Model.EtapaSolicitud_GUID_id';
        var EstadoSolvencia = document.getElementById('EstadoSolvencia').value;
        var Resolucion_Aprobadajs = false;
        var Resolucion_Denegadajs = true;
        if (EstadoSolvencia == 'aprobar') {
            Resolucion_Aprobadajs = true;
            Resolucion_Denegadajs = false;
        }

        var data =
        {
            Solicitud_id: varSolicitud_id,
            Etapa_id: varEtapa_id,
            EtapaRuta_id: varEtapaRuta_id,
            CorrelativoEtapa_id: varCorrelativoEtapa_id,
            Resolucion_Aprobada: Resolucion_Aprobadajs,
            Resolucion_Denegada: Resolucion_Denegadajs,
            Informe_Tecnico: varInforme_Tecnico,
            No_Resolucion: varResolucion,
            Solicitud_Guid_id: varSolicitud_Guid_id,
            EtapaSolicitud_GUID_id: varEtapaSolicitud_GUID_id
        }

        var url = "@Url.Action("GrabarResolucion", "Form_FormularioSubRegional")";
        var url2 = "@Url.Action("VistaPreviaResolucion", "Form_FormularioSubRegional")";

        $.post(url, data).done(function (jsonRespuesta) {

            var objJSON = JSON.parse(jsonRespuesta);
            var varResultado = objJSON.Resultado;


        });
    }


    function cambiaEstadoSolvencia() {
        grabarResolucion();
    }

    function generarSolvenciaTecnicoProfesional() {

        var GuidEtapa_id = '@GuidEtapa_id';
        var Guid_id = '@Guid_id';
        var etapa_id = '@etapa_id';
        var etaparuta_id = '@etaparuta_id';
        var correlativoetapa_id = '@correlativoetapa_id';
        var btnFirmarDocumento = document.getElementById('btnFirmarDocumento');

        var data = {
            GuidEtapa_id: GuidEtapa_id,
            Guid_id: Guid_id,
            etapa_id: etapa_id,
            etaparuta_id: etaparuta_id,
            correlativoetapa_id: correlativoetapa_id
        };

        var url = '@Url.Action("GenerarDocumentoSolvencia", "Form_FormularioSubRegionalSolvencia")';

        $.post(url, data).done(function (RespuestaJSON) {
            var oJSON = RespuestaJSON;
            var Result = oJSON.Result;
            var Mensaje = oJSON.Mensaje;

            if (Result == 1) {
                var Ubicacion = oJSON.Ubicacion;
                btnFirmarDocumento.style.display = 'block';
                window.open('/Archivos_Generados_Que_Pueden_Borrar/' + Ubicacion);
            } else {
                alert(Mensaje);
            }

        }).fail(function (ErrorJSON) {
            console.log(ErrorJSON);
        });

    }



    function fnc_EnviarRespuesta(varRespuestaid)
    {
        varsolicitud_id = '@Model.Solicitud_id';
        varetapa_id = '@etapa_id';
        varetaparuta_id = '@etaparuta_id';
        varcorrelativoetapa_id = '@correlativoetapa_id';
        varMotivo = $('#Motivo').val();
        varEtapaSolicitud_GUIDid= '@GuidEtapa_id';


        var url = "@Url.Action("ActualizaEtapaRespuestaIndexSolicitud", "Form_FormularioSubRegionalSolvencia")";

        var data = { solicitud_id: varsolicitud_id, etapa_id: varetapa_id, etaparuta_id: varetaparuta_id, correlativoetapa_id: varcorrelativoetapa_id, motivo: varMotivo, respuestaid: varRespuestaid, EtapaSolicitud_GUIDid: varEtapaSolicitud_GUIDid };
        $.post(url, data).done(function (jsonRespuesta) {
               var objJSON = JSON.parse(jsonRespuesta);
               var Cod_Respuesta = objJSON.CodRespuesta;
               var Texto_Respuesta = objJSON.strRespuesta;


                if (Cod_Respuesta == 1) {
                    window.location.replace("/Gest_EtapaSolicitud/Index");
                } else {

                    $('#lblMeModelodelodelsaje').text(Texto_Respuesta);
                    alert(Texto_Respuesta);


                }

           }).fail(manejarErrorAjax).always(function () {

               alert('Error no identificado.');
            });
            return falsModel;

    }

     function FirmarDocumento() {

        var TdHiddeA = document.getElementById("btnFirmarDocumento");
            TdHiddeA.style.display = "none";
         var EstadoSolvencia = document.getElementById('EstadoSolvencia').value;
         var respuestaid = 1;
         if (EstadoSolvencia != 'aprobar') {
             respuestaid = 2;
         }


        varFirmaElectronicaUsuario = $('#FirmaElectronicaUsuario').val();
        varFirmaElectronicaPassword = $('#FirmaElectronicaPassword').val();

        var data = {
            Guid_id: '@Guid_id',
            Guidetapa_id: '@GuidEtapa_id',
            UsuarioFE: varFirmaElectronicaUsuario,
            PasswordFE: varFirmaElectronicaPassword
            };

            var url = "@Url.Action("JsonProcesarFirmaElectronica", "Form_FormularioSubRegionalSolvenciaTecnicoProfesional")";
             loaderPantalla(true);
             $.post(url, data).done(function (jsonrespuesta) {
             loaderPantalla(false);
             var oJSON = JSON.parse(jsonrespuesta);
             var NombreDocumento = oJSON.strRespuesta;
             var CodigoRespuesta = oJSON.CodRespuesta;

                if ((CodigoRespuesta == '0') || (CodigoRespuesta == 0))
                {
                    window.open("/Home/FalloFirmaElectronica?FalloFe=" + NombreDocumento, '_blank');
                }
                else
                {
                    window.open(NombreDocumento, '_blank');
                    fnc_EnviarRespuesta(respuestaid);
                }



            });

            }


</script>


<table>
    <tr>
        <th colspan="2">Datos para la firma electrónica:</th>
    </tr>
    <tr>
        <td><br /></td>
    </tr>
    <tr>
        <td width="20%">Usuario</td>
        <td width="20%">
            <input type="text" id="FirmaElectronicaUsuario" name="FirmaElectronicaUsuario" value="" />
        </td>
        <td width="20%">Password</td>
        <td width="20%">
            <input type="password" id="FirmaElectronicaPassword" name="FirmaElectronicaPassword" value="" />
        </td>
    </tr>
    <tr>
        <td>
            <br />
        </td>
    </tr>
</table>


@if (intEtapas == 0)
{
    <table>
        <tr>
            <td colspan="2">
                Aprobar/Denegar Resolución
                <br />
                <select class="form-select" name="EstadoSolvencia" id="EstadoSolvencia" onchange="cambiaEstadoSolvencia()">
                    <option @if ((bool)Model.Resolucion_Aprobada) { @strSelected ; } value="aprobar">Aprobar</option>
                    @if ((tbl_Sol_Solicitud.No_Registro == null) && (tbl_Sol_Solicitud.Procedencia_PinpepNew || tbl_Sol_Solicitud.Procedencia_PinpepOld || tbl_Sol_Solicitud.Procedencia_Probosque || tbl_Sol_Solicitud.Procedencia_secorf))
                    {
                    }
                    else
                    {
                        <option @if ((bool)Model.Resolucion_Denegada) { @strSelected ; } value="denegar">Denegar</option>
                    }
                </select>
            </td>
        </tr>
        <tr>
            <td>
                <input type="button" class="btn btn-primary" value="Generar Solvencia" onclick="generarSolvenciaTecnicoProfesional()" />
            </td>
            <td>
                <button class="btn btn-success" id="btnFirmarDocumento" name="btnFirmarDocumento" onclick="FirmarDocumento()" style="display:none;">Firmar Documento</button>
            </td>
        </tr>
    </table>
}
else
{
    <p style="width: 100%; background-color: blue; color: white; font-size:20px; "> Tiene un procedimiento pendiente </p>
    <p style="width: 100%; background-color: blue; color: white; font-size:20px; ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Previo a emitir la resolución u oficio de enmiendas.</p>

}
