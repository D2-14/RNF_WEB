@using RNF_Web.Models;
@model List<Tbl_Gest_EtapaSolicitud_OficioJuridico_Enmienda>
@{
    string chbCheck = "checked";
}



@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}



<table class="table table-striped table-hover" border="0">
    <thead>
        <tr>
            <th scope="col">
                Listado de enmiendas de Oficio Jurídico
            </th>
            <th scope="col">
                Acción
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <label id="DescripcionJuridica_@item.Enmienda_id">@item.Descripcion</label>
                </td>
                <td>
                    <input type="button" class="btn btn-sm btn-primary" name="EnmiendaJuridico_id_@item.Enmienda_id" id="EnmiendaJuridico_id_@item.Enmienda_id" value="Agregar" onclick="agregarEnmiendaJuridico_listar(@item.Enmienda_id)" />
                </td>
            </tr>
        }
    </tbody>
</table>

