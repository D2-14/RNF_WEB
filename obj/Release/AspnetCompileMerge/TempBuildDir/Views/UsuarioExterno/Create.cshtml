                        {
                            @Html.Raw("Para recibir notificaciones por medio de Whatsapp")
                            <br />
                            if ((tbl_Meta_ParametrosGenerales.WhatsappTextoDefault ?? "").Trim() != "")
                            {
                                @Html.Raw($"Por favor envie el mensaje '{tbl_Meta_ParametrosGenerales.WhatsappTextoDefault}' por medio de whatsapp al número \"" + telefono + "\"")
                            }

                        }


                    }
                </h1>
            </div>
            <div id="DatosPersonerias">
                <br />
                <br />
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" id="btnHideMyModal_Close" class="btn btn-default">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

