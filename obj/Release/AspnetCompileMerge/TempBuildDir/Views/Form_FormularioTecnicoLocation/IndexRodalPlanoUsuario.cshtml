@model IEnumerable<RNF_Web.Models.fc_Reporte_Auditorias_Sel_RodalPoligonoPlanoTecnicoOUsuario_Result>
@using RNF_Web.Models;
@using System.Data.SqlClient;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}

@{
    Layout = null;
    LocacionDatosSolicitante_API oDatosSolicitante = ViewBag.LlenarCampos;

    Tbl_Gral_VersionesDocumetoISO VersionesDocumetoISO = ViewBag.VersionesDocumetoISO;

    db_RNFEntities db = new db_RNFEntities();
    string Guid_id = ViewBag.Guid_id;
    Tbl_Sol_Solicitud tbl_Sol_Solicitud = db.Tbl_Sol_Solicitud.Where(Obj => Obj.Guid_id == Guid_id).FirstOrDefault();
    long Finca_id = ViewBag.Finca_id;
    fc_Sol_Sel_Direccion_Result DireccionSolicitud = new fc_Sol_Sel_Direccion_Result();
    if (Finca_id == 0)
    {
        DireccionSolicitud = (from d in db.fc_Sol_Sel_Direccion(tbl_Sol_Solicitud.Solicitud_id)
                              select d).FirstOrDefault();
    }
    else
    {
        Tbl_Sol_Finca tbl_Sol_Finca = (from d in db.Tbl_Sol_Finca
                                       where d.Solicitud_id == tbl_Sol_Solicitud.Solicitud_id && d.Finca_Id == Finca_id
                                       select d).FirstOrDefault();

        DireccionSolicitud = (from d in db.fc_Sol_Sel_Direccion(tbl_Sol_Solicitud.Solicitud_id)
                              where d.NombreFinca == tbl_Sol_Finca.NombreFinca
                              select d).FirstOrDefault();
    }

    string Direccion = "";
    //if (Finca_id != 0)
    //{
    //    if (DireccionSolicitud.NombreFinca.Trim() != "")
    //    {
    //        Direccion += DireccionSolicitud.NombreFinca + ", ";
    //    }
    //}
    if (DireccionSolicitud.Direccion.Trim() != "")
    {
        Direccion += DireccionSolicitud.Direccion + ", ";
    }
    if (DireccionSolicitud.Aldea.Trim() != "")
    {
        Direccion += DireccionSolicitud.Aldea + ", ";
    }
    Direccion += DireccionSolicitud.Municipio + ", ";
    Direccion += DireccionSolicitud.Departamento;

}

<script src="~/Scripts/leaflet/leaflet.js"></script>
<script src="~/Scripts/leaflet.draw.js"></script>
<link href="~/Scripts/leaflet/leaflet.css" rel="stylesheet" />
<script src="~/Content/assets/js/jquery.min.js"></script>

@foreach (var exec in Model.GroupBy(e => e.PROPERTY))
{
    foreach (var loc in Model.Where(l => l.PROPERTY == exec.Key).GroupBy(g => g.NO_GRAPHIC))
    {
        <script type="text/javascript">
            $(document).ready(function () {
                Coor(@loc.Key);
            });
        </script>
    }
}

