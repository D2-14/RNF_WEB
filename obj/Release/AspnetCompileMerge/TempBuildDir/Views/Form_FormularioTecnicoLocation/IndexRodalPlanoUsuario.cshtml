<script>
    //MAPA
    var map;
    var ajaxRequest;
    var plotlist;
    var plotlayers = [];
    var clear = false;
    map = new L.Map('map', { zoomControl: false });
    map.setView(new L.LatLng(16, -90), 7);
    let contador = 1;
    let contadormenos = 1;
    let poly = [];
    let ViewSet = [];
    //ESCALA
    L.control.scale().addTo(map);
    //ICONO NORTE
    var north = L.control({ position: "topright" });
    north.onAdd = function (map) {
        var div = L.DomUtil.create("div", "info legend");
        div.innerHTML = '<img src="/Content/icons/FlechaMapaAuditoria003.png" onclick="location.reload()" style="max-height: 150px">';

        return div;
    }
    north.addTo(map);

    let vermarca = (lat, lon, label, varpermanet) => {
        let mk = new L.circleMarker([lat, lon - 0.00005], {
            fillOpacity: 0,
            color: 'transparent',
            weight: 0
        }).bindTooltip(label,
            {
                permanent: varpermanet,
                direction: 'center',
                className: 'labelstyle'
            });
        mk.addTo(map);
    }




    let vermapa = () => {

        var group = new L.featureGroup(ViewSet);

        map.fitBounds(group.getBounds());

    }


    function initmap(data, graph, varColor, property, polyOrLine, Tipo_Area) {


        vermapa()


        console.log(polyOrLine);
       debugger


        var weightProperty = 1;
        if (property.match('Técnico')) {
            weightProperty = 3;
        }

        if (Tipo_Area == 'CP') {
            //poly[contador] = L.polyline([data], { color: 'red' }).addTo(map);
            poly[contador] = L.polyline([data], { color: varColor }).addTo(map);
        }

        if (Tipo_Area == 'AL') {
            poly[contador] = L.polyline([data], { color: varColor }).addTo(map);
        }


        if ((Tipo_Area == 'R') || (Tipo_Area == 'Desc')) {
            poly[contador] = L.polygon([data], {
                fillOpacity: 0,
                color: varColor,
                weight: weightProperty
            }).addTo(map);
        }

        //if (polyOrLine > 20000) {
        //    poly[contador] = L.polyline([data], { color: varColor, weight: 2 }).addTo(map);
        //    if (polyOrLine > 200000) {
        //        poly[contador] = L.polyline([data], { color: varColor, weight: 2}).addTo(map);
        //    }

        //} else {
        //    poly[contador] = L.polygon([data], {
        //        fillOpacity: 0,
        //        color: varColor,
        //        weight: 3
        //    }).addTo(map);

        //}

        poly[contador].bindTooltip(" " + property, { permanent: true, direction: 'center' }).openTooltip();

        contador++;

    }


   const Coor = (ID_COOR) => {
            let miResultado = [];
            let co = ID_COOR;

       var data = {
            Guid_id: '@ViewBag.Guid_id',
           Tipo_de_Area: '@ViewBag.Tipo_de_Area',
           Finca_id: '@ViewBag.Finca_id',
           Rodal_id: '@ViewBag.Rodal_id'
       };

       fetch("@Url.Content("~/Form_FormularioTecnicoLocation/ObtenerRodalCoordenadasPlanoUsuario")",
           {
               method: 'POST',
               body: JSON.stringify(data),
               headers: {
                   'Content-Type':'application/json'
               }
           })
           .then(function (res) {
                return res.json();
            })
            .then(function (miJson) {
                let property = '';
                let graph = '';
                let area = '';
                let reg = '';
                let strColor = '';
                let strTipo = '';

                let start_i = 0;
                let current_co = -1;

                let CadaCuando = 1;

                if ((miJson.length > 75) && (miJson.length < 500))
                {
                     CadaCuando = 1;
                }

                if ((miJson.length > 500)) {
                    CadaCuando = 1;
                }

                if ((miJson.length > 1000)) {
                    CadaCuando = 1;
                }

                let polyOrLine

                for (let i = 0; i < miJson.length; i++) {



                    if (miJson[i].NO_GRAPHIC == co) {

                        polyOrLine = miJson[i].NO_GRAPHIC;

                        if (current_co != co)
                        {
                            start_i = i - 1;
                            current_co = co;
                        }

                        miResultado.push([miJson[i].LAT, miJson[i].LON])
                        property = miJson[i].PROPERTY
                        graph = miJson[i].NO_GRAPHIC
                        area = miJson[i].AREA
                        reg = @tbl_Sol_Solicitud.Solicitud_id
                        strColor = miJson[i].COLOR
                        strTipo = miJson[i].Tipo_Area

                        var marker = L.marker([miJson[i].LAT, miJson[i].LON]);


                        if ((i % CadaCuando) == 0)
                        {
                            vermarca(miJson[i].LAT, miJson[i].LON, (i - start_i).toString(), true);
                        }
                        else
                        {
                            vermarca(miJson[i].LAT, miJson[i].LON, (i - start_i).toString(), false);
                        }

                        ViewSet.push(marker);

                    }
                }


                initmap(miResultado, graph, strColor, property, polyOrLine, strTipo);



            })

    }

    ////// LINEA
    //let polylinear = new L.Polyline([[51.51, -0.10], [51.503, -0.10]], {
    //    color: 'red',
    //    weight: 3,
    //    opacity: 0.5,
    //    smoothFactor: 1
    //});
    //polylinear.addTo(map);


</script>


