@model IEnumerable<RNF_Web.Models.Gest_EtapaSolicitudHistorial>
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Url.Action("IndexHistorial", "Gest_EtapaSolicitud")
}

@{
    ViewBag.Title = "Etapas del proceso";
    ViewBag.SubTitle = null;
}


