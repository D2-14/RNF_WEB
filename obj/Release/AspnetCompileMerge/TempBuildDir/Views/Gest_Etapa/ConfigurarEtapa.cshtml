                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EscalamientoC_Telefono, "Teléfono tercer escalamiento", htmlAttributes: new { @class = "control-label col-md-10" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.EscalamientoC_Telefono, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.EscalamientoC_Telefono, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CheckList_Titulo, "Título de la verificación", htmlAttributes: new { @class = "control-label col-md-12" })
                                    <div class="col-md-12">
                                        @Html.EditorFor(model => model.CheckList_Titulo, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.CheckList_Titulo, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <br />
                            <div class="row">
                                <div class="col-sm-2 col-md-2">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Respuesta_Explicita, "Respuesta explicita ?? ", htmlAttributes: new { @class = "control-label col-md-12" })
                                        <div class="checkbox">
                                            @Html.EditorFor(model => model.Respuesta_Explicita)
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-1 col-md-1">
                                </div>
                                <div class="col-sm-2 col-md-2">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EtapaInicialRuta, "Esta es la etapa inicial ?? ", htmlAttributes: new { @class = "control-label col-md-12" })
                                        <div class="checkbox">
                                            @Html.EditorFor(model => model.EtapaInicialRuta)
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-1 col-md-1">
                                </div>
                                <div class="col-sm-2 col-md-2">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RevisarQueNoExistanEtapasPreviasActivas, "Revisar que no existan etapas previas en estado activo", htmlAttributes: new { @class = "control-label col-md-12" })
                                        <div class="checkbox">
                                            @Html.EditorFor(model => model.RevisarQueNoExistanEtapasPreviasActivas)
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-1 col-md-1">
                                </div>
                            </div>

                            <br />
                            <div class="row">
                                <div class="col-sm-2 col-md-2">
                                </div>
                                <div class="col-sm-2 col-md-2">
                                </div>
                                <div class="col-sm-2 col-md-2">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Documentos_RequeridosDescripcion, "Nombre del documento requerido", htmlAttributes: new { @class = "control-label col-md-12" })
                                        <div class="checkbox">
                                            @Html.EditorFor(model => model.Documentos_RequeridosDescripcion)
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <br />
                            <div class="row">
                                <div class="col-sm-2 col-md-2">
                                </div>
                                <div class="col-sm-2 col-md-2">
                                </div>

                                <div class="col-sm-2 col-md-2">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RequiereDocumentos, "Requiere subir documentos", htmlAttributes: new { @class = "control-label col-md-12" })
                                        <div class="checkbox">
                                            @Html.EditorFor(model => model.RequiereDocumentos)
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <h1 style="background-color:powderblue;">@ViewBag.Gest_EtapaNuevaError</h1>

                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" value="Actualizar" class="btn btn-success" />
                                </div>
                            </div>
                        </div>
