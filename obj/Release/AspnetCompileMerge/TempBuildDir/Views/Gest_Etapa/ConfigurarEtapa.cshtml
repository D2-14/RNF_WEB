@model RNF_Web.Models.Tbl_Gest_Etapa

@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}


@{
    ViewBag.Title = "   Home page";

    Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
}

<script>

    $(document).ready(function () {

    });

</script>

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-1 col-md-1 col-sm-1">
                <button rel="tooltip" title="Regresar" onclick="location.href='@Url.Action("Index", "Gest_Etapa", new {rutaid = Model.EtapaRuta_id } )'">
                    <i><img src="~/Content/icons/regresar.png" style="border-radius: 30%; width: 35px; height: auto" /></i>
                    <div class="ripple-container"></div>
                    Etapas
                </button>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12">

                <div class="card">
                    <div class="card-header" data-background-color="blue">
                        <h4 class="title">Etapa</h4>
                        <p class="category">Configuración de etapa para el tipo de solicitud @Model.Tbl_Gest_EtapaRuta.Descripcion</p>
                    </div>



                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="container-fluid">
                            <hr />
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            @Html.HiddenFor(model => model.Etapa_id)
                            @Html.HiddenFor(model => model.EtapaRuta_id)
                            @Html.HiddenFor(model => model.swcreatedby)
                            @Html.HiddenFor(model => model.swdatecreated)
                            @Html.HiddenFor(model => model.swcreatedbyinterno)

                            @Html.HiddenFor(model => model.swdateupdated)
                            @Html.HiddenFor(model => model.swupdatedby)
                            @Html.HiddenFor(model => model.swupdatedbyinterno)

                            <div class="row">
                                <div class="col-sm-12 col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Rol_id, htmlAttributes: new { @class = "control-label col-md-12" })
                                        <div class="col-md-10">
                                            @Html.DropDownList("Rol_id", null, htmlAttributes: new { @class = "form-select" })
                                            @Html.ValidationMessageFor(model => model.Rol_id, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-12 col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Nombre_Etapa, htmlAttributes: new { @class = "control-label col-md-12" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.Nombre_Etapa, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.Nombre_Etapa, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-12 col-md-12">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Url_Formulario, htmlAttributes: new { @class = "control-label col-md-12" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.Url_Formulario, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.Url_Formulario, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <div class="row">
                                <div class="col-sm-12 col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EscalamientoA_Horas, "Dias primer escalamiento", htmlAttributes: new { @class = "control-label col-md-10" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.EscalamientoA_Horas, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.EscalamientoA_Horas, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-12 col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EscalamientoA_Email, "Correo primer escalamiento", htmlAttributes: new { @class = "control-label col-md-10" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.EscalamientoA_Email, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.EscalamientoA_Email, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-12 col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EscalamientoA_Telefono, "Teléfono primer escalamiento", htmlAttributes: new { @class = "control-label col-md-10" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.EscalamientoA_Telefono, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.EscalamientoA_Telefono, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-12 col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EscalamientoB_Horas, "Días segundo escalamiento", htmlAttributes: new { @class = "control-label col-md-10" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.EscalamientoB_Horas, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.EscalamientoB_Horas, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-12 col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EscalamientoB_Email, "Correo segundo escalamiento", htmlAttributes: new { @class = "control-label col-md-10" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.EscalamientoB_Email, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.EscalamientoB_Email, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-12 col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EscalamientoB_Telefono, "Teléfono segundo escalamiento", htmlAttributes: new { @class = "control-label col-md-10" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.EscalamientoB_Telefono, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.EscalamientoB_Telefono, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-12 col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EscalamientoC_Horas, "Días tercer escalamiento", htmlAttributes: new { @class = "control-label col-md-10" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.EscalamientoC_Horas, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.EscalamientoC_Horas, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-12 col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EscalamientoC_Email, "Correo tercer escalamiento", htmlAttributes: new { @class = "control-label col-md-10" })
                                        <div class="col-md-10">
                                            @Html.EditorFor(model => model.EscalamientoC_Email, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.EscalamientoC_Email, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

