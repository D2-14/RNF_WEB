            <div class="col">
                <label class="control-label col-md-12">Región</label>
                @Html.DropDownList("Region_id", null, htmlAttributes: new { @class = "form-select" })

                <label class="control-label col-md-12">Sub-Región</label>
                @Html.DropDownList("SubRegion_id", null, htmlAttributes: new { @class = "form-select" })
