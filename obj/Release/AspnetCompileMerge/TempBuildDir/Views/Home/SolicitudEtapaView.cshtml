@{

    string TipoDeSolicitud = "";

    ViewBag.Title = "   Home page";

    Layout = "~/Views/Shared/_LayoutMenu.cshtml";
    Layout = "~/Views/Shared/_LayoutSimpleSolicitud.cshtml";
    Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
    Tbl_Sol_Solicitud tbl_sol_solicitud;
    db_RNFEntities db = new db_RNFEntities();

    long lngSolicitud_id = ViewBag.lngSolicitud_id;

    if (lngSolicitud_id != 0)
    {
        tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(lngSolicitud_id);
    }
    else
    {
        tbl_sol_solicitud = null;
    }


    if (tbl_sol_solicitud == null)
    {
        TipoDeSolicitud = "Nueva solicitud";
        ViewBag.EstadoDesc = "Solicitud a completar";
        ViewBag.SolicitudTipo_id = 0;

    }
    else
    {
        TipoDeSolicitud = db.Database.SqlQuery<string>("SELECT dbo.fnc_Sol_TipoDeGestionDesc(@p0)", tbl_sol_solicitud.SolicitudTipo_id).FirstOrDefault();
        ViewBag.Estado = tbl_sol_solicitud.Estado_id;
        ViewBag.EstadoDesc = tbl_sol_solicitud.Tbl_Sol_Solicitud_Estado.Descripcion;
    }

    long soltry = 0;
    string registrotry = "";
    if (tbl_sol_solicitud != null)
    {
        soltry = tbl_sol_solicitud.Solicitud_id;
        registrotry = tbl_sol_solicitud.No_Registro;
    }

    bool tieneRNF = false;
    string NoRegistroRNF = "";
    if (tbl_sol_solicitud != null)
    {
        if ((tbl_sol_solicitud.No_Registro != null) && (tbl_sol_solicitud.No_Registro.Trim() != ""))
        {
            NoRegistroRNF = tbl_sol_solicitud.No_Registro;
            Tbl_RNF_Registro tbl_RNF_Registro = db.Tbl_RNF_Registro.Where(Obj => Obj.No_Registro == NoRegistroRNF).FirstOrDefault();
            if (tbl_RNF_Registro != null)
            {
                tieneRNF = true;
            }
        }
    }

    ViewBag.Title = "Create";
}


