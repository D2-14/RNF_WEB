    function Agregarme_Como_Arrendatario(varSolicitudId, varTipo) {
        if (document.getElementById('PersoneriaArrendatario')) {
            var e = document.getElementById("PersoneriaArrendatario");

            if (e.value == 1) {

                $.ajax({
                    type: 'POST',
                    url: "@(Url.Action("AgregarmeComoArrendatarioRepresentante", "Home"))",
                    dataType: 'json',
                    data: { tipo: varTipo, solicitud: @Model.Solicitud_id, firma: '@Model.Guid_id' },
                    success: function (doc) {

                        $('#section_Link_II').load('@Html.Raw(ViewBag.section_Link_II)')
                        $('#section_Link_III').load('@Html.Raw(ViewBag.section_Link_III)')
                        $('#section_Link_IV').load('@Html.Raw(ViewBag.section_Link_IV)')
                        $('#section_Link_V').load('@Html.Raw(ViewBag.section_Link_V)')
                        $('#section_Link_VI').load('@Html.Raw(ViewBag.section_Link_VI)')
                        $('#section_Link_VII').load('@Html.Raw(ViewBag.section_Link_VII)')
                    },
                    error: function (ex) {
                        alert('Ocurrio un error aqui. ' + ex.status);
                    }

                });
            }
            else {
                Agregar_Arrendatario()
            }
        }
        else
        {
                $.ajax({
                    type: 'POST',
                    url: "@(Url.Action("AgregarmeComoArrendatarioRepresentante", "Home"))",
                    dataType: 'json',
                    data: { tipo: varTipo, solicitud: @Model.Solicitud_id, firma: '@Model.Guid_id' },
                    success: function (doc) {

                        $('#section_Link_II').load('@Html.Raw(ViewBag.section_Link_II)')
                        $('#section_Link_III').load('@Html.Raw(ViewBag.section_Link_III)')
                        $('#section_Link_IV').load('@Html.Raw(ViewBag.section_Link_IV)')
                        $('#section_Link_V').load('@Html.Raw(ViewBag.section_Link_V)')
                        $('#section_Link_VI').load('@Html.Raw(ViewBag.section_Link_VI)')
                        $('#section_Link_VII').load('@Html.Raw(ViewBag.section_Link_VII)')
                    },
                    error: function (ex) {
                        alert('Ocurrio un error aqui. ' + ex.status);
                    }

                });
        }

        return false;
    }

    function Agregar_Arrendatario() {
        var e = document.getElementById("PersoneriaArrendatario");

        if (e.value == 0) {
            alert("Debe indicar el tipo de arrendatario a agregar.");
        }

        if (e.value == 1) {

            var Source = "/Sol_ArrendatarioPersonaIndividual/Create"+ "?firma=@Model.Guid_id&solicitud_id=" + @Model.Solicitud_id;

            document.getElementById("Pagina").value = '<iframe src="' + Source + '" frameborder="0" width="100%" height="100%"></iframe>';
            document.getElementById("Titulo").value = 'Agregar Arrendatario';
            $("#myModal").modal("show");
        }

        if (e.value == 2) {

            var Source = "/Sol_ArrendatarioPersonaJuridica/Create"+ "?firma=@Model.Guid_id&solicitud_id=" + @Model.Solicitud_id;

            document.getElementById("Pagina").value = '<iframe src="' + Source + '" frameborder="0" width="100%" height="100%"></iframe>';
            document.getElementById("Titulo").value = 'Agregar Arrendatario';
            $("#myModal").modal("show");

        }

    }


