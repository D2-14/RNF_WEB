@model RNF_Web.Models.Tbl_Seg_Rol
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@{
    Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
    ViewBag.Title = "Rol";
    ViewBag.SubTitle = "Crear de un nuevo rol";
}



@Html.Partial("_PartialPageEncabezado")

<button class="btn-secondary" style="position: absolute; right: 0;" rel="tooltip" title="Regresar" onclick="location.href='@Url.Action("Index", "Seg_Usuario")'">
    <i><img src="~/Content/icons/regresar.png" style="border-radius: 30%; width: 35px; height: auto" /></i>
    <div class="ripple-container"></div>
</button>

<button rel="tooltip" title="Regresar" onclick="location.href='@Url.Action("Index", "Gest_EtapaRuta")'">
    <i><img src="~/Content/icons/regresar.png" style="border-radius: 30%; width: 40px; height: auto" /></i>
    <div class="ripple-container"></div>
    Regresar
</button>

<br />
<br />

<script src="~/Scripts/jquery-3.6.0.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @Html.HiddenFor(model => model.Rol_id)
    @Html.HiddenFor(model => model.swdatecreated)
    @Html.HiddenFor(model => model.swcreatedby)
    @Html.HiddenFor(model => model.swdateUpdated)
    @Html.HiddenFor(model => model.swUpdatedby)


    <div class="container">

        <div class="row">
            <div class="col-sm-12 col-md-12">

                <div class="form-group">
                    @Html.LabelFor(model => model.Nombre, " Nombre del rol", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>


        <br />
        <br />
        <div class="row">
            <div class="col-sm-12 col-md-6">
            </div>
            <div class="col-sm-12 col-md-3">
            </div>
            <div class="col-sm-12 col-md-3">
                @TempData["RollMessage"]
                <input type="submit" value="Guardar cambios" class="btn btn-success btn-fab btn-round" />
            </div>
        </div>
        <br />
        <br />
    </div>

}


@Html.Partial("_PartialPageEncabezadoCierre")


