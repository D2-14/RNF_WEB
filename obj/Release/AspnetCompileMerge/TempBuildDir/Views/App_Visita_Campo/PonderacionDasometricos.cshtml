@using RNF_Web.Models;
@model Tbl_Sol_Solicitud
@{
}

<script>
    $(document).ready(function () {
        $(document).on('change', '#PonderacionEvaluacionTecnicaDasometrica_id', function () {

            var url = "@Url.Action("EvaluacionDasometrico", "App_Visita_Campo")";
            var Opcion = $('#PonderacionEvaluacionTecnicaDasometrica_id').val();
            var data = {
                Guid_id: '@ViewBag.guidid',
                Opcion: Opcion
            };

            $.post(url, data).done(function (ListData) {

            }).fail(manejaErrorAjax).always(function () {

            });

        });
    })
</script>

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}


<div class="col">
    <div class="form-group">
        @if (ViewBag.Owner == 1)
        {
            @Html.DropDownList("PonderacionEvaluacionTecnicaDasometrica_id", null, htmlAttributes: new { @class = "form-select" })
        }
        else
        {
            @Html.DropDownList("PonderacionEvaluacionTecnicaDasometrica_id", null, htmlAttributes: new { @class = "form-select", @disabled = "disabled" })
        }


        @Html.HiddenFor(m => m.PonderacionEvaluacionTecnicaDasometrica_id)
        @Html.ValidationMessageFor(model => model.PonderacionEvaluacionTecnicaDasometrica_id, "", new { @class = "text-danger" })
    </div>
</div>

