@model RNF_Web.Models.Tbl_Gral_Especie
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@{
    Layout = "~/Views/Shared/_LayoutSimple.cshtml";
}


<script src="~/Scripts/jquery-3.6.0.js"></script>
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.js"></script>

<script src="~/Scripts/jquery.validate.min.js"></script>

<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script>


    $(document).ready(function () {


        $(document).on('change', '#Latifoliada', function () {
            const Latifoliada = document.querySelector('#Latifoliada');
            const Conifera = document.querySelector('#Conifera');

            var blconifera;
            if (Latifoliada.checked = true) { Conifera.checked = false; }
            else { Conifera.checked = true; }

        }); // -----Fin de Change Grado_Academico_Tecnico

        $(document).on('change', '#Conifera', function () {
            const Latifoliada = document.querySelector('#Latifoliada');
            const Conifera = document.querySelector('#Conifera');

            if (Conifera.checked = true) { Latifoliada.checked = false; }
            else { Latifoliada.checked = true; }


        }); // -----Fin de Change Grado_Academico_Tecnico


    });


</script>



@using (Html.BeginForm())
