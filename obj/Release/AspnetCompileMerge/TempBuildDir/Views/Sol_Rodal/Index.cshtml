@using RNF_Web.Models;
@using System.Data.SqlClient;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}



<div id="section_Rodal">
    @model IEnumerable<RNF_Web.Models.Tbl_Sol_Rodal>

    @{
        db_RNFEntities db = new db_RNFEntities();
        Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(ViewBag.solicitud_id);

        ViewBag.Estado = tbl_sol_solicitud.Estado_id;

        ViewBag.Guid_id = tbl_sol_solicitud.Guid_id;


        ViewBag.AreaTotalDescuento = db.Tbl_Sol_Rodal_Descuento.Where(Obj => Obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id).Sum(Obj => Obj.AreaTotal);

        ViewBag.AreaTotalDescuento = ViewBag.AreaTotalDescuento ?? 0;

        ViewBag.TotalLongitud = db.Tbl_Sol_Rodal.Where(Obj => Obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id).Sum(Obj => Obj.Longitud_Total);


        ViewBag.AreaTotal = db.Tbl_Sol_Rodal.Where(Obj => Obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id).Sum(Obj => Obj.AreaTotal);
        ViewBag.AreaTotalCalculadaSistema = db.Tbl_Sol_Rodal.Where(Obj => Obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id).Sum(Obj => Obj.AreaTotalCalculadaSistema);


        ViewBag.AreaTotal = ViewBag.AreaTotal ?? 0;
        ViewBag.AreaTotalCalculadaSistema = ViewBag.AreaTotalCalculadaSistema ?? 0;


        ViewBag.AreaTotalEfectiva = ViewBag.AreaTotal - ViewBag.AreaTotalDescuento;


        ViewBag.CantidadFincas = db.Tbl_Sol_Finca.Where(Obj => Obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id).Count();

        if (ViewBag.CantidadFincas > 0)
        {

            ViewBag.MaxFincaId = db.Tbl_Sol_Finca.Where(Finca => Finca.Solicitud_id == tbl_sol_solicitud.Solicitud_id).Max(u => u.Finca_Id);

        }
        else
        {
            ViewBag.MaxFincaId = 0;
        }


        string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
        string Nombre_Div = "div_Sol_Permisos_Sol_Rodal";
        Usuario objUs = (Usuario)Session["User"];
        bool boolEsInterno = false;
        if (objUs.EsInterno == 1)
        {
            boolEsInterno = true;
        }
        fc_Gral_Sol_Configuracion_Result permisos = db.fc_Gral_Sol_Configuracion(tbl_sol_solicitud.Solicitud_id, controllerName, boolEsInterno).FirstOrDefault();

    }
    @if (Constants.VisualizarInformacionDesarrollo == 1)
    {
        <div id="@Nombre_Div"></div>
    }



    <script>

        function descargarDatosPoligonos() {

                    var url = "@Url.Action("DescargaDatosPoligonos", "Form_FormularioTecnico")";
                    var Guid_id = '@ViewBag.Guid_id';
                    var data = {
                    Guid_id: Guid_id
                    }

                    $.post(url, data).done(function (jsonRespuesta) {
                    var objJSON = JSON.parse(jsonRespuesta);
                    var Ubicacion = objJSON.Ubicacion;
                        console.log(objJSON);
                        console.log(Ubicacion);
                        // window.open(Ubicacion, '_blank');
                        download(Ubicacion, "FormularioGenerado.xlsx")
                    });

            }

    </script>

    <script type="text/javascript">
        function visualizarPermisos(solicitudid, controllername, esinterno, nombrediv) {
            var solicitudId = solicitudid;
            var controllerName = controllername;
            var esInterno = esinterno;

            var mySolPermisos = document.getElementById(nombrediv);
            if (mySolPermisos) {
                $("#" + nombrediv).load("/Gral_SolicitudConfiguracion/PermisosRecibidos?Solicitud_id=" + solicitudId + "&controllerName=" + controllerName + "&EsInterno=" + esInterno);
            }

        }

        function popUp(URL) {
            //    window.open(URL, 'Nombre de la ventana', 'toolbar=0,scrollbars=0,location=0,statusbar=0,menubar=0,resizable=1,width=1000,height=500,left = 300,top = 50');

            Editar_Rodal(URL);

        }

        function PlanoXFinca()
        {
            var MaxFincaId = @ViewBag.MaxFincaId;
            var NoFinca = $('#No_Finca').val();


            if (NoFinca == 0)
            {
                alert('El número de finca no debe ser cero, debe ser valido, entre 1 y ' + MaxFincaId + ',  acorde al ID de la finca para la que desea el plano')
            }
            else
            if (NoFinca > MaxFincaId)
            {
                alert('El número de finca debe ser valido, entre 1 y ' + MaxFincaId + ',  acorde al ID de la finca para la que desea el plano')
            }
            else
            {
                window.open('/Locacion/IndexRodalPlanoVertical?solicitud_id=@ViewBag.solicitud_id&firma=@ViewBag.guidid&Finca_id=' + NoFinca +'&Rodal_id=0', '_blank');
            }

        }




    </script>

    <div class="container-fluid">
        <div class="titulo-dos">
            <h4>@Html.Raw(Constants.Titulo_Rodal_Linea)</h4>
        </div>

        <br />

        <div class="row mt-2">
            <div class="col">
            </div>
            <div class="col">
            </div>
            <div class="col text-center">
                <div class="d-grid gap-2">

                    <button class="btn-next-ic" onclick="AgregarPoligonos(); return false;">
                        <i class="fa in fa-plus-circle" aria-hidden="true"></i><br />Agregar polígonos, áreas de descuento y/ó datos dasométricos
                    </button>

                    <a href="/Content/SoporteAudioVisualUsuario/006_Poligonos.mp4" target="_blank">
                        <img width="50" height="auto" src="~/Content/icons/VideoTutoria.gif" />
                    </a>

                </div>
            </div>
            <div>
            </div>
        </div>

        <br />

        @*window.open('/Locacion/IndexRodalPlanoVertical?solicitud_id=@ViewBag.solicitud_id&firma=@ViewBag.guidid&Finca_id=' + NoFinca +'&Rodal_id=0', '_blank');*@


        <div class="row">
            <div class="col-md">
                <input type="button" rel="tooltip" title="Mapa" value="            Mapa             " class="btn-next-ic" onclick="window.open('@Url.Action("IndexRodal", "Locacion", new {solicitud_id= @ViewBag.solicitud_id , firma= @ViewBag.guidid, Rodal_id = 0 })')" />
            </div>
            <div class="col-md">
                <input type="button" rel="tooltip" title="Mapa Google" value="    Mapa Google      " class="btn-next-ic" onclick="window.open('@Url.Action("IndexRodalGoogleMaps", "Locacion", new { solicitud_id= @ViewBag.solicitud_id , firma= @ViewBag.guidid, Rodal_id = 0 })')" />
            </div>
            <div class="col-md">
                <input type="button" rel="tooltip" title="Plano completo" value="  Plano Completo  " class="btn-next-ic" onclick="window.open('@Url.Action("IndexRodalPlanoVertical", "Locacion", new { solicitud_id= @ViewBag.solicitud_id , firma= @ViewBag.guidid, Finca_id = 0, Rodal_id = 0 })')" />
            </div>

            <div class="col mt-2">
                No. Finca
            </div>
            <div class="col">
                <input type="text" id="No_Finca" name="No_Finca" oninput="this.value = this.value.replace(/[^0-9]/g, '').replace(/(\..*?)\..*/g, '$1');" value="0" />
            </div>
            <div class="col">
                <input type="button" value="  Plano por finca  " class="btn-next-ic" onclick="PlanoXFinca()" />
            </div>
        </div>

        <div class="col-md">
            <input type="button"  rel="tooltip" title="Datos cargados" value="  Datos cargados  " class="btn-next" onclick="descargarDatosPoligonos()" />
        </div>


        <div class="table-responsive">
            <table class="table">
                <tr>
                    <th>
                        Finca Id
                    </th>
                    <th>
                        Id
                    </th>
                    <th>
                        Tipo de área
                    </th>
                    <th>
                        Área total(ha)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.GTMX)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.GTMY)
                    </th>
                    <th>Polígono</th>
                    <th></th>
                    <th colspan="2">
                        @if (tbl_sol_solicitud.Procedencia_secorf && (tbl_sol_solicitud.No_Registro == null))
                        {
                            @Html.Raw("Secorf Tipo Rodal")
                        }
                    </th>
                    <th></th>
                </tr>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Finca_id)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Rodal_Id)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Tbl_Sol_Rodal_Tipo.Descripcion)
                        </td>

                        <td>
                            @if (item.Tipo_de_Area == 2)
                            {
                                @Html.DisplayFor(modelItem => item.Longitud_Total)
                                <label> metros</label>
                            }
                            else
                            {
                                @Html.DisplayFor(modelItem => item.AreaTotal)
                                <label> ha</label>
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.GTMX)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.GTMY)
                        </td>
                        <td>
                            @if (@item.Tbl_Sol_Rodal_Poligono.Count() > 0)
                            {
                                <img src="~/Content/icons/si.png" width="25" height="25" />
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("IndexRodalPlanoVertical", "Locacion", new { solicitud_id= @ViewBag.solicitud_id , firma= @ViewBag.guidid, Finca_id = item.Finca_id, Rodal_id = item.Rodal_Id, Tipo = item.Tipo_de_Area })" target="_blank">Plano</a>
                        </td>
                        <td>
                            @if (tbl_sol_solicitud.Procedencia_secorf && (tbl_sol_solicitud.No_Registro == null))
                            {
                                if (item.Secorf_TipoRegistro_id != null)
                                {
                                    @(item.Tbl_Gral_Secorf_TipoRegistro.Descripcion??"")
                                }
                            }
                            @*<img src="~/Content/icons/edit-9-xxl.png" onclick="Editar_Rodal('/Sol_Rodal/Edit/@item.Rodal_Id')" width="30" height="30" />*@
                        </td>
                        <td>
                            @if (tbl_sol_solicitud.Procedencia_secorf && (tbl_sol_solicitud.No_Registro == null))
                            {
                                if ((bool)permisos.Editar)
                                {
                                    <input type="button" class="btn btn-primary" value="Editar" onclick="EditarRodalSecorf('@item.Finca_id','@item.Rodal_Id','@item.Tipo_de_Area')" />
                                }
                            }
                        </td>
                        <td>
                            @if ((bool)permisos.Borrar)
                            {
                                <div class="div-icons-table" onclick="Borrar_Rodal(@item.Finca_id,  @item.Tipo_de_Area, @item.Rodal_Id)">
                                    <i class="fa in fa-trash-o" aria-hidden="true"></i>
                                </div>
                            }
                        </td>


                    </tr>
                }
                <hr />
                <hr />
                <tr>
                    <td></td>
                    <th>Área total</th>
                    <th>@ViewBag.AreaTotal</th>
                    <td>
                    </td>
                </tr>
                <tr>
                    <td>
                        <br />
                    </td>
                </tr>

                <tr>
                    <td></td>
                    <th>Área total</th>
                    <th>@ViewBag.AreaTotal</th>
                    <th>
                        Área de descuento
                    </th>
                    <th>
                        @ViewBag.AreaTotalDescuento
                    </th>
                    <th>
                        = Área de efectiva
                    </th>
                    <th>
                        @ViewBag.AreaTotalEfectiva
                    </th>
                </tr>
                <tr>
                    <td></td>
                    <th>Longitud de Línea</th>
                    <th>@ViewBag.TotalLongitud</th>
                </tr>
                <tr>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td colspan="2">
                    </td>
                    <td colspan="3">
                        @if ((bool)permisos.Agregar)
                        {
                            <h6>Click en la imagen para agregar información requerida</h6>
                        }
                    </td>
                    <td>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <div>
        @foreach (var item in ViewBag.Inconvenientes)
        {
            <table>
                <tr>
                    <td>
                    </td>
                    <td width="80%">
                        <p style="color:blue">@Html.Raw(item.Descripcion)</p>
                    </td>
                    <td>
                    </td>
                </tr>
            </table>
        }

    </div>

</div>

<script>
    function descargarDatosPoligonosyDescuento() {

        var url = "@Url.Action("DescargaDatosPoligonosyDescuento", "Form_FormularioTecnico")";
        var Guid_id = '@ViewBag.Guid_id';
        var data = {
            solicitud_id: '@ViewBag.solicitud_id',
            Guid_id: Guid_id
        }

        $.post(url, data).done(function (jsonRespuesta) {
            var objJSON = JSON.parse(jsonRespuesta);
            var Result = objJSON.Result;
            var Ubicacion = objJSON.Ubicacion;
            var Mensaje = objJSON.Mensaje;
            if (Result == 1) {
                //window.open(Ubicacion, '_blank');
                download(Ubicacion, "DatosPoligonosyDescuento.xlsx")

            } else {
                alert(Mensaje);
            }

        });

    }


</script>