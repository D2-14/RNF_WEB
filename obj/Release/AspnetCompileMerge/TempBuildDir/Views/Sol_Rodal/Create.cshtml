        @Html.HiddenFor(model => model.swdatecreated)
        @Html.HiddenFor(model => model.swcreatedbyinterno)
        @Html.HiddenFor(model => model.GTMX)
        @Html.HiddenFor(model => model.GTMY)

        @Html.HiddenFor(model => model.swdateupdated)
        @Html.HiddenFor(model => model.swupdatedby)
        @Html.HiddenFor(model => model.swupdatedbyinterno)
        @Html.HiddenFor(model => model.Longitud_Total)

        @Html.HiddenFor(model => model.Procedencia_Pinfor)
        @Html.HiddenFor(model => model.Procedencia_Pinpep)
        @Html.HiddenFor(model => model.Procedencia_Probosque)
        @Html.HiddenFor(model => model.Procedencia_AnioInicial)
        @Html.HiddenFor(model => model.Procedencia_AnioFinal)


        <table class="table table-condensed">
            <tr>
                <td></td>
