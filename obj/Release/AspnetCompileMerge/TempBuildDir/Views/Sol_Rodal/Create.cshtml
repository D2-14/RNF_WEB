@*@using RNF_Web.Models;
    @using System.Data.SqlClient;
    @model RNF_Web.Models.Tbl_Sol_Rodal

    @{

        db_RNFEntities db = new db_RNFEntities();

        ViewBag.Title = "Create";

        Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(Session[Constants.session_Solicitud]);


        int intSubCategoria = db.Tbl_Sol_Solicitud_Sub_Categoria.Where(Obj => Obj.Categoria_id == tbl_sol_solicitud.Categoria_id && Obj.Sub_Categoria_id == tbl_sol_solicitud.Sub_Categoria_id && (Obj.Descripcion.Contains("linea") || Obj.Descripcion.Contains("línea"))).Count();
        int intSubSubCategoria = db.Tbl_Sol_Solicitud_Sub_Sub_Categoria.Where(Obj => Obj.Categoria_id == tbl_sol_solicitud.Categoria_id && Obj.Sub_Categoria_id == tbl_sol_solicitud.Sub_Categoria_id && Obj.Sub_Sub_Categoria_id == tbl_sol_solicitud.Sub_Sub_Categoria_id && (Obj.Descripcion.Contains("linea") || Obj.Descripcion.Contains("línea"))).Count();

        if ((intSubCategoria > 0) || (intSubSubCategoria > 0))
        {
            ViewBag.ArbolesEnLinea = 1;
        }
        else
        {
            ViewBag.ArbolesEnLinea = 0;
        }


        try
        {
            if (db.Tbl_Sol_Solicitud_Categoria.Where(Cat => Cat.Categoria_id == tbl_sol_solicitud.Categoria_id && Cat.Descripcion.Contains("agroforestales")).Count() > 0)
            {
                ViewBag.Agroforestal = 1;

            }
            else
            {
                ViewBag.Agroforestal = 0;

            }

        }
        catch
        {
            ViewBag.Agroforestal = 0;
        }

    }

    <script src="~/Scripts/jquery-3.6.0.js"></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.12.1.js"></script>

    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>



    <script>
        $(document).ready(function () {

            const tmArea_SIGAP = document.querySelector('#Area_SIGAP');
            const tmNo_Sigap = document.querySelector('#No_Sigap');

            if (tmArea_SIGAP.checked) {
                var TdHiddeA = document.getElementById("No_Sigap");
                TdHiddeA.checked = false
            }
            else {
                var TdHiddeA = document.getElementById("No_Sigap");
                TdHiddeA.checked = true

            }

            const Procedencia_Pinpep = document.querySelector('#Procedencia_Pinpep');
            const Procedencia_Probosque = document.querySelector('#Procedencia_Probosque');
            const Procedencia_Pinfor = document.querySelector('#Procedencia_Pinfor');
            const ShowOrHide = document.getElementById("Procedencia");


            $(document).on('change', '#Procedencia_Pinpep', function () {
                if (Procedencia_Pinpep.checked) {
                    Procedencia_Probosque.checked = false;
                    Procedencia_Pinfor.checked = false;
                }
            });


            $(document).on('change', '#Procedencia_Probosque', function () {
                if (Procedencia_Probosque.checked) {
                    Procedencia_Pinpep.checked = false;
                    Procedencia_Pinfor.checked = false;
                }
            });

            $(document).on('change', '#Procedencia_Pinfor', function () {
                if (Procedencia_Pinfor.checked) {
                    Procedencia_Probosque.checked = false;
                    Procedencia_Pinpep.checked = false;
                }
            });







            $(document).on('change', '#Colecta_De_Datos_X_Censo', function () {
                const Colecta_De_Datos_X_Censo = document.querySelector('#Colecta_De_Datos_X_Censo');
                if (Colecta_De_Datos_X_Censo.checked) {
                    document.querySelector('#Colecta_De_Datos_X_Muestreo').checked = false;
                    var TdHiddeA = document.getElementById("DatosMuestreo");
                    TdHiddeA.style.display = "none";

                }
                else {
                    document.querySelector('#Colecta_De_Datos_X_Muestreo').checked = true;
                    var TdHiddeA = document.getElementById("DatosMuestreo");
                    TdHiddeA.style.display = "block";
                }

            });

            $(document).on('change', '#Colecta_De_Datos_X_Muestreo', function () {
                const Colecta_De_Datos_X_Muestreo = document.querySelector('#Colecta_De_Datos_X_Muestreo');
                if (Colecta_De_Datos_X_Muestreo.checked) {
                    document.querySelector('#Colecta_De_Datos_X_Censo').checked = false;
                    var TdHiddeA = document.getElementById("DatosMuestreo");
                    TdHiddeA.style.display = "block";

                }
                else {
                    document.querySelector('#Colecta_De_Datos_X_Censo').checked = true;
                    var TdHiddeA = document.getElementById("DatosMuestreo");
                    TdHiddeA.style.display = "none";
                }


            });




            $(document).on('change', '#Area_SIGAP', function () {
                const AreaSIGAP = document.querySelector('#Area_SIGAP');
                if (AreaSIGAP.checked) {
                    document.querySelector('#No_Sigap').checked = false;
                    var TdHiddeA = document.getElementById("CategoriaSIGAP");
                    TdHiddeA.style.display = "block";
                }
                else {
                    document.querySelector('#No_Sigap').checked = true;
                    var TdHiddeA = document.getElementById("CategoriaSIGAP");
                    TdHiddeA.style.display = "none";
                }


            });

            $(document).on('change', '#No_Sigap', function () {
                const NoAreaSIGAP = document.querySelector('#No_Sigap');
                if (NoAreaSIGAP.checked) {
                    document.querySelector('#Area_SIGAP').checked = false;
                    var TdHiddeA = document.getElementById("CategoriaSIGAP");
                    TdHiddeA.style.display = "none";
                }
                else {
                    document.querySelector('#Area_SIGAP').checked = true;
                    document.querySelector('#No_Sigap').checked = false;
                    var TdHiddeA = document.getElementById("CategoriaSIGAP");
                    TdHiddeA.style.display = "block";
                }

            });



        });

    </script>



    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()


    <div class="container">
         <div class="titulo-dos">
            <h3>
                @Html.Raw(Constants.Titulo_Rodal_Linea)
