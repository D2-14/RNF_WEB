                        @Html.EditorFor(model => model.Rodal_Id, new { htmlAttributes = new { disabled = "disabled", @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Rodal_Id, "", new { @class = "text-danger" })
                    </div>
                </td>
                <td>
                    @Html.LabelFor(model => model.Tipo_de_Area, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-10">
                        @Html.DropDownList("Tipo_de_Area", null, htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.Tipo_de_Area, "", new { @class = "text-danger" })
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    @Html.LabelFor(model => model.AreaTotal, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.AreaTotal, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.AreaTotal, "", new { @class = "text-danger" })
                    </div>
                </td>
                <td>
                    @if (ViewBag.ArbolesEnLinea == 1)
                    {
                        @Html.LabelFor(model => model.Longitud_Total, "Longitud total", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Longitud_Total, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Longitud_Total, "", new { @class = "text-danger" })
                        </div>
                    }
                    else
                    {
                        @Html.HiddenFor(model => model.Longitud_Total);
                    }
                </td>
            </tr>
            <tr>
                <td colspan="3"><hr /></td>
            </tr>
            <tr>
                <td>
                    @Html.LabelFor(model => model.Colecta_De_Datos_X_Censo, htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-10">
                        <div class="checkbox">
                            @Html.EditorFor(model => model.Colecta_De_Datos_X_Censo)
                            @Html.ValidationMessageFor(model => model.Colecta_De_Datos_X_Censo, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </td>
                <td>
                    @Html.LabelFor(model => model.Colecta_De_Datos_X_Muestreo, htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-10">
                        <div class="checkbox">
                            @Html.EditorFor(model => model.Colecta_De_Datos_X_Muestreo)
                            @Html.ValidationMessageFor(model => model.Colecta_De_Datos_X_Muestreo, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <br />
                </td>
            </tr>
            <tr>
                <td>
                </td>
                <td id="DatosMuestreo" style="display:none">
                    @Html.LabelFor(model => model.Colecta_De_Datos_X_Muestreo_No_Parcelas, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Colecta_De_Datos_X_Muestreo_No_Parcelas, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Colecta_De_Datos_X_Muestreo_No_Parcelas, "", new { @class = "text-danger" })
                    </div>
                    <br />
                    @Html.LabelFor(model => model.Colecta_De_Datos_X_Muestreo_Area_Parcelas, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Colecta_De_Datos_X_Muestreo_Area_Parcelas, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Colecta_De_Datos_X_Muestreo_Area_Parcelas, "", new { @class = "text-danger" })
                    </div>
                </td>
            </tr>

            <tr>
                <td colspan="3"><hr /></td>
            </tr>

            <tr>

                <td colspan="2">
                    @Html.LabelFor(model => model.Area_SIGAP, htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-10">
                        <div class="checkbox">
                            SI
                            @Html.EditorFor(model => model.Area_SIGAP)
                            @Html.ValidationMessageFor(model => model.Area_SIGAP, "", new { @class = "text-danger" })
                            NO
                            <input type="checkbox" id="No_Sigap" name="No_Sigap" value="No_Sigap">
                        </div>
                    </div>

                </td>

            </tr>
            <tr>
                <td></td>
                <td id="CategoriaSIGAP" style="display:none">
                    @Html.LabelFor(model => model.CategoriaSIGAP_Id, "Categoría SIGAP", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-10">
                        @Html.DropDownList("CategoriaSIGAP_Id", null, htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.CategoriaSIGAP_Id, "", new { @class = "text-danger" })
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="3"><hr /></td>
            </tr>

            <tr>
                <td></td>
                <td>
                    @if (ViewBag.Agroforestal == 1)
                    {
                        @Html.LabelFor(model => model.CultivoSAF_Id, "Tipo de Cultivo SAF", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-10">
                            @Html.DropDownList("CultivoSAF_Id", null, htmlAttributes: new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.CultivoSAF_Id, "", new { @class = "text-danger" })
