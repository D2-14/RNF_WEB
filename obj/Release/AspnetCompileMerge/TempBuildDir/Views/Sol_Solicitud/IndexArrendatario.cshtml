@model IEnumerable<RNF_Web.Models.fc_Sol_Sel_ListadoDeArrendatario_Result>
@using RNF_Web.Models;
@using System.Data.SqlClient;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}

@{
    db_RNFEntities db = new db_RNFEntities();
    Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(Session[Constants.session_Solicitud]);

    ViewBag.Estado = tbl_sol_solicitud.Estado_id;

    ViewBag.PropietarioJuridico = db.Tbl_Sol_ArrendatarioPersonaJuridica.Where(obj => obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id && obj.Estado_id == true).Count();


}

<script>


    $(document).on('change', '#PersoneriaArrendatario', function () {

        var PersoneriaArrendatario = $('#PersoneriaArrendatario').val();

        if (PersoneriaArrendatario == 1)  /*individual*/ {
            var TdToShowA = document.getElementById("ClickYoArrendatario");
            TdToShowA.innerText = "<< Click aquí para AGREGARME como arrendatario >>";
            TdToShowA.style = "color:white; "
            TdToShowA.hidden = false;

            var TdToShowA = document.getElementById("ClickArrendatario");
            TdToShowA.innerText = "<< Click aquí para agregar un arrendatario >>";
            TdToShowA.style = "color:white; "
            TdToShowA.hidden = false;

            document.getElementById("imgAddme").src = "/Content/icons/addme_II.png";
            document.getElementById("imgPropietario").style.visibility = 'Visible';
        }
        else {
            var TdToShowA = document.getElementById("ClickArrendatario");
            TdToShowA.innerText = "Click en la imagen para agregarme como arrendatario";
            TdToShowA.style = "color:black; "
            TdToShowA.hidden = true;


            var TdToShowA = document.getElementById("ClickYoArrendatario");
            TdToShowA.innerText = "Click aquí para agregar arrendatario jurídico";
            TdToShowA.style = "color:white; "

            document.getElementById("imgAddme").src = "/Content/icons/add-empresa.png";

            document.getElementById("imgPropietario").style.visibility = 'hidden';

        }



        function VerifAgregarme_Como_ArrendatarioRepresentante(solicitud, tipo) {
            var PersoneriaArrendatario = $('#PersoneriaArrendatario').val();

            if (PersoneriaArrendatario == 1) {
                Agregarme_Como_Arrendatario(solicitud, tipo)
            }
            else {
                Agregar_Arrendatario()
            }
        }


    }); // -----Fin de Change ddlDepartamento




</script>


<div class="container-fluid">
    <div class="row mt-2">
        <div class="titulo-dos">
            <h4>Datos del arrendatario(s)</h4>
        </div>
    </div>
    <br />
    @if ((ViewBag.Estado == 0) || (ViewBag.Estado == 4))
    {
        <div class="row">
            <div class="col-md-6">
                @Html.Label("Seleccione tipo de arrendatario a agregar", new { @class = "control-label" })
                @Html.DropDownList("PersoneriaArrendatario", null, htmlAttributes: new { @class = "form-select" })
            </div>
            <div class="col">
                <div class="d-grid gap-2">
                    <button class="btn-next-ic" onclick="Agregarme_Como_Arrendatario('@ViewBag.Solicitud_id', '1'); return false;" id="ClickYoArrendatario">
                        <i class="fa in fa-plus-circle" aria-hidden="true"></i><br />Agregarme como arrendatario
                    </button>
                </div>
            </div>
            <div class="col">
                <div class="d-grid gap-2">
                    <button class="btn-next-ic" onclick="Agregar_Arrendatario(); return false;" id="ClickArrendatario">
                        <i class="fa in fa-users" aria-hidden="true"></i><br />Agregar otro
                    </button>
                </div>

            </div>
        </div>
    }

    <div class="row">
        <div class="col">
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th scope="col">@Html.DisplayNameFor(model => model.Personeria)</th>
                            <th scope="col">@Html.DisplayNameFor(model => model.Nombre)</th>
                            <th scope="col">Documento</th>
                            <th scope="col">Editar</th>
                            <th scope="col">Eliminar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Personeria)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Nombre)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.No_NIT)
                                </td>

                                @if (item.Personeria_id == 1)
                                {
                                    <td>
                                        @if ((ViewBag.Estado == 0) || (ViewBag.Estado == 4))
                                        {
                                            <div class="div-icons-table" onclick="Editar_ArrendatarioIndividual(@item.Solicitud_id, @item.PersonaJuridica_Id)">
                                                <i class="fa in fa-edit" aria-hidden="true"></i>
                                            </div>
                                        }
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        @if ((ViewBag.Estado == 0) || (ViewBag.Estado == 4))
                                        {
                                            <div class="div-icons-table" onclick="Editar_ArrendatarioJuridico(@item.Solicitud_id, @item.PersonaJuridica_Id)">
                                                <i class="fa in fa-edit" aria-hidden="true"></i>
                                            </div>
                                        }
                                    </td>
                                }


                                @if (item.Personeria_id == 1)
                                {
                                    <td>
                                        @if ((ViewBag.Estado == 0) || (ViewBag.Estado == 4))
                                        {
                                            <div class="div-icons-table" onclick="Eliminar_ArrendatarioIndividual(@item.Solicitud_id, @item.PersonaJuridica_Id)">
                                                <i class="fa in fa-trash-o" aria-hidden="true"></i>
                                            </div>
                                        }
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        @if ((ViewBag.Estado == 0) || (ViewBag.Estado == 4))
                                        {
                                            <div class="div-icons-table" onclick="Eliminar_ArrendatarioJuridico(@item.Solicitud_id, @item.PersonaJuridica_Id)">
                                                <i class="fa in fa-trash-o" aria-hidden="true"></i>
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

