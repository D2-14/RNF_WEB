@using RNF_Web.Models;
@{
    Layout = "~/Views/Shared/_LayoutMoreSimple.cshtml";
    Layout = "~/Views/Shared/_LayoutMenu.cshtml";
    Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    string actionName = HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString();
}
@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}

<script>
    function convertirGRJunto() {
        var LatLon = document.getElementById("LatLon").value;
        if ((LatLon == null) || (LatLon.trim() == "")) {
            alert("La información proporcionada no es válida");
            return;
        } else {
            var LatLonSplitted = LatLon.split(",")
            var countLength = LatLonSplitted.length;
            if ((countLength > 2) || (countLength < 2)) {
                alert("Debe colocar Latitud y Longitud separados por coma para poder realizar la conversión");
                return;
            } else {
                var Coordenadas = LatLon;
                var Latitud = LatLonSplitted[0].trim();
                var Longitud = LatLonSplitted[1].trim();

                if (isNaN(Latitud)) {
                    alert("Latitud no es un número");
                    return;
                }
                if (isNaN(Longitud)) {
                    alert("Longitud no es un número");
                    return;
                }

                var data = {
                    Coordenadas: Coordenadas,
                    Latitud: Latitud,
                    Longitud: Longitud
                };
                var url = "@Url.Action("ConvertGRJunto", @controllerName)";

                $.post(url, data).done(function (jsonRespuesta) {
                    var oJSON = jsonRespuesta;
                    var Result = oJSON.Result;
                    var Mensaje = oJSON.Mensaje;

                    if (Result == 1) {
                        var Coordenadas = oJSON.Coordenadas;
                        console.log(Coordenadas);
                        document.getElementById("Latitud").value = Coordenadas.GR_Latitud;
                        document.getElementById("Longitud").value = Coordenadas.GR_Longitud;
                        document.getElementById("GTMX").value = Coordenadas.GTM_X;
                        document.getElementById("GTMY").value = Coordenadas.GTM_Y;
                    } else {
                        alert(Mensaje);
                    }

                }).fail(function (jsonRespuesta) {
                    alert("Hubo un errror");
                });

            }
        }
    }

    function convertirGR() {
        var Latitud = document.getElementById("Latitud").value;
        var Longitud = document.getElementById("Longitud").value;
        if (((Latitud == null) || (Latitud.trim() == "")) || ((Longitud == null) || (Longitud.trim() == ""))) {
            alert("La información proporcionada no es válida");
            return;
        } else {

            if (isNaN(Latitud)) {
                alert("Latitud no es un número");
                return;
            }
            if (isNaN(Longitud)) {
                alert("Longitud no es un número");
                return;
            }

            document.getElementById("LatLon").value = Latitud + ', ' + Longitud;

            var data = {
                Latitud: Latitud,
                Longitud: Longitud
            };
            var url = "@Url.Action("ConvertGR", @controllerName)";

            $.post(url, data).done(function (jsonRespuesta) {
                var oJSON = jsonRespuesta;
                var Result = oJSON.Result;
                var Mensaje = oJSON.Mensaje;

                if (Result == 1) {
                    var Coordenadas = oJSON.Coordenadas;
                    console.log(Coordenadas);
                    document.getElementById("GTMX").value = Coordenadas.GTM_X;
                    document.getElementById("GTMY").value = Coordenadas.GTM_Y;
                } else {
                    alert(Mensaje);
                }

            }).fail(function (jsonRespuesta) {
                alert("Hubo un errror");
            });

        }
    }

    function convertirGTM() {
        var GTMX = document.getElementById("GTMX").value;
        var GTMY = document.getElementById("GTMY").value;
        if (((GTMY == null) || (GTMY.trim() == "")) || ((GTMX == null) || (GTMX.trim() == ""))) {
            alert("La información proporcionada no es válida");
            return;
        } else {

            if (isNaN(GTMY)) {
                alert("GTMY no es un número");
                return;
            }
            if (isNaN(GTMX)) {
                alert("GTMX no es un número");
                return;
            }

            var data = {
                GTMY: GTMY,
                GTMX: GTMX
            };
            var url = "@Url.Action("ConvertGTM", @controllerName)";

            $.post(url, data).done(function (jsonRespuesta) {
                var oJSON = jsonRespuesta;
                var Result = oJSON.Result;
                var Mensaje = oJSON.Mensaje;

                if (Result == 1) {
                    var Coordenadas = oJSON.Coordenadas;
                    console.log(Coordenadas);
                    document.getElementById("Longitud").value = Coordenadas.GR_Longitud;
                    document.getElementById("Latitud").value = Coordenadas.GR_Latitud;
                    document.getElementById("LatLon").value = Coordenadas.GR_Latitud + ', ' + Coordenadas.GR_Longitud;
                } else {
                    alert(Mensaje);
                }

            }).fail(function (jsonRespuesta) {
                alert("Hubo un errror");
            });

        }
    }

    function copiarTexto(input, label) {
        var copyText = document.getElementById(input);
        navigator.clipboard.writeText(copyText.value);
        document.getElementById(label).innerHTML = "Texto copiado";
    }

    function copiarGTMX() {
        copiarTexto("GTMX", "Lbl_GTMX");
    }

    function copiarGTMY() {
        copiarTexto("GTMY", "Lbl_GTMY");
    }

    function copiarLatitud() {
        copiarTexto("Latitud", "Lbl_Latitud");
    }

    function copiarLongitud() {
        copiarTexto("Longitud", "Lbl_Longitud");
    }

    function copiarLatLon() {
        copiarTexto("LatLon", "Lbl_LatLon");
    }

    function limpiar() {
        document.getElementById("Lbl_GTMX").innerHTML = "";
        document.getElementById("Lbl_GTMY").innerHTML = "";
        document.getElementById("Lbl_Latitud").innerHTML = "";
        document.getElementById("Lbl_Longitud").innerHTML = "";
        document.getElementById("Lbl_LatLon").innerHTML = "";
        document.getElementById("GTMX").value = "";
        document.getElementById("GTMY").value = "";
        document.getElementById("Latitud").value = "";
        document.getElementById("Longitud").value = "";
        document.getElementById("LatLon").value = "";
    }

</script>

<div class="container-fluid" id="div_ConversorGTM">
    <p>Indique sus coordenadas GTMY y GTMX para obtener sus coordenadas en Latitud y Longitud</p>
    <table class="table table-striped table-hover">
        <tr>
            <th>
                <p>GTM Y</p>
            </th>
            <th>
                <p>GTM X</p>
            </th>
            <th>
            </th>
        </tr>
        <tr>
            <td>
                <input type="text" name="GTMX" id="GTMX" class="form-control" placeholder="Ej. 507198.196313614000" />
                <label style="color:red;" id="Lbl_GTMX"></label>
            </td>
            <td>
                <input type="text" name="GTMY" id="GTMY" class="form-control" placeholder="Ej. 1624266.828772790000" />
                <label style="color:red;" id="Lbl_GTMY"></label>
            </td>
            <td>
                <input type="button" value="Convertir" class="btn btn-primary" onclick="convertirGTM()" />
                <input type="button" value="Limpiar" class="btn btn-primary" onclick="limpiar()" />
            </td>
        </tr>
        <tr>
            <th colspan="3">
                <p>Latitud y Longitud juntas <small>(para copiar texto de un clic a la coordenada)</small></p>
            </th>
        </tr>
        <tr>
            <td colspan="2">
                <input type="text" name="LatLon" id="LatLon" class="form-control" readonly onclick="copiarLatLon()" />
                <label style="color:red;" id="Lbl_LatLon"></label>
            </td>
            <td>
            </td>
        </tr>
        <tr>
            <th>
                <p>Latitud <small>(para copiar texto de un clic a la coordenada)</small></p>
            </th>
            <th>
                <p>Longitud <small>(para copiar texto de un clic a la coordenada)</small></p>
            </th>
            <th>
            </th>
        </tr>
        <tr>
            <td>
                <input type="number" name="Longitud" id="Longitud" class="form-control" readonly onclick="copiarLongitud()" />
                <label style="color:red;" id="Lbl_Longitud"></label>
            </td>
            <td>
                <input type="number" name="Latitud" id="Latitud" class="form-control" readonly onclick="copiarLatitud()" />
                <label style="color:red;" id="Lbl_Latitud"></label>
            </td>
            <td>
            </td>
        </tr>
    </table>
</div>

