<div id="section_ExcelRodal">
    @model System.Data.DataTable
    @using System.Data;
    @using RNF_Web.Models;
    @using System.Data.SqlClient;

    @if (Constants.VisualizarInformacionDesarrollo == 1)
    {
        <h3>@this.Url.Action()</h3>
    }


    @{

        db_RNFEntities db = new db_RNFEntities();
        string No_Registro = ViewBag.No_Registro;
        Tbl_RNF_Registro tbl_RNF_Registro = db.Tbl_RNF_Registro.Where(Obj => Obj.No_Registro == No_Registro).FirstOrDefault();

        EdicionRNFGrants objRNFGrants = (EdicionRNFGrants)Session[Constants.session_EdicionRNFGrants];

        ViewBag.Title = "   Carga archivo de polígonos de descuento";
        Usuario objUs = (Usuario)Session["User"];
        bool boolEsInterno = false;
        if (objUs.EsInterno == 1)
        {
            boolEsInterno = true;
        }

    }


    <script src="~/Scripts/jquery-3.6.0.js"></script>
    <link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-ui-1.12.1.js"></script>

    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <div style='height: 30px; width: 100%; background-color: green; color: white; '>
        <h4 class="title">&nbsp;&nbsp;&nbsp;@ViewBag.Title</h4>
    </div>

    <span id="result_CargaDescuento"></span>
    @using (Html.BeginForm("UploadExcelDescuento", "RNF_Rodal", null, FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary()

        <div class="form-group">
            <div class="col-sm-6">
                <form id="uploader">
                    @*<h1>@TempData["MensajeFileDesc"]</h1>*@

                    @if (objRNFGrants.Editar)
                    {
                        <table>
                            <tr>
                                <td>
                                    <label>
                                        @*<img src="~/Content/icons/btnSubirArchivo.png" width="100%" height="auto" id="upfile1" style="cursor:pointer" />*@

                                        <label for="uploadDescuento" id="upfileuploadDescuento" class="btn-next-ic">&nbsp;&nbsp;&nbsp;&nbsp;Seleccionar archivo&nbsp;&nbsp;&nbsp;&nbsp;</label>

                                        <input type="file" id="uploadDescuento" name="uploadDescuento" style="display:none">
                                    </label>
                                </td>
                                <td>
                                    <input type="button" id="btsubirDescuento" class="btn btn-primary btn-outlined" width="100%"
                                           value="Subir archivo" disabled />
                                    <br />
                                    <span id="nombre_ArchivoDescuento"></span>

                                </td>
                                <td>
                                    &nbsp;&nbsp;&nbsp;&nbsp;
                                </td>
                                <td>
                                    <a href="~/Content/Machotes/AreaDeDescuento_En_Blanco_Interno.xlsx">Archivo para carga de coordenadas</a>
                                </td>
                                <td>
                                    &nbsp;&nbsp;&nbsp;&nbsp;
                                </td>
                                <td>
                                    <a href="~/Content/Machotes/AreaDeDescuento_Ejemplo_Interno.xlsx">Archivo ejemplo</a>
                                </td>
                            </tr>
                        </table>
                    }
                    <br /><br />

                </form>
            </div>
            <div class="col-sm-3"></div>
        </div>

    }



</div>

<script>

    $(document).ready(function () {
    });
    var ArchivoDescuento = ($("#uploadDescuento"))[0].files[0];

    $(function () {
        $("#uploadDescuento").change(function () {
            ArchivoDescuento = ($("#uploadDescuento"))[0].files[0];
            console.log(ArchivoDescuento);
            document.getElementById("nombre_ArchivoDescuento").innerHTML = ArchivoDescuento.name;
            var botonSubir = document.getElementById("btsubirDescuento");
            if ((ArchivoDescuento != "") && (ArchivoDescuento != null)) {
                botonSubir.classList.add("btn-primary");
                botonSubir.disabled = false;
            } else {
                botonSubir.classList.remove("btn-primary");
                botonSubir.disabled = true;
            }
        })


        $("#btsubirDescuento").click(function () {

            setTimeout(function () {

                ArchivoDescuento = ($("#uploadDescuento"))[0].files[0];
                console.log(ArchivoDescuento);

                var formData = new FormData();
                formData.append("No_Registro", '@tbl_RNF_Registro.No_Registro');


                function adjuntarImagenDescuento() {
                    formData.append("upload", ArchivoDescuento);
                    $.ajax({
                        url: "UploadExcelRodalesDescuento",
                        type: "POST",
                        data: formData,
                        contentType: false,
                        processData: false,
                        async: false,
                        success: function (data) {
                            var oJSON = JSON.parse(data);
                            var StrMensaje = oJSON.StrMensaje;
                            var CodResult = oJSON.CodResult;
                            console.log(oJSON);
                            var color = "#000000";
                            if (CodResult == 1) {
                                color = "#27FF00";
                            } else {
                                color = "#FF0000";
                            }
                            document.getElementById("result_CargaDescuento").innerHTML = StrMensaje;
                            document.getElementById("result_CargaDescuento").style.color = color;
                            $("#uploadDescuento").prop("value", "");
                            document.getElementById("nombre_ArchivoDescuento").innerHTML = "";
                            var botonSubir = document.getElementById("btsubirDescuento");
                            botonSubir.classList.remove("btn-primary");
                            botonSubir.disabled = true;
                            setTimeout(function () {
                                document.getElementById("result_CargaDescuento").innerHTML = "";
                            }, 3000);
                            //location.reload();
                        },
                        error: function (data) {
                            //location.reload();
                        }
                    });

                }

                if (ArchivoDescuento != null) {
                    adjuntarImagenDescuento();
                } else {
                    alert("No se ha seleccionado ningún archivo");
                }


            }, 2000);



        })
    })

</script>
