@{

    ViewBag.Title = "   Actualización de datos del solicitante ";
    ViewBag.SubTitle = null;
    db_RNFEntities db = new db_RNFEntities();
    Tbl_RNF_Registro tbl_RNF_Registro = db.Tbl_RNF_Registro.Where(Obj => Obj.No_Registro == Model.No_Registro).FirstOrDefault();


    EdicionRNFGrants objRNFGrants = (EdicionRNFGrants)Session[Constants.session_EdicionRNFGrants];


    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    string Nombre_Div = "div_Sol_TecnicoProfesional_EditProfesional";
    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }
}

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}

<script>
    $(document).ready(function () {

        const constSubCategoria = "@tbl_RNF_Registro.Sub_Categoria_id";
        const constGrado_Academico_Profesional = document.querySelector('#Grado_Academico_Profesional');

        if ((constSubCategoria == 3) || (constSubCategoria == 4)) {
            var TdHiddeA = document.getElementById("DatosEspecificarCarreraINAB");
            TdHiddeA.style.display = "block";
        }
        else {
            DesactivarCategoriaINAB();
        }

        if (constGrado_Academico_Profesional.checked) {
            ActivarUniversidad();
        }

        const constPostGradoMateriaForestal = document.querySelector('#PostGradoMateriaForestal');

        if (PostGradoMateriaForestal.checked) {
            ActivarDatosPostGrado();
        }

        const constGrado_Academico_Tecnico = $("#Profesion_id :selected").text();

        if (constGrado_Academico_Tecnico.toUpperCase().includes("OTRA") == true) {
            var TdHiddeA = document.getElementById("DatosUniversidadEspecificar");
            TdHiddeA.style.display = "block";
        }
        else {
            var TdHiddeA = document.getElementById("DatosUniversidadEspecificar");
            TdHiddeA.style.display = "none";
        }



        function DesactivarUniversidad() {
            document.querySelector('#Grado_Academico_Tecnico').checked = true;
            document.querySelector('#Grado_Academico_Profesional').checked = false;
            document.querySelector('#PostGradoMateriaForestal').checked = false;

            document.querySelector('#Universidad').value = "";
            document.querySelector('#No_Colegiado').value = "";
            document.querySelector('#UniversidadEspecificarCarrera').value = "";
            document.querySelector('#PostGradoUniversidad').value = "";
            document.querySelector('#PostGradoEspecialidad').value = "";


            var TdHiddeA = document.getElementById("DatosUniversidad");
            TdHiddeA.style.display = "none";
            var TdHiddeB = document.getElementById("DatosPostgrado");
            TdHiddeB.style.display = "none";

            document.querySelector('#PostGradoEspecialidad').value = "";
            document.querySelector('#PostGradoUniversidad').value = "";

        }

        function ActivarDatosPostGrado() {
            var TdHiddeA = document.getElementById("DatosPostgrado");
            TdHiddeA.style.display = "block";

        }

        function DesactivarCategoriaINAB() {
            var TdHiddeA = document.getElementById("DatosEspecificarCarreraINAB");
            TdHiddeA.style.display = "none";
            /*  document.querySelector('#Diploma_INAB').value = "";*/
            document.querySelector('#No_De_Diploma').value = "";
        }

        function DesactivarDatosPostGrado() {
            var TdHiddeA = document.getElementById("DatosPostgrado");
            TdHiddeA.style.display = "none";

            document.querySelector('#PostGradoUniversidad').value = "";
            document.querySelector('#PostGradoEspecialidad').value = "";


        }

        function ActivarUniversidad() {
            document.querySelector('#Grado_Academico_Tecnico').checked = false;
            document.querySelector('#Grado_Academico_Profesional').checked = true;
            var TdHiddeA = document.getElementById("DatosUniversidad");
            TdHiddeA.style.display = "block";
        }

        function LlenarProfesion()
        {
            var Grado_Academico_Tecnico = document.querySelector('#Grado_Academico_Tecnico');
            var Grado_Academico_Profesional = document.querySelector('#Grado_Academico_Profesional');

            var url = "@Url.Action("GetProfesion", "RNF_TecnicoProfesional")";
            var data = {
                No_Registro: '@tbl_RNF_Registro.No_Registro',
                GAT: Grado_Academico_Tecnico.checked,
                GAP: Grado_Academico_Profesional.checked,
            };

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#Profesion_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, profesion) {
                    select.append($('<option/>', {
                        value: profesion.Value,
                        text: profesion.Text
                    }));

                });
            }).fail(function (error) {
                alert(error);
            });
        }

        $(document).on('change', '#Grado_Academico_Tecnico', function () {
            var Grado_Academico_Tecnico = document.querySelector('#Grado_Academico_Tecnico');

            if (Grado_Academico_Tecnico.checked) {
                DesactivarUniversidad();
            }
            else {
                ActivarUniversidad();
            }
            LlenarProfesion();
        });

        $(document).on('change', '#Grado_Academico_Profesional', function () {
            var Grado_Academico_Profesional = document.querySelector('#Grado_Academico_Profesional');

            if (Grado_Academico_Profesional.checked) {
                ActivarUniversidad();
            }
            else {
                DesactivarUniversidad();
            }

            LlenarProfesion();
        });

        $(document).on('change', '#Profesion_id', function () {
            var Grado_Academico_Tecnico = $("#Profesion_id :selected").text();

            if (Grado_Academico_Tecnico.toUpperCase().includes("OTRA") == true) {
                var TdHiddeA = document.getElementById("DatosUniversidadEspecificar");
                TdHiddeA.style.display = "block";
            }
            else {
                var TdHiddeA = document.getElementById("DatosUniversidadEspecificar");
                TdHiddeA.style.display = "none";
            }
        });

        $(document).on('change', '#PostGradoMateriaForestal', function () {
            var PostGradoMateriaForestal = document.querySelector('#PostGradoMateriaForestal');
            if (PostGradoMateriaForestal.checked) {
                ActivarDatosPostGrado();
            }
            else {
                DesactivarDatosPostGrado();
            }
        });


    });

            $(document).on('change', '#DepartamentoDPI_id', function () {

            var url = "@Url.Action("GetMunicipios", "Sol_Solicitud")";
            var Departamento = $('#DepartamentoDPI_id').val();
            var data = { Departamento: Departamento};

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#MunicipioDPI_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text: municipio.Text
                    }));

                });


            }).fail(manejarErrorAjax).always(function () {
            });


        }); // -----Fin de Change ddlDepartamento


</script>

