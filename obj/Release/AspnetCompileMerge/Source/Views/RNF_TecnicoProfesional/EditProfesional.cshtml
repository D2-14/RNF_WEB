                <div class="col-sm-12 col-md-12">
                    <div class="form-group">
                        @Html.LabelFor(model => model.PostGradoEspecialidad, "Especialidad del post-grado", htmlAttributes: new { @class = "control-label col-md-12" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.PostGradoEspecialidad, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.PostGradoEspecialidad, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <table class="model-state">
        @foreach (var item in ViewContext.ViewData.ModelState)
        {
            if (item.Value.Errors.Any())
            {
                <tr>
                    <td> <h1 style="background-color:powderblue;">@(string.Join("; ", item.Value.Errors.Select(x => x.ErrorMessage)))</h1></td>
                </tr>
            }
        }
    </table>

    if (ViewBag.Mensaje != "")
    {
        <h1 style="background-color:powderblue;">@ViewBag.Mensaje</h1>
        <p style="color: blue;">@ViewBag.Mensaje_II</p>
    }

    <br />
    <div class="form-group">

        <h3 style="background-color:powderblue;">@TempData["Mensaje"]</h3>


            <div class="col-sm-12 col-md-12" align="right">
                <input type="submit" value="Guardar cambios" class="btn btn-success" />
            </div>


    </div>
}



