@using RNF_Web.Models;
@using System.Data.SqlClient;

<div id="contenedor_carga">
    <div id="carga"></div>
</div>

<script>
    function download(filename, NombreDescarga) {

        var element = document.createElement('a');
        element.setAttribute('href', filename);
        element.setAttribute('download', NombreDescarga);
        document.body.appendChild(element);
        element.click();
        //document.body.removeChild(element);
    }
</script>

<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="icon" href="@Url.Content("../favicon.png")" />
    <link href="/Content/MenuColaborador.css" rel="stylesheet" />
    <link href="/Content/bootstrap.css" rel="stylesheet" />
    <script src="/Scripts/jquery-3.6.0.js"></script>


    <style>
        #contenedor_carga {
            background-color: rgba(255,255,255,0.1);
            height: 100%;
            width: 100%;
            position: fixed;
            -webkit-transition: all 1s ease;
            -o-transition: all 1s ease;
            transition: all 1s ease;
            z-index: 10000;
        }

        #carga {
            border: 15px solid #FFFFFF;
            border-top-color: #b6ff00;
            border-top-style: dotted;
            height: 100px;
            width: 100px;
            border-radius: 100%;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            margin: auto;
            -webkit-animation: girar 1.5s linear infinite;
            -o-animation: girar 1.5s linear infinite;
            animation: girar 1.5s linear infinite;
        }

        @@keyframes girar {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }



        .modal-dialog {
            animation-direction: reverse;
            animation: show 1s .5s backwards;
            transform-style: preserve-3d;
            transition: all 0.5s linear;
        }

            .modal-dialog:target .modal-content {
                animation: show 1s .5s backwards;
                transform-style: preserve-3d;
                transition: all 0.5s linear;
            }

        @@keyframes show {
            0% {
                transform: rotateY(-180deg);
            }

            100% {
                transform: rotateY(0deg);
            }
        }
    </style>
</head>

@{
    Usuario objUs = new Usuario();
    objUs.intUsuario_id = 0;

    RespuestaValidaSesion objSesion = new RespuestaValidaSesion(Session[Constants.session_User]);
    if (!objSesion.getBlSession())
    {
        ViewBag.NombreUsuario = "";
        ViewBag.Puesto = "";
    }
    else
    {
        db_RNFEntities db = new db_RNFEntities();

        objUs = (Usuario)Session["User"];
        ViewBag.NombreUsuario = objUs.strNombre_Usuario;

        Tbl_Seg_UsuarioRol UsuarioRol = db.Tbl_Seg_UsuarioRol.Where(Obj => Obj.Usuario_id == objUs.intUsuario_id && Obj.Estado_id == 1).FirstOrDefault();

        if (UsuarioRol != null)
        {
            Tbl_Seg_Rol rol = db.Tbl_Seg_Rol.Find(UsuarioRol.Rol_id);
            ViewBag.Puesto = rol.Nombre;

        }
        else
        {
            ViewBag.Puesto = "Colaborador";
        }
    }

}

<body>


    <input type="hidden" value="/Archivos_ConFirmaElectronica/" style="display:none" />
    @Html.Action("renderMenuHTML", "Menu")
    <div>
        <table class="table">
            <tr>
                <td align="right">
                    <label style="font-size:20px; color:forestgreen; font-weight:normal "> Bienvenido: &nbsp;&nbsp; @ViewBag.Puesto  &nbsp;&nbsp;   @ViewBag.NombreUsuario </label>
                </td>
                <td>&nbsp;&nbsp;</td>
            </tr>
        </table>
    </div>

    <div class="container-fluid mt-5 mb-5">
