<script>
        $(document).ready(function () {
            var div_EspeciesForestales_Probosque = document.getElementById("div_EspeciesForestales_Probosque");
            var div_EspeciesForestales_PinpepOld = document.getElementById("div_EspeciesForestales_PinpepOld");
            var div_EspeciesProteger_PinpepOld = document.getElementById("div_EspeciesProteger_PinpepOld");
            var div_Secorf_Rodal = document.getElementById("div_Secorf_Rodal");
            var div_EspeciesForestales_Secorf = document.getElementById("div_EspeciesForestales_Secorf");

            if (div_EspeciesForestales_Probosque) {
                $('#div_EspeciesForestales_Probosque').load('/Sol_Finca_ProcedenciaExterna/Probosque_EspeciesForestales?Solicitud_id=@tbl_sol_solicitud.Solicitud_id&firma=@tbl_sol_solicitud.Guid_id');
            }
            if (div_EspeciesForestales_PinpepOld) {
                $('#div_EspeciesForestales_PinpepOld').load('/Sol_Finca_ProcedenciaExterna/PinpepOld_EspeciesForestales?Solicitud_id=@tbl_sol_solicitud.Solicitud_id&firma=@tbl_sol_solicitud.Guid_id');
            }
            if (div_EspeciesProteger_PinpepOld) {
                $('#div_EspeciesProteger_PinpepOld').load('/Sol_Finca_ProcedenciaExterna/PinpepOld_EspeciesProteger?Solicitud_id=@tbl_sol_solicitud.Solicitud_id&firma=@tbl_sol_solicitud.Guid_id');
            }
            if (div_Secorf_Rodal) {
                $('#div_Secorf_Rodal').load('/Sol_Finca_ProcedenciaExterna/Secorf_Rodal?Solicitud_id=@tbl_sol_solicitud.Solicitud_id&firma=@tbl_sol_solicitud.Guid_id');
            }
            if (div_EspeciesForestales_Secorf) {
                $('#div_EspeciesForestales_Secorf').load('/Sol_Finca_ProcedenciaExterna/Secorf_EspeciesForestales_Create?Solicitud_id=@tbl_sol_solicitud.Solicitud_id&firma=@tbl_sol_solicitud.Guid_id');
            }

        });
</script>

