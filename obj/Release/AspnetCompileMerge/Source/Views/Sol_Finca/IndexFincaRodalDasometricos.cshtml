@using RNF_Web.Models;
@using System.Data.SqlClient;


@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Url.Action("IndexFincaRodalDasometricos", "Sol_Finca")
}


@{

    db_RNFEntities db = new db_RNFEntities();

    Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(ViewBag.Solicitud_id);
    decimal solicitudtipo = tbl_sol_solicitud.SolicitudTipo_id - Math.Truncate(tbl_sol_solicitud.SolicitudTipo_id);

    ViewBag.SolicitudGuid = tbl_sol_solicitud.Guid_id;

    int Categoria_id = tbl_sol_solicitud.Categoria_id ?? 0;

    int intCategoriaPlantacion = db.Tbl_Sol_Solicitud_Categoria.Where(Obj => Obj.Descripcion.Contains("semilleras") && Obj.Categoria_id == tbl_sol_solicitud.Categoria_id).Count();

    int intCategoriaPlantacionesForestales = db.Tbl_Sol_Solicitud_Categoria.Where(Obj => Obj.Categoria_id == tbl_sol_solicitud.Categoria_id && (Obj.Descripcion.Contains("Plantaciones forestales") || Obj.Descripcion.Contains("Sistemas agroforestales") || Obj.Descripcion.Contains("Plantaciones de árboles frutales"))).Count();

    ViewBag.intCategoriaPlantacion = intCategoriaPlantacion;

    ViewBag.intCategoriaPlantacionesForestales = intCategoriaPlantacionesForestales;

    ViewBag.Estado = tbl_sol_solicitud.Estado_id;

    ViewBag.Categoria_id = Categoria_id;

    ViewBag.AreaTotalFincas = tbl_sol_solicitud.AreaTotalFincas ?? 0;

    ViewBag.AreaTotalFincasSegunFincas = db.Tbl_Sol_Finca.Where(Obj => Obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id).Sum(Obj => Obj.AreaTotal);

    ViewBag.intCantidadFincas = db.Tbl_Sol_Finca.Where(Obj => Obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id).Count();
    decimal resultante = tbl_sol_solicitud.SolicitudTipo_id - Math.Truncate(tbl_sol_solicitud.SolicitudTipo_id);

    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    string Nombre_Div1 = "div_Sol_Permisos_Sol_Finca_IndexFincaRodalDasometricos";
    string Nombre_Div2 = "div_Sol_Permisos_Sol_Finca_Region";
    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }
    fc_Gral_Sol_Configuracion_Result permisos = db.fc_Gral_Sol_Configuracion(tbl_sol_solicitud.Solicitud_id, controllerName, boolEsInterno).FirstOrDefault();
    fc_Gral_Sol_Configuracion_Result permisosRegion = db.fc_Gral_Sol_Configuracion(tbl_sol_solicitud.Solicitud_id, controllerName, boolEsInterno).FirstOrDefault();
}

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <div id="@Nombre_Div1"></div>
    <div id="@Nombre_Div2"></div>
}

<script>


    function visualizarPermisos(solicitudid, controllername, esinterno, nombrediv) {
        var solicitudId = solicitudid;
        var controllerName = controllername;
        var esInterno = esinterno;

        var mySolPermisos = document.getElementById(nombrediv);
        if (mySolPermisos) {
            $("#" + nombrediv).load("/Gral_SolicitudConfiguracion/PermisosRecibidos?Solicitud_id=" + solicitudId + "&controllerName=" + controllerName + "&EsInterno=" + esInterno);
        }

    }

    $(document).ready(function () {


        visualizarPermisos('@tbl_sol_solicitud.Solicitud_id', '@controllerName', '@objUs.EsInterno', '@Nombre_Div1');
        visualizarPermisos('@tbl_sol_solicitud.Solicitud_id', '@controllerName', '@objUs.EsInterno', '@Nombre_Div2');


        $(document).on('change', '#RegionFinca_id', function () {
            var url = "@Url.Action("GetSubRegion", "Sol_Solicitud")";
            var Region = $('#RegionFinca_id').val();
            var data = { Region: Region};
            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#SubRegionFinca_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text:  municipio.Text
                    }));

                });

            }).fail(manejarErrorAjax).always(function () {
            });


        }); // -----Fin de Change ddlRegion

    });

    $(document).on('change', '#SubRegionFinca_id', function () {
        refreshMunicipio()
    });




   function refreshMunicipio()
        {
            var url = "@Url.Action("GetMunicipiosRegion", "Sol_Solicitud")";
       var Departamento = $('#Notificacion_Departamento_id').val();
           var SubRegion = $('#SubRegionFinca_id').val();

            var data = { Departamento: Departamento, SubRegionId: SubRegion };

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#Notificacion_Municipio_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text: municipio.Text
                    }));

                });
            }).fail(manejarErrorAjax).always(function () {

            });

        }


    function actualizar()
    {
        var varRegionFinca_id = $('#RegionFinca_id').val();
        var varSubRegionFinca_id = $('#SubRegionFinca_id').val();

        var varNotificacion_Direccion = $('#Notificacion_Direccion').val();
        var varNotificacion_Departamento_id = $('#Notificacion_Departamento_id').val();
        var varNotificacion_Municipio_id = $('#Notificacion_Municipio_id').val();




        var data = {
            regionid: varRegionFinca_id,
            subregionid: varSubRegionFinca_id,
            Notificacion_Direccion: varNotificacion_Direccion,
            Notificacion_Departamento_id: varNotificacion_Departamento_id,
            Notificacion_Municipio_id: varNotificacion_Municipio_id
        };

        var url = "@Url.Action("actualizarregion", "Sol_Finca")";

             $.post(url, data).done(function (jsonRespuesta) {

                var objJSON = JSON.parse(jsonRespuesta);
                var Cod_Respuesta = objJSON.CodRespuesta;
                var Texto_Respuesta = objJSON.strRespuesta;

                alert(Texto_Respuesta);

                if (Cod_Respuesta == 0) {
                    $('#lblMensaje').text(Texto_Respuesta);
                } else if (Cod_Respuesta == 1) {
                    alert(Texto_Respuesta);
                }
            });

    }

    function actualizarArea()
    {

        var varArea = $('#inputArea').val();
        var data = {
            areafinca: varArea,
            solicitud_id:@ViewBag.Solicitud_id ,
            firma:'@ViewBag.SolicitudGuid'
        };


        var url = "@Url.Action("actualizarArea", "Sol_Finca")";

             $.post(url, data).done(function (jsonRespuesta) {

                var objJSON = JSON.parse(jsonRespuesta);
                var Cod_Respuesta = objJSON.CodRespuesta;
                var Texto_Respuesta = objJSON.strRespuesta;

                if (Cod_Respuesta == 0) {
                    $('#lblMensaje').text(Texto_Respuesta);
                } else if (Cod_Respuesta == 1) {
                    var TdHiddeA = document.getElementById("section_Finca");
                    TdHiddeA.style.display = "block";
                    $('#lblMensaje').text(Texto_Respuesta);
                    location.reload();
                }
            });

    }

</script>

