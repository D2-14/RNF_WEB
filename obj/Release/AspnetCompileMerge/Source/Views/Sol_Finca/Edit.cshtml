                    @Html.LabelFor(model => model.RegLibro, "No.Libro", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.RegLibro, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.RegLibro, "", new { @class = "text-danger" })
                    </div>
                </td>
            </tr>
            <tr>
                <td id="RegistroDeLaPropiedadDepartamento" colspan="3">
                    @Html.LabelFor(model => model.RegDepartamento_id, htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-10">
                        @Html.DropDownList("RegDepartamento_id", null, htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.RegDepartamento_id, "", new { @class = "text-danger" })
                    </div>
                </td>
