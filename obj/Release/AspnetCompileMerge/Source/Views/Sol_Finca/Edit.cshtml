@model RNF_Web.Models.Tbl_Sol_Finca
@using RNF_Web.Models;
@using System.Data.SqlClient;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Url.Action("Edit", "Sol_Finca")
}


@{
    db_RNFEntities db = new db_RNFEntities();
    Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(Session[Constants.session_Solicitud]);

    int intCategoria = db.Tbl_Sol_Solicitud_Categoria.Where(Obj => Obj.Categoria_id == tbl_sol_solicitud.Categoria_id && (Obj.Descripcion.Contains("Sistemas agroforestales") || Obj.Descripcion.Contains("Plantaciones forestales"))).Count();


    if ((intCategoria > 0))
    {
        ViewBag.intCategoria = 1;
    }
    else
    {
        ViewBag.intCategoria = 0;
    }

    ViewBag.Estado = tbl_sol_solicitud.Estado_id;


    Layout = "~/Views/Shared/_LayoutSimple.cshtml";

    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    string Nombre_Div = "div_Sol_Permisos_Sol_Finca_Edit";
    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }
    fc_Gral_Sol_Configuracion_Result permisos = db.fc_Gral_Sol_Configuracion(tbl_sol_solicitud.Solicitud_id, controllerName, boolEsInterno).FirstOrDefault();
}


<script src="~/Scripts/jquery-3.6.0.js"></script>
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.js"></script>

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>



<script>

    function visualizarPermisos(solicitudid, controllername, esinterno, nombrediv) {
        var solicitudId = solicitudid;
        var controllerName = controllername;
        var esInterno = esinterno;

        var mySolPermisos = document.getElementById(nombrediv);
        if (mySolPermisos) {
            $("#" + nombrediv).load("/Gral_SolicitudConfiguracion/PermisosRecibidos?Solicitud_id=" + solicitudId + "&controllerName=" + controllerName + "&EsInterno=" + esInterno);
        }

    }

    $(document).ready(function () {
        visualizarPermisos('@tbl_sol_solicitud.Solicitud_id', '@controllerName', '@objUs.EsInterno', '@Nombre_Div');

        const tmArea_SIGAP = document.querySelector('#Area_SIGAP');
        const tmNo_Sigap = document.querySelector('#No_Sigap');

        if (tmArea_SIGAP.checked) {

            var TdHiddeA = document.getElementById("No_Sigap");
            var TdHiddeA = document.getElementById("CategoriaSIGAP");
            TdHiddeA.style.display = "block";
        }
        else {
            var TdHiddeA = document.getElementById("No_Sigap");
            TdHiddeA.checked = true
            var TdHiddeA = document.getElementById("CategoriaSIGAP");
            TdHiddeA.style.display = "none";
        }

        $(document).on('change', '#Area_SIGAP', function () {
            const AreaSIGAP = document.querySelector('#Area_SIGAP');
            if (AreaSIGAP.checked) {
                document.querySelector('#No_Sigap').checked = false;
                var TdHiddeA = document.getElementById("CategoriaSIGAP");
                TdHiddeA.style.display = "block";
            }
            else {
                document.querySelector('#No_Sigap').checked = true;
                var TdHiddeA = document.getElementById("CategoriaSIGAP");
                TdHiddeA.style.display = "none";
            }


        });

        $(document).on('change', '#No_Sigap', function () {
            const NoAreaSIGAP = document.querySelector('#No_Sigap');
            if (NoAreaSIGAP.checked) {
                document.querySelector('#Area_SIGAP').checked = false;
                var TdHiddeA = document.getElementById("CategoriaSIGAP");
                TdHiddeA.style.display = "none";
            }
            else {
                document.querySelector('#Area_SIGAP').checked = true;
                document.querySelector('#No_Sigap').checked = false;
                var TdHiddeA = document.getElementById("CategoriaSIGAP");
                TdHiddeA.style.display = "block";
            }

        });



        const tmOtrosRegistrosRNF = document.querySelector('#OtrosRegistrosRNF');
        const tmNoOtrosRegistrosRNF = document.querySelector('#NoOtrosRegistrosRNF');

        if (tmOtrosRegistrosRNF.checked)
        {
            var TdHiddeA = document.getElementById("tdOtroRegistroRNF");
            TdHiddeA.style.display = "block";
        }

        $(document).on('change', '#OtrosRegistrosRNF', function () {
            const OtrosRegistrosRNF = document.querySelector('#OtrosRegistrosRNF');
            if (OtrosRegistrosRNF.checked) {
                document.querySelector('#NoOtrosRegistrosRNF').checked = false;
                var TdHiddeA = document.getElementById("tdOtroRegistroRNF");
                TdHiddeA.style.display = "block";

            }
            else {
                document.querySelector('#NoOtrosRegistrosRNF').checked = true;
                var TdHiddeA = document.getElementById("tdOtroRegistroRNF");
                TdHiddeA.style.display = "none";
            }

        }); // -----Fin de Change Grado_Academico_Tecnico


        $(document).on('change', '#NoOtrosRegistrosRNF', function () {
            const OtrosRegistrosRNF = document.querySelector('#NoOtrosRegistrosRNF');
            if (OtrosRegistrosRNF.checked) {
                document.querySelector('#OtrosRegistrosRNF').checked = false;
                var TdHiddeA = document.getElementById("tdOtroRegistroRNF");
                TdHiddeA.style.display = "none";

            }
            else {
                document.querySelector('#OtrosRegistrosRNF').checked = true;
                var TdHiddeA = document.getElementById("tdOtroRegistroRNF");
                TdHiddeA.style.display = "block";
            }

        }); // -----Fin de Change Grado_Academico_Tecnico



        $("#ActaNotarialDeEscrituraPublica_Fecha").datepicker({
            dateFormat: "dd/mm/yy",
            yearRange: "-120:+0",
            changeMonth: true,
            changeYear: true
        });


        $(document).on('change', '#DepartamentoFinca_Id', function () {

            var url = "@Url.Action("GetMunicipios", "Sol_Solicitud")";
            var Departamento = $('#DepartamentoFinca_Id').val();
            var data = { Departamento: Departamento};

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#MunicipioFinca_Id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text: municipio.Text
                    }));

                });


            }).fail(manejarErrorAjax).always(function () {
            });


        }); // -----Fin de Change ddlDepartamento


        $(document).on('change', '#ConstanciaDePorpiedad_id', function () {
            var Constancia = $('#ConstanciaDePorpiedad_id').val();

            if ((Constancia == 1) || (Constancia == 6)) {

                var TdToShowA = document.getElementById("Registro_DeLaPropiedad");
                TdToShowA.style.display = "block";


                var TdToShowR = document.getElementById("RegistroDeLaPropiedadDepartamento");
                if (Constancia == 6) {
                    TdToShowR.style.display = "none";
                }
                else {
                    TdToShowR.style.display = "block";
                }



                var TdToHideB = document.getElementById("OtroDocumento");
                TdToHideB.style.display = "none";


                var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJurada");
                TdToShowA.style.display = "none";

                var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJuradaconCertificacion");
                TdToShowA.style.display = "none";

                var TdToShowA = document.getElementById("ActaNotarialDeEscrituraPublica");
                TdToShowA.style.display = "none";



            }

            if (Constancia == 2) {

                var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJurada");
                TdToShowA.style.display = "block";

                var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJuradaconCertificacion");
                TdToShowA.style.display = "none";

                var TdToShowB = document.getElementById("Registro_DeLaPropiedad");
                TdToShowB.style.display = "none";

                var TdToHideC = document.getElementById("OtroDocumento");
                TdToHideC.style.display = "none";

                var TdToHideA = document.getElementById("OtroDocumento");
                TdToHideA.style.display = "none";

                var TdToShowA = document.getElementById("ActaNotarialDeEscrituraPublica");
                TdToShowA.style.display = "none";


            }

            if (Constancia == 3) {

                var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJurada");
                TdToShowA.style.display = "block";

                var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJuradaconCertificacion");
                TdToShowA.style.display = "block";

                var TdToShowB = document.getElementById("Registro_DeLaPropiedad");
                TdToShowB.style.display = "none";

                var TdToHideC = document.getElementById("OtroDocumento");
                TdToHideC.style.display = "none";

                var TdToHideA = document.getElementById("OtroDocumento");
                TdToHideA.style.display = "none";

                var TdToShowA = document.getElementById("ActaNotarialDeEscrituraPublica");
                TdToShowA.style.display = "none";


            }

            if (Constancia == 4) {


                var TdToShowA = document.getElementById("ActaNotarialDeEscrituraPublica");
                TdToShowA.style.display = "block";

                var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJurada");
                TdToShowA.style.display = "block";

                var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJuradaconCertificacion");
                TdToShowA.style.display = "none";

                var TdToShowB = document.getElementById("Registro_DeLaPropiedad");
                TdToShowB.style.display = "none";

                var TdToHideC = document.getElementById("OtroDocumento");
                TdToHideC.style.display = "none";

            }

            if ((Constancia == 5) || (Constancia == 7)) {


                var TdToShowA = document.getElementById("ActaNotarialDeEscrituraPublica");
                TdToShowA.style.display = "block";

                var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJurada");
                TdToShowA.style.display = "block";

                var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJuradaconCertificacion");
                TdToShowA.style.display = "none";

                var TdToShowB = document.getElementById("Registro_DeLaPropiedad");
                TdToShowB.style.display = "none";

                var TdToHideA = document.getElementById("OtroDocumento");
                TdToHideA.style.display = "block";

            }

        }); // -----Fin de Change ddlDepartamento


        var Constancia = $('#ConstanciaDePorpiedad_id').val();




        if ((Constancia == 1) || (Constancia == 6)) {

            var TdToShowA = document.getElementById("Registro_DeLaPropiedad");
            TdToShowA.style.display = "block";


            var TdToShowR = document.getElementById("RegistroDeLaPropiedadDepartamento");
            if (Constancia == 6) {
                TdToShowR.style.display = "none";
            }
            else {
                TdToShowR.style.display = "block";
            }


            var TdToHideB = document.getElementById("OtroDocumento");
            TdToHideB.style.display = "none";


            var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJurada");
            TdToShowA.style.display = "none";

            var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJuradaconCertificacion");
            TdToShowA.style.display = "none";

            var TdToShowA = document.getElementById("ActaNotarialDeEscrituraPublica");
            TdToShowA.style.display = "none";



        }

        if (Constancia == 2) {

            var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJurada");
            TdToShowA.style.display = "block";

            var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJuradaconCertificacion");
            TdToShowA.style.display = "none";

            var TdToShowB = document.getElementById("Registro_DeLaPropiedad");
            TdToShowB.style.display = "none";

            var TdToHideC = document.getElementById("OtroDocumento");
            TdToHideC.style.display = "none";

            var TdToHideA = document.getElementById("OtroDocumento");
            TdToHideA.style.display = "none";

            var TdToShowA = document.getElementById("ActaNotarialDeEscrituraPublica");
            TdToShowA.style.display = "none";


        }

        if (Constancia == 3) {

            var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJurada");
            TdToShowA.style.display = "block";

            var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJuradaconCertificacion");
            TdToShowA.style.display = "block";

            var TdToShowB = document.getElementById("Registro_DeLaPropiedad");
            TdToShowB.style.display = "none";

            var TdToHideC = document.getElementById("OtroDocumento");
            TdToHideC.style.display = "none";

            var TdToHideA = document.getElementById("OtroDocumento");
            TdToHideA.style.display = "none";

            var TdToShowA = document.getElementById("ActaNotarialDeEscrituraPublica");
            TdToShowA.style.display = "none";


        }

        if (Constancia == 4) {


            var TdToShowA = document.getElementById("ActaNotarialDeEscrituraPublica");
            TdToShowA.style.display = "block";

            var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJurada");
            TdToShowA.style.display = "block";

            var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJuradaconCertificacion");
            TdToShowA.style.display = "none";

            var TdToShowB = document.getElementById("Registro_DeLaPropiedad");
            TdToShowB.style.display = "none";

            var TdToHideC = document.getElementById("OtroDocumento");
            TdToHideC.style.display = "none";

        }

        if ((Constancia == 5) || (Constancia == 7)) {

            var TdToShowA = document.getElementById("ActaNotarialDeEscrituraPublica");
            TdToShowA.style.display = "block";

            var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJurada");
            TdToShowA.style.display = "block";

            var TdToShowA = document.getElementById("ActaNotarialDeDeclaracionJuradaconCertificacion");
            TdToShowA.style.display = "none";

            var TdToShowB = document.getElementById("Registro_DeLaPropiedad");
            TdToShowB.style.display = "none";

            var TdToHideA = document.getElementById("OtroDocumento");
            TdToHideA.style.display = "block";

        }




    });

</script>

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <div id="@Nombre_Div"></div>
}


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <h4>@ViewBag.Mensaje</h4>

    <div class="container">

        <div class="titulo-dos">
            <h4>Datos de la finca</h4>
        </div>

        <h3>@ViewBag.mensaje</h3>

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.HiddenFor(model => model.Finca_Id)
        @Html.HiddenFor(model => model.Solicitud_id)
        @Html.HiddenFor(model => model.swcreatedby)
        @Html.HiddenFor(model => model.swdatecreated)
        @Html.HiddenFor(model => model.swcreatedbyinterno)
        @Html.HiddenFor(model => model.swcreatedbyinterno)
        @Html.HiddenFor(model => model.swcreatedbyinterno)

        @Html.HiddenFor(model => model.GTMX)
        @Html.HiddenFor(model => model.GTMY)


        @Html.HiddenFor(model => model.swdateupdated)
        @Html.HiddenFor(model => model.swupdatedby)
        @Html.HiddenFor(model => model.swupdatedbyinterno)

        <table class="table table-condensed">
            <tr>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td colspan="2">
                    @Html.LabelFor(model => model.NombreFinca, htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.NombreFinca, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.NombreFinca, "", new { @class = "text-danger" })
                    </div>
                </td>
                <td>
                    @Html.LabelFor(model => model.ConstanciaDePorpiedad_id, htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-10">
                        @Html.DropDownList("ConstanciaDePorpiedad_id", null, htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.ConstanciaDePorpiedad_id, "", new { @class = "text-danger" })
