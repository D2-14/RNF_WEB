@if (tbl_sol_solicitud.Categoria_id == 6)
{
    <div id="DatosFuenteSemillera"></div>
}
else
{
    <div id="DatosFuenteSemillera" hidden></div>
}



<script>

    $(document).ready(function () {
        $('#DatosFuenteSemillera').load('/Sol_Finca_FuenteSemillera/Edit_DatosFuenteSemillera?solicitudid=@Model.Solicitud_id&finca_id=@Model.Finca_Id');

        /*checkbox La plantación es producto de reforestación con CONAP ?*/
        /*Si se selecciona Si*/
        $("#Reforestacion_CONAP").change(function () {
            if ($(this).is(":checked")) {
                $("#No_CONAP").prop("checked", false);
            } else {
                $("#No_CONAP").prop("checked", true);
            }
        });

        /*Si se selecciona No*/
        $("#No_CONAP").change(function () {
            if ($(this).is(":checked")) {
                $("#Reforestacion_CONAP").prop("checked", false);
            } else {
                $("#Reforestacion_CONAP").prop("checked", true);
            }
        });
    });

</script>

