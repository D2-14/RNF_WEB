@using RNF_Web.Models;

@{
    Layout = "~/Views/Shared/_LayoutMenu.cshtml";

    ViewBag.Title = "Vinculación de casillero electrónico";
    ViewBag.SubTitle = "Debe vincular su casillero electrónico";
}

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@Html.Partial("_PartialPageEncabezado")


<div class="container-fluid">

    <span>
        <h1>Vinculación de casillero electrónico<hr width="100%" size="1" color="silver"></h1>
        <h3>El número de Documento Personal de Identificación (DPI) asignado al casillero electrónico que vinculará debe ser el mismo de usuario que ha registrado en este sistema. </h3>
        <h3>Esto para poder ser vinculado el casillero electrónico.</h3>
        <hr width="100%" size="1" color="silver">
        <form id="formLogin" method="post" action="@Url.Action("RegistroCasillero", "CasilleroElectronico")">
            <input type="text" id="NoCasillero" name="NoCasillero" placeholder="No de Casillero" />
            <input type="submit" value="Vincular Casillero" class="btn-next" />
            <label style="color: red;">@ViewBag.MensajeError</label>
      </form>
</span>

</div>


@Html.Partial("_PartialPageEncabezadoCierre")

