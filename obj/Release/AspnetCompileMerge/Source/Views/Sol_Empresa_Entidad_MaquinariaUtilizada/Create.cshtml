@model RNF_Web.Models.Tbl_Gral_Maquinaria_Utilizada
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@{
    Layout = null;
    ViewBag.Title = "Maquinaria Utilizada";
    ViewBag.SubTitle = "Ingresar maquinaria utilizada";
    db_RNFEntities db = new db_RNFEntities();
    Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(ViewBag.SolicitudId);
    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    controllerName = "Sol_Empresa_Entidad";
    string Nombre_Div = "div_Sol_Permisos_Empresa_Entidad_Maquinaria_Utilizada_Create";
    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }
    fc_Gral_Sol_Configuracion_Result permisos = db.fc_Gral_Sol_Configuracion(tbl_sol_solicitud.Solicitud_id, controllerName, boolEsInterno).FirstOrDefault();
}

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <div id="@Nombre_Div"></div>
}



<script>
    function visualizarPermisos(solicitudid, controllername, esinterno, nombrediv) {
        var solicitudId = solicitudid;
        var controllerName = controllername;
        var esInterno = esinterno;

        var mySolPermisos = document.getElementById(nombrediv);
        if (mySolPermisos) {
            $("#" + nombrediv).load("/Gral_SolicitudConfiguracion/PermisosRecibidos?Solicitud_id=" + solicitudId + "&controllerName=" + controllerName + "&EsInterno=" + esInterno);
        }

    }


    $(document).ready(function () {
        visualizarPermisos('@tbl_sol_solicitud.Solicitud_id', '@controllerName', '@objUs.EsInterno', '@Nombre_Div');

        $('#listadoMaquinariaUtilizada').load('/Sol_Empresa_Entidad_MaquinariaUtilizada/Index?SolicitudId=@ViewBag.SolicitudId');

    });

    function AgregarMaquinariaUtilizada()
    {

        var url = "@Url.Action("AgregarMaquinariaUtilizada", "Sol_Empresa_Entidad_MaquinariaUtilizada")";
        var SolicitudId = @ViewBag.SolicitudId;
        var MaquinariaUtilizadaId = $('#lstMaquinariaUtilizada').val();

        var data = {
            SolicitudId: SolicitudId,
            MaquinariaUtilizadaId: MaquinariaUtilizadaId
        };

        $.post(url, data).done(function (jsonRespuesta) {

                var objJSON = JSON.parse(jsonRespuesta);
                var Cod_Respuesta = objJSON.CodRespuesta;
                var Texto_Respuesta = objJSON.strRespuesta;

            $('#listadoMaquinariaUtilizada').load('/Sol_Empresa_Entidad_MaquinariaUtilizada/Index?SolicitudId=@ViewBag.SolicitudId');

            });
    }

    function Borrar_MaquinariaUtilizada(SolicitudId, MaquinariaUtilizadaId)
    {
        var url = "@Url.Action("EliminarMaquinariaUtilizada", "Sol_Empresa_Entidad_MaquinariaUtilizada")";

        var data = {
            SolicitudId: SolicitudId,
            MaquinariaUtilizadaId: MaquinariaUtilizadaId
        };

        $.post(url, data).done(function (jsonRespuesta) {

            var objJSON = JSON.parse(jsonRespuesta);
            var Cod_Respuesta = objJSON.CodRespuesta;
            var Texto_Respuesta = objJSON.strRespuesta;

            $('#listadoMaquinariaUtilizada').load('/Sol_Empresa_Entidad_MaquinariaUtilizada/Index?SolicitudId=@ViewBag.SolicitudId');

        });

    }


</script>

<br />
<div style='height: 30px; width: 100%; background-color: #66bb6a; color: white; '>
    <h4>Listado de Maquinaria Utilizada</h4>
</div>

<table width="100%">
    <tr>
        <td>
            @Html.LabelFor(model => model.Nombres_Comunes, "Maquinaria Utilizada", htmlAttributes: new { @class = "control-label col-md-12" })
        <td>
        </td>
    </tr>
    <tr>
        <td>
            @Html.DropDownList("lstMaquinariaUtilizada", null, htmlAttributes: new { @class = "form-select" })
        </td>

        <td>
            @if ((bool)permisos.Agregar)
            {
                <input type="button" class="btn-success" value="Agregar" onclick="AgregarMaquinariaUtilizada()" />
            }
        </td>

    </tr>
    <tr>
        <td></td>
        <td> <label id="lblMensaje" name="lblMensaje" /></td>
    </tr>
</table>

<div id="listadoMaquinariaUtilizada" name="listadoMaquinariaUtilizada" />
<hr />
