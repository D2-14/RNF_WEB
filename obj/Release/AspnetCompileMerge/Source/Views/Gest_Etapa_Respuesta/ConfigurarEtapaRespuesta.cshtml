@model RNF_Web.Models.Tbl_Gest_Etapa_Respuesta
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@{
    Layout = "~/Views/Shared/_LayoutSimple.cshtml";
}

<script src="~/Scripts/jquery-3.6.0.js"></script>
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.js"></script>

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<script>

     $(document).ready(function () {
         var Source = "/Gest_Etapa_Respuesta/ListadoEtapas?etapaid=" + @Model.Etapa_id + "&etaparutaid=" + @Model.EtapaRuta_id+ "&etaparespuestaid=" + @Model.Etapa_Respuesta_id;
         $('#ListadoEtapas').load(Source)

         var Source = "/Gest_Etapa_Respuesta/ListadoDocumentos?etapaid=" + @Model.Etapa_id + "&etaparutaid=" + @Model.EtapaRuta_id+ "&etaparespuestaid=" + @Model.Etapa_Respuesta_id;
             $('#ListadoDocumentos').load(Source)


         var Source = "/Gest_Etapa_Respuesta/ListadoFormularios?etapaid=" + @Model.Etapa_id + "&etaparutaid=" + @Model.EtapaRuta_id+ "&etaparespuestaid=" + @Model.Etapa_Respuesta_id;
             $('#ListadoFormularios').load(Source)

     });

</script>

<script>

    function CambiarEtapaRespuesta(varEtapaid, boolNuevoEstado)
    {
            $.ajax({
                type: 'POST',
                url: "@(Url.Action("CambiarEtapaRespuestaRuta", "Gest_Etapa_Respuesta"))",
                     dataType: 'json',
                data: { etapaid: @Model.Etapa_id, etaparutaid: @Model.EtapaRuta_id, etaparespuestaid: @Model.Etapa_Respuesta_id, nuevaetapaid: varEtapaid, estado: boolNuevoEstado },
                success: function (doc) {
                },
                error: function (ex) {
                alert('Ocurrio un error aqui. ' + ex.status);
                }

                });
                return false;
    }



