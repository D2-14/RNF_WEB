@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@{
    Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
}


<script src="~/Scripts/jquery-3.6.0.js"></script>
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.js"></script>

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>



<div class="col">
    <div class="form-group">
        @Html.DropDownList("ConfiguracionTipoSolicitud_id", null, htmlAttributes: new { @class = "form-select", onchange = "refreshVistaConfiguracion()" })
    </div>
</div>

<div id="div_ConfiguracionDocumentos"></div>

<div id="div_PermisosAsignados"></div>

<div align="right">
    <input type="button" class="btn btn-success" value="Guardar Cambios" onclick="grabarCambios()" />
</div>

<script>
    $(document).ready(function () {
        refreshVistaConfiguracion();
    });

    function refreshVistaConfiguracion() {
        var SolicitudTipo_id = document.getElementById("ConfiguracionTipoSolicitud_id").value;
        console.log(SolicitudTipo_id);

        $("#div_ConfiguracionDocumentos").load("/Gral_SolicitudConfiguracion/Edit?id=" + SolicitudTipo_id);


        $("#div_PermisosAsignados").load("/Gral_SolicitudConfiguracion/PermisosAsignados/?SolicitudTipo_id=" + SolicitudTipo_id);
    }

    function actualizar()
    {
        var SolicitudTipo_id = document.getElementById("SolicitudTipo_id").value;

        varFormatoSolicitud_Codigo = document.getElementById("FormatoSolicitud_Codigo").value;
        varFormatoSolicitud_Fecha = document.getElementById("FormatoSolicitud_Fecha").value;
        varFormatoSolicitud_Version = document.getElementById("FormatoSolicitud_Version").value;

        varBoletaDeDecision_Codigo = document.getElementById("BoletaDeDecision_Codigo").value;
        varBoletaDeDecision_Version = document.getElementById("BoletaDeDecision_Version").value;
        varBoletaDeDecision_Fecha = document.getElementById("BoletaDeDecision_Fecha").value;

        varInformeTecnico_Codigo = document.getElementById("InformeTecnico_Codigo").value;
        varInformeTecnico_Version = document.getElementById("InformeTecnico_Version").value;
        varInformeTecnico_Fecha = document.getElementById("InformeTecnico_Fecha").value;

        var data = {

            SolicitudTipo_id: SolicitudTipo_id,
            FormatoSolicitud_Codigo: varFormatoSolicitud_Codigo,
            FormatoSolicitud_Fecha : varFormatoSolicitud_Fecha,
            FormatoSolicitud_Version: varFormatoSolicitud_Version,

            BoletaDeDecision_Codigo: varBoletaDeDecision_Codigo,
            BoletaDeDecision_Fecha: varBoletaDeDecision_Fecha,
            BoletaDeDecision_Version: varBoletaDeDecision_Version,

            InformeTecnico_Codigo: varInformeTecnico_Codigo,
            InformeTecnico_Version: varInformeTecnico_Version,
            InformeTecnico_Fecha: varInformeTecnico_Fecha


        }

         var url = "@Url.Action("GrabarCambiosfiguracionTipo", "Gral_SolicitudConfiguracion")";

        $.post(url, data).done(function (jsonRespuesta) {
            var oJSON = JSON.parse(jsonRespuesta);
            var respuesta = oJSON.Resultado;
            alert(respuesta);
            refreshVistaConfiguracion();
        })

    }

