        var Empresa_Entidad_Agregar = opcion_Empresa_Entidad_Agregar.checked;

        var data = {
            SolicitudTipo_id: SolicitudTipo_id,
            Usuario_CopiarDesdeRNF: Usuario_CopiarDesdeRNF,
            Usuario_Actualizar: Usuario_Actualizar,
            Usuario_Borrar: Usuario_Borrar,
            Usuario_Agregar: Usuario_Agregar,
            Propietario_CopiarDesdeRNF: Propietario_CopiarDesdeRNF,
            Propietario_Editar: Propietario_Editar,
            Propietario_Borrar: Propietario_Borrar,
            Propietario_Agregar: Propietario_Agregar,
            Representante_CopiarDesdeRNF: Representante_CopiarDesdeRNF,
            Representante_Editar: Representante_Editar,
            Representante_Borrar: Representante_Borrar,
            Representante_Agregar: Representante_Agregar,
