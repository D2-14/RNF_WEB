        var Propietario_CopiarDesdeRNF = opcion_Propietario_CopiarDesdeRNF.checked;
        var Propietario_Editar = opcion_Propietario_Editar.checked;
        var Propietario_Borrar = opcion_Propietario_Borrar.checked;
        var Propietario_Agregar = opcion_Propietario_Agregar.checked;
        var Representante_CopiarDesdeRNF = opcion_Representante_CopiarDesdeRNF.checked;
        var Representante_Editar = opcion_Representante_Editar.checked;
        var Representante_Borrar = opcion_Representante_Borrar.checked;
        var Representante_Agregar = opcion_Representante_Agregar.checked;
        var Finca_CopiarDesdeRNF = opcion_Finca_CopiarDesdeRNF.checked;
        var Finca_Editar = opcion_Finca_Editar.checked;
        var Finca_Borrar = opcion_Finca_Borrar.checked;
        var Finca_Agregar = opcion_Finca_Agregar.checked;
        var Rodal_CopiarDesdeRNF = opcion_Rodal_CopiarDesdeRNF.checked;
