@using RNF_Web.Models;
@model List<Tbl_Gest_EtapaSolicitud_OficioTecnico_Critica>
@{
    string chbCheck = "checked";
}



@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}




<table class="table table-striped table-hover" border="0">
    <thead>
        <tr>
            <th scope="col">
                Críticas a Técnico
            </th>
            <th scope="col">
                Acción
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Descripcion
                </td>
                <td>
                    <img src="~/Content/icons/trash_green.png" alt="Eliminar" height="50" onclick="eliminarCritica(@item.Critica_id)" />
                </td>
            </tr>
        }
    </tbody>
</table>

