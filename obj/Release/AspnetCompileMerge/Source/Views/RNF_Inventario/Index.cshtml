@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@{
    ViewBag.Title = "Listado de solicitudes";
    Layout = null;
    Usuario objUs = ViewBag.Session;
    string Guid_id = ViewBag.Guid_id;

    EdicionSolicitudGrants objGrant = (EdicionSolicitudGrants)Session[Constants.session_EdicionSolicitudGrants];

}


<div id="div_Fincas"></div>
<br />


<div id="cultivo"></div>


<script>
    //Se utiliza para llamar las ubicaciones cuando se ha creado una nueva.
    function RefrescarVista(strVista) {
        $('#ViewIntecnova').load(strVista)
        mostrarMenuLateral()
    }

    $(document).ready(function () {
        var myFincas = document.getElementById('div_Fincas');
        if (myFincas) {
            $('#div_Fincas').load("/RNF_Inventario/Fincas?Guid_id=@Guid_id")
        }
    });
</script>

