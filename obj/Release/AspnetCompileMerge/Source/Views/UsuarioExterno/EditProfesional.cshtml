@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}
@{

    ViewBag.Title = "   Actualización de datos del solicitante ";
    ViewBag.SubTitle = null;

    db_RNFEntities db = new db_RNFEntities();
    Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(Session[Constants.session_Solicitud]);
    ViewBag.Estado = tbl_sol_solicitud.Estado_id;


}



<script>
    $(document).ready(function () {

        var intSubCategoria = @ViewBag.SubCategoria;
        const constGrado_Academico_Tecnico = document.querySelector('#Grado_Academico_Tecnico');
        const constGrado_Academico_Profesional = document.querySelector('#Grado_Academico_Profesional');
        const constDatosPostgrado = document.querySelector('#PostGradoMateriaForestal');

        if ((intSubCategoria) == 4) {
            var TdToShowA = document.getElementById("DatosEspecificarCarrera");
            TdToShowA.style.display = "block";
        }
        else
        {
            var TdToHiddeA = document.getElementById("DatosEspecificarCarrera");
            TdToHiddeA.style.display = "none";
        }

        if (constGrado_Academico_Profesional.checked) {
            var TdToHiddeA = document.getElementById("DatosUniversidad");
            TdToHiddeA.style.display = "block";
        }
        else
        {
            var TdToHiddeA = document.getElementById("DatosUniversidad");
            TdToHiddeA.style.display = "none";
        }

        if (constDatosPostgrado.checked) {
            var TdToHiddeA = document.getElementById("DatosPostgrado");
            TdToHiddeA.style.display = "block";
        }
        else {
            var TdToHiddeA = document.getElementById("DatosPostgrado");
            TdToHiddeA.style.display = "none";
        }




        $(document).on('change', '#Profesion_id', function () {

            var Valor = document.getElementById("Profesion_id").value;

            if (Valor == 8) {
                var TdToHiddeA = document.getElementById("DatosUniversidadEspecificar");
                TdToHiddeA.style.display = "block";
            }
            else
            {
                var TdToHiddeA = document.getElementById("DatosUniversidadEspecificar");
                TdToHiddeA.style.display = "none";
            }


        }); // -----Fin de Change Grado_Academico_Tecnico



        $(document).on('change', '#Grado_Academico_Tecnico', function () {
            const Grado_Academico_Tecnico = document.querySelector('#Grado_Academico_Tecnico');
            if (Grado_Academico_Tecnico.checked) {
                document.querySelector('#Grado_Academico_Profesional').checked = false;
                document.querySelector('#PostGradoMateriaForestal').checked = false;
                var TdHiddeA = document.getElementById("DatosUniversidad");
                TdHiddeA.style.display = "none";
                var TdHiddeB = document.getElementById("DatosPostgrado");
                TdHiddeB.style.display = "none";

            }
            const Grado_Academico_Profesional = document.querySelector('#Grado_Academico_Profesional');

            var url = "@Url.Action("GetProfesion", "Gral_Profesion")";
            var data = { GAT: Grado_Academico_Tecnico.checked, GAP: Grado_Academico_Profesional.checked, };

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#Profesion_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, profesion) {
                    select.append($('<option/>', {
                        value: profesion.Value,
                        text: profesion.Text
                    }));

                });


            }).fail(manejarErrorAjax).always(function () {
            });



        }); // -----Fin de Change Grado_Academico_Tecnico

        $(document).on('change', '#Grado_Academico_Profesional', function () {
            const Grado_Academico_Profesional = document.querySelector('#Grado_Academico_Profesional');
            if (Grado_Academico_Profesional.checked) {
                document.querySelector('#Grado_Academico_Tecnico').checked = false;

                var TdToShowA = document.getElementById("DatosUniversidad");
                TdToShowA.style.display = "block";


            }
            else
            {
                var TdToShowA = document.getElementById("DatosUniversidad");
                var TdToShowB = document.getElementById("DatosPostgrado");

                TdToShowA.style.display = "none";
                TdToShowB.style.display = "none";
                document.getElementById("PostGradoMateriaForestal").checked = false;

            }

            const Grado_Academico_Tecnico = document.querySelector('#Grado_Academico_Tecnico');

            var url = "@Url.Action("GetProfesion", "Gral_Profesion")";
            var data = { GAT: Grado_Academico_Tecnico.checked, GAP: Grado_Academico_Profesional.checked, };

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#Profesion_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, profesion) {
                    select.append($('<option/>', {
                        value: profesion.Value,
                        text: profesion.Text
                    }));

                });


            }).fail(manejarErrorAjax).always(function () {
            });



        }); // -----Fin de Change Grado_Academico_Profesional

        $(document).on('change', '#PostGradoMateriaForestal', function () {
            const PostGradoMateriaForestal = document.querySelector('#PostGradoMateriaForestal');
            if (PostGradoMateriaForestal.checked) {
                var TdToShowA = document.getElementById("DatosPostgrado");
                TdToShowA.style.display = "block";
            }
            else {
                var TdToShowA = document.getElementById("DatosPostgrado");
                TdToShowA.style.display = "none";
            }

        });


        $("#Fecha_Nacimiento").datepicker({
            dateFormat: "dd/mm/yy",
            yearRange: "-120:+0",
            changeMonth: true,
            changeYear: true
        });


        $(document).on('change', '#DepartamentoDPI_id', function () {

            var url = "@Url.Action("GetMunicipios", "Sol_Solicitud")";
            var Departamento = $('#DepartamentoDPI_id').val();
            var data = { Departamento: Departamento};

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#MunicipioDPI_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text: municipio.Text
                    }));

                });


            }).fail(manejarErrorAjax).always(function () {
            });


        }); // -----Fin de Change ddlDepartamento


        $(document).on('change', '#Departamento_id', function () {

            var url = "@Url.Action("GetMunicipios", "Sol_Solicitud")";
            var Departamento = $('#Departamento_id').val();
            var data = { Departamento: Departamento};

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#Municipio_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text: municipio.Text
                    }));

                });


            }).fail(manejarErrorAjax).always(function () {
            });


        }); // -----Fin de Change ddlDepartamento



        $('#myModal').modal({
            backdrop: 'static',
            keyboard: false
        })

        $("#myModal").on('show.bs.modal', function () {

            var modal = $(this)
            modal.find('.modal-telefono').text("Teléfono a agregar : " + document.getElementById("Telefono_Celular").value + "  Favor verifique.");

        });


        $("#btnHideMyModal").click(function () {
            $("#myModal").modal('hide');
        });


        $("#btnHideMyModal_Close").click(function () {
            $("#myModal").modal('hide');
        });


    });

</script>

