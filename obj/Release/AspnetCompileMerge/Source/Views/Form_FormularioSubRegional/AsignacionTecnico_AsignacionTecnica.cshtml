@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}



<script>



    function AsignarTecnico() {
        var varTecnico = $('#Tecnicos').val();


        alert("Asignación de técnico realizada con éxito.");

    }


</script>



<h3>
    Asignación técnica y jurídica
</h3>
<hr />
<br />

<h3>
    Asignación técnica
</h3>

<h3>@ViewBag.TecnicoAsigando </h3>

@Html.DropDownList("Tecnicos", null, htmlAttributes: new { @class = "form-select" })

<br />

    &nbsp;&nbsp;&nbsp;&nbsp;
