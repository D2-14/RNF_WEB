@Html.DropDownList("Juridico", null, htmlAttributes: new { @class = "form-select" })
<br />
<table>
    <tr>
        <td>
            <h4>Número de nombramiento</h4>
        </td>
        <td>
            &nbsp;&nbsp;&nbsp;&nbsp; <input type="text" id="No_Nombramiento" name="No_Nombramiento" value="@ViewBag.JuridicoAsignadoNombramiento" />
        </td>
    </tr>
</table>
<br />
    &nbsp;&nbsp;&nbsp;&nbsp;
<img id="imgAddme" src="~/Content/icons/EnviarMail.png" onmouseover="this.style.cursor='hand'" onmouseout="this.style.cursor='default'" onclick="AsignarJuridico()" width="380" height="auto" />


