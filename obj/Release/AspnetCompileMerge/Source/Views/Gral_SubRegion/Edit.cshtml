@model RNF_Web.Models.Tbl_Gral_SubRegion
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@{
    Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
    ViewBag.Title = "Sub Region";
    ViewBag.SubTitle = "Crear nueva Sub Region";
    string check = "checked";

}



<script>


    function GrabarSubRegion() {

        var varestado_id = document.querySelector('#Chk_Estado_id');

        var varregion_id = $('#Region_id').val();
        var varsubregion_id = $('#SubRegion_id').val();

        var varno_subregion = $('#No_SubRegion').val();

        var varnombre_subregion = $('#Nombre_SubRegion').val();
        var varid_rnf_s = $('#Id_RNF_S').val();


        var vardireccion = $('#Direccion').val();
        var vardepartamentoSubRegion_id = $('#DepartamentoSubRegion_id').val();
        var varmunicipioSubRegion_id = $('#MunicipioSubRegion_id').val();
        var vartelefono = $('#Telefono').val();

        var varestado = varestado_id.checked;

        var url = "@Url.Action("GrabarSubRegion", "Gral_SubRegion")";

        var data = { Region_id: varregion_id, SubRegion_id: varsubregion_id, No_SubRegion: varno_subregion, Nombre_SubRegion: varnombre_subregion, Id_RNF_S: varid_rnf_s, Direccion: vardireccion, DepartamentoSubRegion_id: vardepartamentoSubRegion_id, MunicipioSubRegion_id: varmunicipioSubRegion_id, Telefono: vartelefono, Estado_id: varestado };
    //       , Direccion: vardireccion, DepartamentoSubRegion_id: vardepartamentoSubRegion_id, MunicipioSubRegion_id: varmunicipioSubRegion_id, Telefono: vartelefono, Estado_id: varestado
    //};


        $.post(url, data).done(function (Listdata) {
        var objJSON = JSON.parse(Listdata);
        var Cod_Respuesta = objJSON.CodRespuesta;
        var Texto_Respuesta = objJSON.strRespuesta;

        if (Cod_Respuesta == 0) {
        $('#lblMensaje').text(Texto_Respuesta);
        } else if (Cod_Respuesta == 1) {
        alert(Texto_Respuesta);
        }

        }).fail(manejarErrorAjax).always(function () {
        alert('Error no identificado.');
        });

        }


        </script>


        @Html.Partial("_PartialPageEncabezado")

        <button class="btn-secondary" style="position: absolute; right: 0;" rel="tooltip" title="Regresar" onclick="location.href='@Url.Action("Edit", "Gral_Region",new { id = Model.Region_id } )'">
            <i><img src="~/Content/icons/regresar.png" style="border-radius: 30%; width: 35px; height: auto" /></i>
            <div class="ripple-container"></div>
        </button>

        <br />
        <br />

        <script src="~/Scripts/jquery-3.6.0.min.js"></script>
        <script src="~/Scripts/jquery.validate.min.js"></script>
        <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>



            <div class="container">


                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @Html.HiddenFor(model => model.Region_id)
                @Html.HiddenFor(model => model.SubRegion_id)

                @Html.HiddenFor(model => model.swcreatedby)
                @Html.HiddenFor(model => model.swdatecreated)
                @Html.HiddenFor(model => model.swcreatedbyinterno)

                @Html.HiddenFor(model => model.swdateupdated)
                @Html.HiddenFor(model => model.swupdatedby)
                @Html.HiddenFor(model => model.swupdatedbyinterno)


                <div class="row">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.No_SubRegion, htmlAttributes: new { @class = "control-label col-md-6" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.No_SubRegion, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.No_SubRegion, "", new { @class = "text-danger" })
                            </div>
                        </div>

                    </div>
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Nombre_SubRegion, htmlAttributes: new { @class = "control-label col-md-6" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Nombre_SubRegion, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Nombre_SubRegion, "", new { @class = "text-danger" })
                            </div>
                        </div>

                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Id_RNF_S, htmlAttributes: new { @class = "control-label col-md-6" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Id_RNF_S, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Id_RNF_S, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Estado_id, "Estado", htmlAttributes: new { @class = "control-label col-md-12" })
