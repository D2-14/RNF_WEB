@using RNF_Web.Models;
@model List<Tbl_API_Sol_Rodal_Descuento_Local>
@{
    AppAudit oAudit;
    oAudit = (AppAudit)Session["App"];
}

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}


@if (Model.Count() > 0)
{
    <h1 align="center">
        Áreas de Descuento Nuevas
    </h1>
    <table class="table table-striped table-hover" border="1">
        <thead>
            <tr>
                <th>
                    <strong>
                        Finca
                    </strong>
                </th>
                <th>
                    <strong>
                        Rodal
                    </strong>
                </th>
                <th>
                    <strong>
                        Area Total
                    </strong>
                </th>
                <th>
                    <strong>
                        # Descuento
                    </strong>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.Finca_id
                    </td>
                    <td>
                        @item.Rodal_Id
                    </td>
                    <td>
                        @item.AreaTotal
                    </td>
                    <td>
                        <a href="/App_Visita_Campo" target="_blank">@item.Rodal_Descuento_Id</a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
}
