@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Url.Action("PermitirCambios", "App_Visita_Campo")
}


<p>Permitir Subir Documentos</p>
<label class="switch">
    <input type="checkbox" id="PermitirDocumentos" onchange="PermitirDocumentos()" @if ((bool)Model.PermitirSubirDocumentos) { @check }>
    <span class="slider round"></span>
</label>

<p>Permitir Cambio de Propietario/Representante</p>
<label class="switch">
    <input type="checkbox" id="PermitirPropietarioRepresentante" onchange="PermitirPropietarioRepresentante()" @if ((bool)Model.PermitirCambioDePropietarioRepresentante) { @check }>
    <span class="slider round"></span>
</label>

<p>Permitir Cambio de Finca/Rodales/Dasometricos</p>
