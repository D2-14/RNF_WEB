<style>
    .switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        -webkit-transition: .4s;
        transition: .4s;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            -webkit-transition: .4s;
            transition: .4s;
        }

    input:checked + .slider {
        background-color: #2196F3;
    }

    input:focus + .slider {
        box-shadow: 0 0 1px #2196F3;
    }

    input:checked + .slider:before {
        -webkit-transform: translateX(26px);
        -ms-transform: translateX(26px);
        transform: translateX(26px);
    }

    /* Rounded sliders */
    .slider.round {
        border-radius: 34px;
    }

        .slider.round:before {
            border-radius: 50%;
        }
</style>

<script>


    function ocultar(nombre_tr) {
        var tr_visualizar = document.getElementById(nombre_tr);
        tr_visualizar.style.display = 'none';
    }

    $(document).ready(function () {
        var SolicitudTipo_id = '@Model.SolicitudTipo_id';

        var data = {
            SolicitudTipo_id: SolicitudTipo_id
        };

        var url = '@Url.Action("VerificarPermisosSolicitudTipo", controllerName)';

        $.post(url, data).done(function (jsonRespuesta) {
            var oJSON = jsonRespuesta;
            console.log(oJSON);
            var Cultivo = oJSON.Cultivo;
            var Dasometricos = oJSON.Dasometricos;
            var Empresa_entidad = oJSON.Empresa_entidad;
            var Finca = oJSON.Finca;
            var Motosierra = oJSON.Motosierra;
            var Poligono = oJSON.Poligono;
            var Propietario = oJSON.Propietario;
            var Representante = oJSON.Representante;
            var Rodal = oJSON.Rodal;
            var SubirDocumentos = oJSON.SubirDocumentos;
            var Usuario = oJSON.Usuario;

            /**
             * tr_Cultivo
             * tr_Dasometricos
             * tr_Empresa_Entidad
             * tr_Finca
             * tr_Motosierra
             * tr_Poligono
             * tr_Propietario
             * tr_Representante
             * tr_Rodal
             * tr_Subir_Documentos
             * tr_Usuario
             */
            if (!Cultivo) {
                ocultar('tr_Cultivo');
            }

            if (!Dasometricos) {
                ocultar('tr_Dasometricos');
            }

            if (!Empresa_entidad) {
                ocultar('tr_Empresa_Entidad');
            }

            if (!Finca) {
                ocultar('tr_Finca');
            }

            if (!Motosierra) {
                ocultar('tr_Motosierra');
            }

            if (!Poligono) {
                ocultar('tr_Poligono');
            }

            if (!Propietario) {
                ocultar('tr_Propietario');
            }

            if (!Representante) {
                ocultar('tr_Representante');
            }

            if (!Rodal) {
                ocultar('tr_Rodal');
            }

            if (!SubirDocumentos) {
                ocultar('tr_Subir_Documentos');
            }

            if (!Usuario) {
                ocultar('tr_Usuario');
            }




        }).fail(function (error) {
            alert(error);
        });


    });
</script>