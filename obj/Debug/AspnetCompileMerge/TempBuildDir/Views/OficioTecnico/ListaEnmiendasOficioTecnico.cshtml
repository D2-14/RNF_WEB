@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@model List<Tbl_Gest_EtapaSolicitud_OficioTecnico_Enmienda>
@{

}
<table class="table table-striped table-hover" border="1">
    <thead>
        <tr>
            <th>
                Solicitud
            </th>
            <th>
                Etapa
            </th>
            <th>
                Ruta
            </th>
            <th>
                Correlativo
            </th>
            <th>
                Enmienda
            </th>
            <th colspan="2">
                Descripcion
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Solicitud_id
                </td>
                <td>
                    @item.Etapa_id
                </td>
                <td>
                    @item.EtapaRuta_id
                </td>
                <td>
                    @item.CorrelativoEtapa_id
                </td>
                <td>
                    @item.Enmienda_id
                </td>
                <td>
                    @item.Descripcion
                </td>
                <td>
                    <input type="button" class="btn btn-sm btn-danger" name="elminarEnmienda" id="elminarEnmienda" value="Eliminar" onclick=" eliminarEnmienda(@item.Enmienda_id) " />
                </td>
            </tr>
        }
    </tbody>
</table>

