<script>

    $(document).ready(function () {

        var varTipoIndustria = $('#Tipo_Industria_id').val();

      

        if (varTipoIndustria == 2) {
            var TdHiddeA = document.getElementById("DireccionMovil");
            TdHiddeA.style.display = "block";
            var TdHiddeA = document.getElementById("DireccionMovilD");
            TdHiddeA.style.display = "block";
        }
        else {
            var TdHiddeA = document.getElementById("DireccionMovil");
            TdHiddeA.style.display = "none";
            var TdHiddeA = document.getElementById("DireccionMovilD");
            TdHiddeA.style.display = "none";
        }



        $(document).on('change', '#Tipo_Industria_id', function () {
            var TipoIndustria = $('#Tipo_Industria_id').val();

            if (TipoIndustria == 2) {
                var TdHiddeA = document.getElementById("DireccionMovil");
                TdHiddeA.style.display = "block";
                var TdHiddeA = document.getElementById("DireccionMovilD");
                TdHiddeA.style.display = "block";
            }
            else {
                var TdHiddeA = document.getElementById("DireccionMovil");
                TdHiddeA.style.display = "none";
                var TdHiddeA = document.getElementById("DireccionMovilD");
                TdHiddeA.style.display = "none";
            }


        });


        $(document).on('change', '#DepartamentoEmpresaEntidad_id', function () {

            var url = "@Url.Action("GetMunicipios", "Sol_Solicitud")";
            var Departamento = $('#DepartamentoEmpresaEntidad_id').val();
            var data = { Departamento: Departamento};

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#MunicipioEmpresaEntidad_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text: municipio.Text
                    }));

                });


            }).fail(manejarErrorAjax).always(function () {
            });


        }); // -----Fin de Change ddlDepartamento

        $(document).on('change', '#DepartamentoEmpresaMovilEntidad_id', function () {

            var url = "@Url.Action("GetMunicipios", "Sol_Solicitud")";
            var Departamento = $('#DepartamentoEmpresaMovilEntidad_id').val();
            var data = { Departamento: Departamento};

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#MunicipioEmpresaEntidadMovil_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text: municipio.Text
                    }));

                });


            }).fail(manejarErrorAjax).always(function () {
            });


        }); // -----Fin de Change ddlDepartamento

    });

</script>


