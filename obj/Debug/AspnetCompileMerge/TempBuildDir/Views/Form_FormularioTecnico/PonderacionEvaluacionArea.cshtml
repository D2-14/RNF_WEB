@using RNF_Web.Models;


@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}


@model Tbl_Sol_Solicitud

@{
    db_RNFEntities db = new db_RNFEntities();

    ViewBag.CantidadFincas = db.Tbl_Sol_Finca.Where(Obj => Obj.Solicitud_id == Model.Solicitud_id).Count();

    if (ViewBag.CantidadFincas > 0)
    {
        ViewBag.MaxFincaId = db.Tbl_Sol_Finca.Where(Finca => Finca.Solicitud_id == Model.Solicitud_id).Max(u => u.Finca_Id);
    }
    else
    {
        ViewBag.MaxFincaId = 0;
    }

}

<script>
    $(document).ready(function () {
        $(document).on('change', '#PonderacionEvaluacionTecnicaDeArea_id', function () {

            var url = "@Url.Action("EvaluacionArea", "Form_FormularioTecnico")";
            var Opcion = $('#PonderacionEvaluacionTecnicaDeArea_id').val();
            var data = {
                Guid_id: '@ViewBag.guidid',
                Opcion: Opcion
            };

            $.post(url, data).done(function (ListData) {

            }).fail(manejaErrorAjax).always(function () {

            });

        });
    })


     function PlanoXFinca()
        {
         var MaxFincaId = @ViewBag.MaxFincaId;

         var Guid = '@ViewBag.guidid';

            var NoFinca = $('#No_Finca').val();

            if (NoFinca == 0)
            {
                alert('El número de finca no debe ser cero, debe ser valido, entre 1 y ' + MaxFincaId + ',  acorde al Id. de la finca para la que desea el plano')
            }
            else
            if (NoFinca > MaxFincaId)
            {
                alert('El número de finca debe ser valido, entre 1 y ' + MaxFincaId + ',  acorde al Id. de la finca para la que desea el plano')
            }
            else
            {
                window.open('/Form_FormularioTecnicoLocation/IndexRodalPlano?Guid_id=' + Guid + '&Finca_id=' + NoFinca + "&Rodal_id=0&Tipo_de_Area=0", '_blank');

            }

        }


    function descargarDatosPoligonos()
    {
        var url = "@Url.Action("DescargaDatosPoligonos", "Form_FormularioTecnico")";
            var Guid_id = '@ViewBag.guidid';
        var data = {
            Guid_id: Guid_id
        }

        $.post(url, data).done(function (jsonRespuesta) {
            var objJSON = JSON.parse(jsonRespuesta);
            var Ubicacion = objJSON.Ubicacion;
            //alert(Ubicacion);
            //window.open(Ubicacion, '_blank');
            download(Ubicacion,"CoordendasUsuario.xlsx")
        });
    }


</script>


