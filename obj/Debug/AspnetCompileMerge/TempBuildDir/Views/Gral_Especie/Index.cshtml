@model IEnumerable<RNF_Web.Models.Tbl_Gral_Especie>
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@{
    Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
    ViewBag.Title = "Especies";
    ViewBag.SubTitle = "Listado de especies";
}



<script>

    $(document).ready(function () {

        $("#btnHideModal").click(function () {


            $("#myModal").modal('hide');
        });


        $("#btnHideModal_Close").click(function () {



            $("#myModal").modal('hide');
        });


        $('#myModal').modal({
            backdrop: 'static',
            keyboard: false
        })

        $("#myModal").on('show.bs.modal', function () {
            var modal = $(this)
            modal.find('.modal-title').text(document.getElementById("Titulo").value);
            modal.find('.modal-body').html(document.getElementById("Pagina").value);
        });

    });


    function NuevaEspecie() {
        var Source = "/Gral_Especie/Create";

        document.getElementById("Pagina").value = '<iframe src="' + Source + '" frameborder="0" width="100%" height="100%"></iframe>';
        document.getElementById("Titulo").value = 'Agregar especie';
        $("#myModal").modal("show");

    }

    function encodeHTML(str) {
        const code = {
            ' ': '&nbsp;',
            '¢': '&cent;',
            '£': '&pound;',
            '¥': '&yen;',
            '€': '&euro;',
            '©': '&copy;',
            '®': '&reg;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            '&': '&amp;',
            '\'': '&apos;'
        };
        return str.replace(/[\u00A0-\u9999<>\&''""]/gm, (i) => code[i]);
    }

    function EditarEspecie(especieid) {
        var Source = encodeHTML("/Gral_Especie/Edit?especieid=" + especieid);


        document.getElementById("Pagina").value = '<iframe src="' + Source + '" frameborder="0" width="100%" height="100%"></iframe>';
        document.getElementById("Titulo").value = 'Editar especie';
        $("#myModal").modal("show");

    }


</script>

<script>


    function changeArbolFrutal(especieid, arbolfrutal) {
        var blArbolFrutal;
        if (arbolfrutal.checked) { blArbolFrutal = true;}
        else { blArbolFrutal = false;}

         $.ajax({
                type: 'POST',
                url: "@(Url.Action("SetArbolFrutal", "Gral_Especie"))",
                     dataType: 'json',
             data: { especieid: especieid, arbolfrutal: blArbolFrutal },
                   success: function (doc) {
                       alert('Cambio realizado con exito.');
                    },
                    error: function (ex) {
                        alert('Ocurrio un error aqui. ' + ex.status);
                    }

                });

    }


    function changeEstadoId(especieid, estado) {
        var intestado;
        if (estado.checked) { intestado = 1; }
        else { intestado = 0; }

        $.ajax({
                type: 'POST',
                url: "@(Url.Action("SetEspecieEstado", "Gral_Especie"))",
                     dataType: 'json',
            data: { especieid: especieid, intestado: intestado },
                   success: function (doc) {
                       alert('Cambio realizado con exito.');
                    },
                    error: function (ex) {
                        alert('Ocurrio un error aqui. ' + ex.status);
                    }

                });

    }


    function changeConifera(especieid, conifera) {
        var blconifera;
        if (conifera.checked) { blconifera = true; }
        else { blconifera = false; }


        if (conifera.checked) {
            document.querySelector('#Latifoliada_' + especieid).checked = false;
        }
        else {
            document.querySelector('#Latifoliada_' + especieid).checked = true;
        }

        $.ajax({
                type: 'POST',
                url: "@(Url.Action("SetEspecieConifera", "Gral_Especie"))",
                     dataType: 'json',
            data: { especieid: especieid, conifera: blconifera },
                   success: function (doc) {
                       alert('Cambio realizado con exito.');
                    },
                    error: function (ex) {
                        alert('Ocurrio un error aqui. ' + ex.status);
                    }

                });


    }


    function changeLatifoliada(especieid, latifoliada) {
        var bllatifoliada;
        if (latifoliada.checked) { bllatifoliada = true; }
        else { bllatifoliada = false; }

        if (latifoliada.checked) {
            document.querySelector('#Conifera_' + especieid).checked = false;
        }
        else {
            document.querySelector('#Conifera_' + especieid).checked = true;
        }

                $.ajax({
                type: 'POST',
                url: "@(Url.Action("SetEspecieLatifoliada", "Gral_Especie"))",
                     dataType: 'json',
                    data: { especieid: especieid, latifoliada: bllatifoliada },
                   success: function (doc) {
                       alert('Cambio realizado con exito.');
                    },
                    error: function (ex) {
                        alert('Ocurrio un error aqui. ' + ex.status);
                    }

                });

    }




</script>

