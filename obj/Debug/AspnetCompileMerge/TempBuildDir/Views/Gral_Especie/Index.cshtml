                {
                    <input type="checkbox" id="EstadoId_@item.Especie_Id" name="EstadoId_@item.Especie_Id" checked onclick="changeEstadoId('@item.Especie_Id', this)">
                }
                else
                {
                    <input type="checkbox" id="EstadoId_@item.Especie_Id" name="EstadoId_@item.Especie_Id" onclick="changeEstadoId('@item.Especie_Id', this)">
                }
                <br />
            </td>
            <td>
                <button class="btn-secondary" style="position: absolute; right: 0;" rel="tooltip" title="Editar" onclick="EditarEspecie('@item.Especie_Id')">
                    <i><img src="~/Content/icons/edit-9-xxl.png" style="border-radius: 30%; width: 30px; height: auto" /></i>
                    <div class="ripple-container"></div>
                </button>
            </td>
        </tr>
    }

</table>

