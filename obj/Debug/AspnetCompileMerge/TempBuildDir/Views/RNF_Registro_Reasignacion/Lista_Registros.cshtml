@using RNF_Web.Models;
@model IEnumerable<RNF_Registro_Informacion>
@if(Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}
@{

}
<table class="table">
    <tr>
        <th>
            No. Registro
        </th>
        <th>
            Expediente
        </th>
        <th>
            Fecha de Vencimiento
        </th>
        <th>
            DPI Titular
        </th>
        <th>
            Titular
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
<tr>
    <td>
        @Html.DisplayFor(modelItem => item.No_Registro)
    </td>
    <td>
        @Html.DisplayFor(modelItem => item.Expediente)
    </td>
    <td>
        @Html.DisplayFor(modelItem => item.Fecha_De_Vencimiento)
    </td>
    <td>
        @Html.DisplayFor(modelItem => item.DPI_Titular)
    </td>
    <td>
        @Html.DisplayFor(modelItem => item.Titular)
    </td>
    <td>
        <input type="button" name="transferir" value="Transferir" class="btn btn-sm btn-primary" onclick="transferirTitular('@item.No_Registro'); return false;" />
        <a type="button" class="btn btn-sm btn-primary" href="@Url.Action("","RNF_Gestor", new { No_Registro = item.No_Registro })">Gestionar</a>
    </td>
</tr>
}

</table>
