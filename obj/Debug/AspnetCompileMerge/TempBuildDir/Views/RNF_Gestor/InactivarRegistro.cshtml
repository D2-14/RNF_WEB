        <td>
            @Html.DropDownList("TiempoInactivacion", null, htmlAttributes: new { @class = "form-select" })
        </td>
    </tr>
    <tr>
        <th>
            Motivo
        </th>
        <td colspan="2">
            <textarea class="form-control" rows="5" id="Motivo" name="Motivo" placeholder="Razón de cancelación"></textarea>
        </td>
    </tr>
    <tr>
        <td>
        </td>
        <td>
        </td>
        <td>
            <input type="button" class="btn btn-success" value="Solicitar cancelación" onclick="agregarInactivacionTecnico()" />
        </td>
    </tr>
</table>

