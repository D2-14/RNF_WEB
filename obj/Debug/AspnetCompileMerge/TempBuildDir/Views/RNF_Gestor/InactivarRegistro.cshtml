    <tr>
        <td width="50%"></td>
        <td width="30%">
        </td>
        <td width="10%">
            <button rel="tooltip" title="Regresar" onclick="location.href='@Url.Action("", "RNF_Gestor", new { No_Registro = Model.No_Registro })'">
                <i><img src="~/Content/icons/regresar.png" style="border-radius: 30%; width: 40px; height: auto" /></i>
                <div class="ripple-container"></div>
                Regresar
            </button>
