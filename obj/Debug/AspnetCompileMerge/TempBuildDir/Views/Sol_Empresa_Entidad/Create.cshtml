@using RNF_Web.Models;
@model RNF_Web.Models.Tbl_Sol_Empresa_Entidad
@using System.Data.SqlClient;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@{

    db_RNFEntities db = new db_RNFEntities();
    Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(ViewBag.solicitud_id);

    EdicionSolicitudGrants objGrant = (EdicionSolicitudGrants)Session[Constants.session_EdicionSolicitudGrants];
    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    string Nombre_Div = "div_Sol_Permisos_Empresa_Entidad";
    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }
    fc_Gral_Sol_Configuracion_Result permisos = db.fc_Gral_Sol_Configuracion(tbl_sol_solicitud.Solicitud_id, controllerName, boolEsInterno).FirstOrDefault();
    ViewBag.Estado = tbl_sol_solicitud.Estado_id;
    ViewBag.SolicitudId = tbl_sol_solicitud.Solicitud_id;
    Tbl_Sol_Empresa_Entidad tbl_Sol_Empresa_Entidad = db.Tbl_Sol_Empresa_Entidad.Find(tbl_sol_solicitud.Solicitud_id);

    fc_Sol_EmpresasForestales_Result asignacionProcesos;

    if (tbl_Sol_Empresa_Entidad != null)
    {
        asignacionProcesos = db.fc_Sol_EmpresasForestales(tbl_sol_solicitud.Solicitud_id).FirstOrDefault();
    }
    else
    {
        asignacionProcesos = null;
    }

    Layout = null;

}

