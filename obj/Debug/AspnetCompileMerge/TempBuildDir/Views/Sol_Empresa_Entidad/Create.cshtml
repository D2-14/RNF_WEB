<script>
    function visualizarPermisos(solicitudid, controllername, esinterno, nombrediv) {
        var solicitudId = solicitudid;
        var controllerName = controllername;
        var esInterno = esinterno;

        var mySolPermisos = document.getElementById(nombrediv);
        if (mySolPermisos) {
            $("#" + nombrediv).load("/Gral_SolicitudConfiguracion/PermisosRecibidos?Solicitud_id=" + solicitudId + "&controllerName=" + controllerName + "&EsInterno=" + esInterno);
        }

    }


    $(document).ready(function () {

        $('#section_Link_0').load('@ViewBag.section_Link_0')
        $('#section_Link_1').load('@ViewBag.section_Link_1')
        $('#section_Link_2').load('@ViewBag.section_Link_2')
        $('#section_Link_3').load('@ViewBag.section_Link_3')
        $('#section_Link_4').load('@ViewBag.section_Link_4')
        $('#section_Link_5').load('@ViewBag.section_Link_5')
        var myRegionSubRegion_EmpresaEntidad = document.getElementById("div_RegionSubRegion_EmpresaEntidad");
        if (myRegionSubRegion_EmpresaEntidad) {
            $("#div_RegionSubRegion_EmpresaEntidad").load("/Sol_RegionSubRegion/IndexEmpresaEntidad");
        }
        var myEmpresa_Entidad_RNF = document.getElementById("div_Empresa_Entidad_RNF");
        if (myEmpresa_Entidad_RNF) {
            //$("#div_Empresa_Entidad_RNF").load("/Sol_Comparativo/Empresa_Entidad?Solicitud_id=@Model.Solicitud_id");
        }

        visualizarPermisos('@tbl_sol_solicitud.Solicitud_id', '@controllerName', '@objUs.EsInterno', '@Nombre_Div');

        OrdenarCombo();

    });

    //Ordenar Registro de Empresa Forestal Vinculada
    function OrdenarCombo(){
        var dropdown = $("#RNF_Inscripcion_Vinculada");
        var sortedOptions = dropdown.find("option").sort(function (a, b) {
            return a.text.localeCompare(b.text);
        });
        dropdown.html(sortedOptions);
    }
    function GrabarTipoIndustria() {
        var TipoIndustria = $('#lstTipoIndustria').val();

        var url = "@Url.Action("GrabarTipoIndustria", "Sol_Empresa_Entidad")";
        var SolicitudId = @ViewBag.SolicitudId;
        var TipoIndustriaId = $('#lstTipoIndustria').val();

        var data = {
            SolicitudId: SolicitudId,
            TipoIndustriaId: TipoIndustriaId
        };

        $.post(url, data).done(function (jsonRespuesta) {

            var objJSON = JSON.parse(jsonRespuesta);
            var Cod_Respuesta = objJSON.CodRespuesta;
            var Texto_Respuesta = objJSON.strRespuest;

        });
    }


</script>
