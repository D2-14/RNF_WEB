@model IEnumerable<RNF_Web.Models.fc_RNF_Sel_RodalPoligono_Result>
@using RNF_Web.Models;
@using System.Data.SqlClient;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}


@{
    string Guid_id = ViewBag.Guid_id;
    Layout = "~/Views/Shared/_LayoutBanner.cshtml";
}

<script src="~/Scripts/leaflet/leaflet.js"></script>
<script src="~/Scripts/leaflet.draw.js"></script>
<link href="~/Scripts/leaflet/leaflet.css" rel="stylesheet" />
<script src="~/Content/assets/js/jquery.min.js"></script>

<div class="container-fluid">
    <div>
        <div class="row">
            <div class="col-2" style="overflow: scroll; max-height:700px;">
                <div class="list-group" id="list-tab" role="tablist">
                    @foreach (var exec in Model.GroupBy(e => e.PROPERTY))
                    {

                        @*<a style="background-color: #c4f290;" class="list-group-item list-group-item-action disabled" data-toggle="list" role="tab">@exec.Key</a>*@


                        foreach (var loc in Model.Where(l => l.PROPERTY == exec.Key).GroupBy(g => g.NO_GRAPHIC))
                        {
                            <script type="text/javascript">
                                $(document).ready(function () {
                                    Coor(@loc.Key);
                             });

                            </script>
                            <a onclick="Coor(@loc.Key)"
                               class="list-group-item list-group-item-action" data-toggle="list" role="tab">@exec.Key</a>

                        }
                    }


                </div>
            </div>

            <div id="map" class="col-8" style="height:700px;">
            </div>

            <div class="col-2" style="height:600px;">
                <table class="table" hidden>
                    <thead class="thead-dark">
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col" hidden>Grafíco</th>
                            <th scope="col">Área</th>
                            <th scope="col">Solicitud</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td id="propietario"></td>
                            <td id="graf" hidden></td>
                            <td id="area"></td>
                            <td id="reg"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script>

    var map;
    var ajaxRequest;
    var plotlist;
    var plotlayers = [];
    var clear = false;
    map = new L.Map('map');
    var osmUrl = 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';
    var osmAttrib = 'Map data © <a href="https://openstreetmap.org">OpenStreetMap</a> contributors';
    var osm = new L.TileLayer(osmUrl, { minZoom: 2, maxZoom: 19, attribution: osmAttrib });
    map.setView(new L.LatLng(16, -90), 7);
    map.addLayer(osm);
    let contador = 1;
    let contadormenos = 1;
    let poly = [];
    let ViewSet = [];



    let vermapa = () => {
        var group = new L.featureGroup(ViewSet);

        map.fitBounds(group.getBounds(), { padding: [50, 50] });
    }

    function initmap(data, graph, varColor, property) {

        poly[contador] = L.polygon([data], { color: varColor }).addTo(map);

        poly[contador].bindTooltip(" " + property, { permanent: false, direction: 'center' }).openTooltip();

       map.fitBounds(poly[contador].getBounds());

        vermapa()

        contador++;

    }

   const Coor = (ID_COOR) => {
            let miResultado = [];
            let co = ID_COOR;

       fetch("@Url.Content("~/RNF_Locacion/ObtenerRodalCoordenadas?Guid_id="+Guid_id)")
            .then(function (res) {
                return res.json();
            })
            .then(function (miJson) {
                let property = '';
                let graph = '';
                let area = '';
                let reg = '';
                let strColor = '';
                for (let i = 0; i < miJson.length; i++) {
                    if (miJson[i].NO_GRAPHIC == co) {
                        miResultado.push([miJson[i].LAT, miJson[i].LON])
                        property = miJson[i].PROPERTY
                        graph = miJson[i].NO_GRAPHIC
                        area = miJson[i].AREA
                        reg = '@Guid_id'
                            strColor = miJson[i].COLOR

                        var marker = L.marker([miJson[i].LAT, miJson[i].LON]);

                        ViewSet.push(marker);
                    }
                }

                document.getElementById("propietario").innerHTML = property
                document.getElementById("graf").innerHTML = graph
                document.getElementById("area").innerHTML = area
                document.getElementById("reg").innerHTML = reg
                initmap(miResultado, graph, strColor, property);
            })

    }



</script>


