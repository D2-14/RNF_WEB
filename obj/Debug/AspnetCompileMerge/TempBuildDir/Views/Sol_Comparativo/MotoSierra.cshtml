@model IEnumerable<RNF_Web.Models.Tbl_RNF_Motosierra>
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}


@if (Model.Count() > 0)
{
    <h3>Registro Actual</h3>
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Marca)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Modelo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cilindraje)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Potencia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.No_SerieMotosierra)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.No_Factura)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmpresaEmisoraFactura)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.No_Lote)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OtroDocumentoRespaldo)
            </th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Marca)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Modelo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cilindraje)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Potencia)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.No_SerieMotosierra)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.No_Factura)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmpresaEmisoraFactura)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.No_Lote)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OtroDocumentoRespaldo)
                </td>
            </tr>
        }

    </table>
}
