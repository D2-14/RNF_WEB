@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}

<style>
    .formation {
        height: auto;
        max-width: 90%;
        margin: 30px auto;
        border-radius: 10px;
        border-style: solid;
        border-color: #77DD77;
        padding: 20px;
        box-shadow: 10px 10px 5px 0px rgba(0,0,0,0.75);
        -webkit-box-shadow: 10px 10px 5px 0px rgba(0,0,0,0.75);
        -moz-box-shadow: 10px 10px 5px 0px rgba(0,0,0,0.75);
    }
</style>

<script>

    function AsignarTecnico() {
        var varTecnico = $('#Tecnico').val();
        var varGuid_id = '@ViewBag.Guid_id';

            var data = {
                tecnico: varTecnico,
                Guid_id: varGuid_id
            }

            var url = "@Url.Action("AsignacionTecnicoForestal", "Form_FormularioSubRegional")";

            $.post(url, data).done(function (jsonRespuesta) {

                var objJSON = JSON.parse(jsonRespuesta);
                var Cod_Respuesta = objJSON.CodRespuesta;
                var Texto_Respuesta = objJSON.strRespuesta;

                if (Cod_Respuesta == 1) {
                    alert('👉 Asignación técnica realizada con éxito. \n ✉ Al aceptar se Notificará de forma electrónica.');
                } else
                {
                    alert(Texto_Respuesta);
                }
            });

    }


</script>

<div class="formation">

    <h3>
        Asignación tecnico forestal
    </h3>

    @Html.DropDownList("Tecnico", null, htmlAttributes: new { @class = "form-select" })
    <br />
    &nbsp;&nbsp;&nbsp;&nbsp;
    <img id="imgAddme" src="~/Content/icons/EnviarMail.png" onmouseover="this.style.cursor='hand'" onmouseout="this.style.cursor='default'" onclick="AsignarTecnico()" width="280" height="auto" />
    <br />

</div>
