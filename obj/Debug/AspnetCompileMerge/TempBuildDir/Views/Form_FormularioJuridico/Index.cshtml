@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw("Form_FormularioJuridico/Index")
}


@{
    ViewBag.Title = "   Etapa";
    Layout = null;
}


<script type="text/javascript">

    $(document).ready(function () {


        $("#btnHideModal").click(function () {
            $("#imgModal").modal('hide');
        });
        $("#btnHideModalCerrar").click(function () {
            $("#modalRecepDocs").modal('hide');
        });

        $("#btnRecepcionDocs").click(function () {
            $("#modalRecepDocs").modal('show');
        });

        listarDocumentosRequeridos();

        @*for (let i = 0; i < 40; i++) {
            var myEle = document.getElementById('DivDoctosSubidosEspecificos_' + i);
            if (myEle) {
                $('#DivDoctosSubidosEspecificos_' + i).load('/Form_FormularioJuridico/IndexEspecificoGUID?id=' + i + '&GUID=@ViewBag.Guid_id')
            }
        }*@


    });

        function listarDocumentosRequeridos() {
        var Guid_id = '@ViewBag.Guid_id';

        var data = {
            Guid_id: Guid_id
        };


        var url = '@Url.Action("ConsultarDocumentosRequeridos", "Form_FormularioJuridico")';

        $.post(url, data).done(function (RespuestaJSON) {

            var oJSON = RespuestaJSON;
            console.log(oJSON);



            for (let i = 0; i < oJSON.length; i++) {

                var ElementoActual = oJSON[i];
                var Tipo_Documento_id = ElementoActual.Tipo_Documento_id;

                var myEle = document.getElementById('DivDoctosSubidosEspecificos_' + Tipo_Documento_id);
                if (myEle) {
                    $('#DivDoctosSubidosEspecificos_' + Tipo_Documento_id).load('/Form_FormularioJuridico/IndexEspecificoGUID?id=' + Tipo_Documento_id + '&GUID=@ViewBag.Guid_id')
                }

            }

            console.log(oJSON.length);




        }).fail(function (RespuestaJSON) {

            console.log(RespuestaJSON);

            alert('Ocurrió un error: ' + RespuestaJSON);

        });


    }

    function Mostrar(id, filename) {

        var varGUID = '@ViewBag.Guid_id';


            $.ajax({
                        type: 'POST',
                        url: "@(Url.Action("Obtenerhref", "Form_FormularioSecretaria"))",
                        dataType: 'json',
                data: { GUID: varGUID, id: id, varfilename: filename },
                success: function (doc) {


                    var imgDoc = document.getElementById("imDoc");
                    var ifDoc = document.getElementById("ifDoc");
                    var miHref = document.getElementById("miHref");

                    if (filename.split(".")[1] == "pdf" || filename.split(".")[1] == "PDF" ||
                        filename.split(".")[1] == "jpg" || filename.split(".")[1] == "JPG" ||
                        filename.split(".")[1] == "bmp" || filename.split(".")[1] == "BMP" ||
                        filename.split(".")[1] == "png" || filename.split(".")[1] == "PNG" ||
                        filename.split(".")[1] == "gif" || filename.split(".")[1] == "GIF") {

                        if (filename.split(".")[1] == "pdf" || filename.split(".")[1] == "PDF") {
                            imgDoc.src = "";
                            ifDoc.src = doc;
                            ifDoc.style.visibility = "visible";
                            miHref.href = doc;
                            $("#imgModal").modal('show');
                        }
                        else {

                            ifDoc.src = "";
                            imgDoc.src = doc;
                            miHref.href = doc;
                            $("#imgModal").modal('show');
                            ifDoc.style.visibility = "hidden";
                        }
                    }
                    else {
                        window.location.href = doc;
                    }

                },
                error: function (ex) {
                    alert('error. ' + ex.status);
                }

            });
            return false;

        }

    function cambioestadoverificado(Solicitud_id, Documento_id, Tipo_Documento_id, DocumentoVerificado) {

        varvalorVerificado = DocumentoVerificado.checked;


        var url = "@Url.Action("CambiarEstadoArchivoVerificadoNotario", "Form_FormularioJuridico")";
        var data = {
            Solicitud_id: Solicitud_id,
            Documento_id: Documento_id,
            Tipo_Documento_id: Tipo_Documento_id,
            DocumentoVerificado: varvalorVerificado
        };
        $.post(url, data).done(function (Listdata) {
        });
    }

</script>



<div style='height: 70px;  top:50%; width: 100%; background-color: darkgreen; color: white; '>
    <br />
    <h4> Documentos ingresados en la solicitud </h4>
</div>
<input type="file" style="visibility:hidden;" name="FileUpload" id="fileUpload" />

<table class="table" id="docSubidosConAnterioridad">
    <tbody>
        @foreach (var itemDocumentos in ViewBag.DocumentosPendientes)
        {
            <tr>
                <td>@itemDocumentos.Tipo_Documento_id</td>
                <td>@itemDocumentos.Nombre</td>
                <td>
                </td>
            </tr>
            <tr>
                <td></td>
                <td></td>
                <td colspan="2">
                    <div id='DivDoctosSubidosEspecificos_@itemDocumentos.Tipo_Documento_id'>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>



<div class="modal fade bd-example-modal-lg" tabindex="-1" id="imgModal" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true" width: 700px;>
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" onclick="hide_myModal()">
                    X
                </button>
                <h4 class="modal-title">Vista preliminar del documento cargado</h4>
            </div>
            <div class="modal-body">
                <a ID="miHref" name="miHref" href="" target="_blank" style="display:none">Ver en pagina Completa</a>
                <button class="btn-next" onclick="MostrarCompleta()" >Mostrar en página completa</button>

                <img src="~/Content/icons/click_hand.gif" width="80" />
                <img style="max-height:1000px;max-width:800px;height:auto;width:auto;" ID="imDoc" Visible="false" />
                <iframe ID="ifDoc" style="height:600px;width:800px;" visible="false"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-info" onclick="hide_myModal()">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>



