@using (Html.BeginForm(actionName: "CrearNuevoRegistro", controllerName: "Expediente_Secorf"))
{

    @Html.HiddenFor(model => model.Solicitud_id)
    @Html.HiddenFor(model => model.AreaTotalFincas)

    @Html.HiddenFor(model => model.Guid_id)
    @Html.HiddenFor(model => model.TipoGestion_id)

    @Html.HiddenFor(model => model.Estado_id)
    @Html.HiddenFor(model => model.swcreatedby)
    @Html.HiddenFor(model => model.swdatecreated)
    @Html.HiddenFor(model => model.swcreatedbyinterno)
    @Html.HiddenFor(model => model.swdateupdated)
    @Html.HiddenFor(model => model.swupdatedby)
    @Html.HiddenFor(model => model.swupdatedbyinterno)


    <div class="container-fluid">
        <div class="titulo-dos">
            <h4>Solicitud de inscripción de expediente de Obligaciones de Repoblación Forestal</h4>
        </div>

        <div id="MostrarCategoria">
            <div class="row mt-2">
                @Html.LabelFor(model => model.Procedencia_Expediente, "Número de Expediente", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.EditorFor(model => model.Procedencia_Expediente, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Procedencia_Expediente, "", new { @class = "text-danger" })
            </div>
            <div class="row mt-2">
                @Html.LabelFor(model => model.Procedencia_POA, "Número de POA", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.EditorFor(model => model.Procedencia_POA, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Procedencia_POA, "", new { @class = "text-danger" })
            </div>
            <div class="row mt-2">
                @Html.LabelFor(model => model.Procedencia_Licencia, "Número de Licencia", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.EditorFor(model => model.Procedencia_Licencia, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Procedencia_Licencia, "", new { @class = "text-danger" })
            </div>
            <div class="row mt-2">
                @Html.LabelFor(model => model.Procedencia_Modalidad, "Procedencia", htmlAttributes: new { @class = "control-label col-md-12" })
                <select id="Procedencia_Modalidad" name="Procedencia_Modalidad" class="form-control">
                    <option value="Con Incentivo PROBOSQUE">Con Incentivo PROBOSQUE</option>
                    <option value="Con Incentivo PINPEP">Con Incentivo PINPEP</option>
                    <option value="Sin Incentivo">Sin Incentivo</option>
                </select>
                @*@Html.EditorFor(model => model.Procedencia_Modalidad, new { htmlAttributes = new { @class = "form-control" } })*@
                @Html.ValidationMessageFor(model => model.Procedencia_Modalidad, "", new { @class = "text-danger" })
            </div>
            <div class="row mt-2">
                @Html.LabelFor(model => model.Procedencia_FechaInicioPeriodo, "Inicio de Periodo del Incentivo", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.EditorFor(model => model.Procedencia_FechaInicioPeriodo, new { htmlAttributes = new { @class = "form-control", @type = "date", Value = ViewBag.FechaInicio } })
                @Html.ValidationMessageFor(model => model.Procedencia_FechaInicioPeriodo, "", new { @class = "text-danger" })
            </div>
            <div class="row mt-2">
                @Html.LabelFor(model => model.Procedencia_FechaFinPeriodo, "Fin de Periodo del Incentivo", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.EditorFor(model => model.Procedencia_FechaFinPeriodo, new { htmlAttributes = new { @class = "form-control", @type = "date", Value = ViewBag.FechaFin } })
                @Html.ValidationMessageFor(model => model.Procedencia_FechaFinPeriodo, "", new { @class = "text-danger" })
            </div>
            <div class="row mt-2">
                @Html.LabelFor(model => model.Procedencia_InformeTecnico, "Informe de Evaluación de ORF", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.EditorFor(model => model.Procedencia_InformeTecnico, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Procedencia_InformeTecnico, "", new { @class = "text-danger" })
            </div>
            <div class="row mt-2">
                @Html.LabelFor(model => model.Procedencia_NombreSolicitante, "Nombre del solicitante", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.EditorFor(model => model.Procedencia_NombreSolicitante, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Procedencia_NombreSolicitante, "", new { @class = "text-danger" })
            </div>
            <div class="row mt-2">
                @Html.LabelFor(model => model.DPI_Titular, "DPI de Titular", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.EditorFor(model => model.DPI_Titular, new { htmlAttributes = new { @class = "form-control", onchange = "validarDPI()" } })
                @Html.ValidationMessageFor(model => model.DPI_Titular, "", new { @class = "text-danger" })
            </div>
            <div class="row mt-2">
                @Html.LabelFor(model => model.Categoria_id, "Categoría", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.DropDownList("Categoria_id", null, htmlAttributes: new { @class = "form-select" })
                @Html.HiddenFor(m => m.Categoria_id)
                @Html.ValidationMessageFor(model => model.Categoria_id, "", new { @class = "text-danger" })
            </div>
            <div id="LinkInformacionEmpresa" class="row mt-2" style="display:none">
                <a style="color: #191970; background-color: yellow; " onclick="InformacionEmpresas()">Click aquí para ver guía informativa</a>
            </div>
            <div class="row mt-2">
                @Html.LabelFor(model => model.Sub_Categoria_id, "Sub Categoría", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.DropDownList("Sub_Categoria_id", null, htmlAttributes: new { @class = "form-select" })
                @Html.HiddenFor(m => m.Sub_Categoria_id)
                @Html.ValidationMessageFor(model => model.Sub_Categoria_id, "", new { @class = "text-danger" })

                @Html.LabelFor(model => model.Sub_Sub_Categoria_id, "Especificación", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.DropDownList("Sub_Sub_Categoria_id", null, htmlAttributes: new { @class = "form-select" })
                @Html.HiddenFor(m => m.Sub_Sub_Categoria_id)
                @Html.ValidationMessageFor(model => model.Sub_Sub_Categoria_id, "", new { @class = "text-danger" })
            </div>
            <div class="row mt-2">
                @Html.LabelFor(model => model.Region_id, "Region", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.DropDownList("Region_id", null, htmlAttributes: new { @class = "form-select" })
                @Html.HiddenFor(m => m.Region_id)
                @Html.ValidationMessageFor(model => model.Region_id, "", new { @class = "text-danger" })
            </div>
            <div class="row mt-2">
                @Html.LabelFor(model => model.SubRegion_id, "SubRegion", htmlAttributes: new { @class = "control-label col-md-12" })
                @Html.DropDownList("SubRegion_id", null, htmlAttributes: new { @class = "form-select" })
                @Html.HiddenFor(m => m.SubRegion_id)
                @Html.ValidationMessageFor(model => model.SubRegion_id, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row mt-3">
            <h1 style="background-color:powderblue;">@TempData["MensajeSolicitudFail"]</h1>
            <div class="col">
                <div class="d-grid gap-2">
                    <a href="~/Expediente_Secorf/Index" class="btn-cancel">Cancelar el proceso</a>
                </div>
            </div>

            <div class="col">
                <div class="d-grid gap-2">
                    <input type="button" class="btn-next" value="Crear solicitud" onclick="crearRegistro()" />
                </div>
            </div>
        </div>
    </div>


}
