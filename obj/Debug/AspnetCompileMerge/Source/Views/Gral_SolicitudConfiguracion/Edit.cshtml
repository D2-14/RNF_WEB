@model RNF_Web.Models.Tbl_Gral_SolicitudConfiguracionTipo
@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

<script>

    $(document).ready(function () {
        $("#FormatoSolicitud_Fecha").datepicker({
            dateFormat: "dd/mm/yy",
            yearRange: "-120:+0",
            changeMonth: true,
            changeYear: true
        });
    });

</script>

<div class="form-horizontal">
    <h4>Tbl_Gral_SolicitudConfiguracionTipo</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.SolicitudTipo_id)
    @Html.HiddenFor(model => model.Descripcion)
    @Html.HiddenFor(model => model.DescripcionEnOficio)
    @Html.HiddenFor(model => model.CobroAsociadoHtml_td)
    @Html.HiddenFor(model => model.AnioVigencia)

    <div class="row">
        <div class="col-sm-3 col-md-3">
            <h5>Tipo</h5>
        </div>
        <div class="col-sm-3 col-md-3">
            <h5>Código</h5>
        </div>
        <div class="col-sm-3 col-md-3">
            <h5>Versión</h5>
        </div>
        <div class="col-sm-3 col-md-3">
            <h5>Fecha</h5>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-3 col-md-3">
            <h5>Formato de solicitud</h5>
        </div>
        <div class="col-sm-3 col-md-3">
            @Html.EditorFor(model => model.FormatoSolicitud_Codigo, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        <div class="col-sm-3 col-md-3">
            @Html.EditorFor(model => model.FormatoSolicitud_Version, new { htmlAttributes = new { @class = "form-control" } })

        </div>
        <div class="col-sm-3 col-md-3">
            @Html.TextBoxFor(model => model.FormatoSolicitud_Fecha, "{0:dd-MM-yyyy}", new { @class = "dateInput", @placeholder = "dd/mm/yyyy", data_val = false })
        </div>
    </div>

    <div class="row">
        <div class="col-sm-3 col-md-3">
            <h5>Boleta de decisión</h5>
        </div>
        <div class="col-sm-3 col-md-3">
            @Html.EditorFor(model => model.BoletaDeDecision_Codigo, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        <div class="col-sm-3 col-md-3">
            @Html.EditorFor(model => model.BoletaDeDecision_Version, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        <div class="col-sm-3 col-md-3">
            @Html.TextBoxFor(model => model.BoletaDeDecision_Fecha, "{0:dd-MM-yyyy}", new { @class = "dateInput", @placeholder = "dd/mm/yyyy", data_val = false })
        </div>
    </div>


    <div class="row">
        <div class="col-sm-3 col-md-3">
            <h5>Informe técnico</h5>
        </div>
        <div class="col-sm-3 col-md-3">
            @Html.EditorFor(model => model.InformeTecnico_Codigo, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        <div class="col-sm-3 col-md-3">
            @Html.EditorFor(model => model.InformeTecnico_Version, new { htmlAttributes = new { @class = "form-control" } })
        </div>
        <div class="col-sm-3 col-md-3">
            @Html.TextBoxFor(model => model.InformeTecnico_Fecha, "{0:dd-MM-yyyy}", new { @class = "dateInput", @placeholder = "dd/mm/yyyy", data_val = false })
        </div>
    </div>



    <br />
    <div class="row">
        <div class="col-sm-9 col-md-9">
        </div>
        <div class="col-sm-1 col-md-1">
            <input type="button" class="btn-next-ic" value="Actualizar" onclick="actualizar()" />
        </div>
        <div class="col-sm-2 col-md-2">
        </div>
    </div>
</div>



