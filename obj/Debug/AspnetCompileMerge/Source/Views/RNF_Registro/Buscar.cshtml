@using RNF_Web.Models;
@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}
@{
    Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
}

<script>
    function cambioBusquedaRNF() {
        loaderPantalla(true);
        var No_Registro = document.getElementById("No_Registro").value;
        var Expediente = document.getElementById("Expediente").value;
        var DPI_Titular = document.getElementById("DPI_Titular").value;

        No_Registro = No_Registro.replace(" ", "%20");
        Expediente = Expediente.replace(" ", "%20");
        DPI_Titular = DPI_Titular.replace(" ", "%20");

        No_Registro = No_Registro.replace("+", "%2B");
        Expediente = Expediente.replace("+", "%2B");
        DPI_Titular = DPI_Titular.replace("+", "%2B");

        $('#div_ListaRNFBuscar').load('/RNF_Registro/BuscarParams?No_Registro=' + No_Registro + "&Expediente=" + Expediente + "&DPI_Titular=" + DPI_Titular);
        loaderPantalla(false);

    }

    function valNo_Registro() {
        cambioBusquedaRNF();
    }

    function valExpediente() {
        cambioBusquedaRNF();
    }

    function valDPITitular() {
        cambioBusquedaRNF();
    }

    function transferirTitular(varkey) {
        var Source = "/RNF_Registro_Reasignacion/CambiarTitular?No_Registro=" + varkey;

        document.getElementById("Pagina").value = '<iframe src="' + Source + '" frameborder="0" width="100%" height="100%"></iframe>';
        document.getElementById("Titulo").value = 'Transferir titular mediante DPI';
        $("#myModal").modal("show");
        return false;
    }


</script>

<div>
    <table class="table table-striped">
        <tr>
            <th>No. Registro</th>
            <th>Expediente</th>
            <th>DPI de Titular</th>
        </tr>
        <tr>
            <td>
                <input type="text" id="No_Registro" name="No_Registro" value="" class="form-control" placeholder="PV-1" onchange="valNo_Registro()" />
            </td>
            <td>
                <input type="text" id="Expediente" name="Expediente" value="" class="form-control" placeholder="Exp.1" onchange="valExpediente()" />
            </td>
            <td>
                <input type="text" id="DPI_Titular" name="DPI_Titular" value="" class="form-control" placeholder="1234567890123" onchange="valDPITitular()" />
            </td>
        </tr>
    </table>
</div>

<div id="div_ListaRNFBuscar"></div>


<input type="hidden" id="Pagina" name="Pagina" value="">
<input type="hidden" id="Titulo" name="Titulo" value="">
<div class="container mt-3">
    <div class="modal fade bd-example-modal-lg" tabindex="-1" id="myModal" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true" width: 700px;>
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Modal Header</h4>
                    <button type="button" id="btnHideModal" class="btn btn-default">
                        X
                    </button>
                </div>
                <div class="modal-body">
                    <p>The <strong>show.bs.modal</strong>FFFF</p>
                </div>
                <div id="DatosPersonerias">
                    <br />
                    <br />
                    <br />
                </div>
                <div class="modal-footer">
                    <button type="button" id="btnHideModal_Close" class="btn btn-default">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        cambioBusquedaRNF();

        $('#myModal').modal({
            backdrop: 'static',
            keyboard: false
        })

        $("#myModal").on('show.bs.modal', function () {
            var modal = $(this)
            modal.find('.modal-title').text(document.getElementById("Titulo").value);
            modal.find('.modal-body').html(document.getElementById("Pagina").value);
        });


        $("#btnHideModal").click(function () {

            cambioBusquedaRNF();
            $("#myModal").modal('hide');
        });


        $("#btnHideModal_Close").click(function () {


            cambioBusquedaRNF();
            $("#myModal").modal('hide');
        });


    });




</script>
