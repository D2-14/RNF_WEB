@using RNF_Web.Models;
@using System.Data.SqlClient;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}

@model IEnumerable<RNF_Web.Models.Tbl_RNF_Empresa_Entidad_Vivero_Forestal>



@{
    db_RNFEntities db = new db_RNFEntities();
    string No_Registro = ViewBag.No_Registro;

    Tbl_RNF_Registro tbl_RNF_Registro = db.Tbl_RNF_Registro.Where(Obj => Obj.No_Registro == No_Registro).FirstOrDefault();
    Layout = null;

    EdicionRNFGrants objRNFGrants = (EdicionRNFGrants)Session[Constants.session_EdicionRNFGrants];

    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }

}


<div class="container-fluid">
    <div style='height: 30px; width: 100%; background-color: #66bb6a; color: white; '>
        <h4>Datos de Vivero(s) Forestal(es)</h4>
    </div>
    <br />


    <div class="row">
        @if (objRNFGrants.Agregar)
        {
            <div class="col-xs-5 col-md-5">
            </div>
            <div class="col-xs-3 col-md-3">
                Click en la imagen para agregar vivero forestal
            </div>
            <div class="col-xs-1 col-md-1">
                <span class="pull-right">
                    <img src="~/Content/icons/add_simple.png" onclick="Agregar_ViveroForestal('@No_Registro')" width="55" height="55" />
                </span>
            </div>
            <div class="col-xs-1 col-md-1">
            </div>
            <div class="col-xs-1 col-md-1">
            </div>
        }
    </div>

    <div class="col-sm-6 col-md-12">

        <table class="table">
            <tr>
                <th>Id</th>
                <th>
                    Nombre Cientifico
                </th>
                <th>
                    Produccion Anual Plantas
                </th>
                <th>
                    Nombre de la Finca
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Tbl_Gral_Departamento.Departamento)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Tbl_Gral_Municipio.Municipio)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Codigo_RNF)
                </th>
                <th>
                    Numero Nota Control
                </th>

            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Vivero_Forestal_id)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Tbl_Gral_Especie.NombreCientifico)

                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Produccion_Anual_Plantas)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre_Finca)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Tbl_Gral_Departamento.Departamento)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Tbl_Gral_Municipio.Municipio)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Codigo_RNF)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Numero_Nota_Control_Semilla_Certificada)
                    </td>
                    <td>
                        @if (objRNFGrants.Borrar)
                        {
                            <img src="~/Content/icons/trash_green.png" onclick="BorrarViveroForestal('@item.No_Registro', @item.Vivero_Forestal_id)" width="25" height="25" />
                        }
                    </td>
                </tr>
            }

        </table>
    </div>

</div>


