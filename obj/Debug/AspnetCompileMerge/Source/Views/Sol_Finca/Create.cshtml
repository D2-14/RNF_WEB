            var TdHiddeA = document.getElementById("No_Sigap");
            TdHiddeA.checked = true

            var TdHiddeB = document.getElementById("No_CONAP");
            TdHiddeB.checked = true

        }



        $(document).on('change', '#Area_SIGAP', function () {
            const AreaSIGAP = document.querySelector('#Area_SIGAP');
            if (AreaSIGAP.checked) {
                document.querySelector('#No_Sigap').checked = false;
                var TdHiddeA = document.getElementById("CategoriaSIGAP");
                TdHiddeA.style.display = "block";
            }
            else {
                document.querySelector('#No_Sigap').checked = true;
                var TdHiddeA = document.getElementById("CategoriaSIGAP");
                TdHiddeA.style.display = "none";
            }


        });

        $(document).on('change', '#No_Sigap', function () {
            const NoAreaSIGAP = document.querySelector('#No_Sigap');
