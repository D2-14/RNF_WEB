@model RNF_Web.Models.Tbl_Sol_Finca
@using RNF_Web.Models;
@using System.Data.SqlClient;

@using RNF_Web.Models;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}



@{
    db_RNFEntities db = new db_RNFEntities();
    Tbl_Sol_Solicitud tbl_sol_solicitud = db.Tbl_Sol_Solicitud.Find(Model.Solicitud_id);

    int intCategoria = db.Tbl_Sol_Solicitud_Categoria.Where(Obj => Obj.Categoria_id == tbl_sol_solicitud.Categoria_id && (Obj.Descripcion.Contains("Sistemas agroforestales") || Obj.Descripcion.Contains("Plantaciones forestales"))).Count();

    long MinFinca;

    try
    {
        MinFinca = db.Tbl_Sol_Finca.Where(Obj => Obj.Solicitud_id == tbl_sol_solicitud.Solicitud_id).OrderBy(P => P.Finca_Id).First().Finca_Id;
        MinFinca++;

    }
    catch
    {
        MinFinca = 0;
    }

    ViewBag.MinFinca = MinFinca;


    if ((intCategoria > 0))
    {
        ViewBag.intCategoria = 1;
    }
    else
    {
        ViewBag.intCategoria = 0;
    }

    Layout = "~/Views/Shared/_LayoutSimple.cshtml";

    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    string Nombre_Div = "div_Sol_Permisos_Sol_Finca_Create";
    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }
    fc_Gral_Sol_Configuracion_Result permisos = db.fc_Gral_Sol_Configuracion(tbl_sol_solicitud.Solicitud_id, controllerName, boolEsInterno).FirstOrDefault();

}


@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <div id="@Nombre_Div"></div>
}

<div id="listadoFincas" ></div>


<script src="~/Scripts/jquery-3.6.0.js"></script>
<link href="~/Content/themes/base/jquery-ui.min.css" rel="stylesheet" />
<script src="~/Scripts/jquery-ui-1.12.1.js"></script>

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script>

    function visualizarPermisos(solicitudid, controllername, esinterno, nombrediv) {
        var solicitudId = solicitudid;
        var controllerName = controllername;
        var esInterno = esinterno;

        var mySolPermisos = document.getElementById(nombrediv);
        if (mySolPermisos) {
            $("#" + nombrediv).load("/Gral_SolicitudConfiguracion/PermisosRecibidos?Solicitud_id=" + solicitudId + "&controllerName=" + controllerName + "&EsInterno=" + esInterno);
        }

    }


    function viewFincas()
    {
        $("#listadoFincas").load("/Sol_Finca/listadoFincas?Solicitud_id=@Model.Solicitud_id" + "&firma=@ViewBag.firma" );
        @*alert("/Sol_Finca/listadoFincas?Solicitud_id=@Model.Solicitud_id" + "&firma=@ViewBag.firma" );*@
    }

