<link type="text/css" rel="stylesheet" href="~/Content/assets/css/menuvertical.css" />
<input type="hidden" name="formContent" value="formContent" />


<script language="javascript">
    if (top.frames.length > 0) {
        window.open("home.jsf", "_blank");
        window.stop();
    }
    function mostrarMenuLateral() {
        var content = document.getElementById("formContent:contentAgenciaVirtual");
        if (content.getAttribute("class").includes("menuLateralVisible")) {
            content.setAttribute("class", content.getAttribute("class").replace("menuLateralVisible", ""));
        } else {
            content.setAttribute("class", content.getAttribute("class") + " menuLateralVisible");
        }
    }
</script>

<div class="content">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                @RenderBody()
            </div>
        </div>
    </div>
</div>

<script>
    window.addEventListener("beforeunload", function (e) {
