
@using RNF_Web.Models;

@{
    Usuario objUs = (Usuario)Session["User"];
    if (objUs != null)
    {
        ViewBag.Nombres = objUs.strNombre_Usuario;
    }
    else
    {
        ViewBag.Nombres = "REGISTRO DE NUEVO USUARIO";
    }
}



<script>
    function download(filename, NombreDescarga) {

        var element = document.createElement('a');
        element.setAttribute('href', filename);
        element.setAttribute('download', NombreDescarga);
        document.body.appendChild(element);
        element.click();
        //document.body.removeChild(element);
    }
</script>

