@using RNF_Web.Models;
@model List<Tbl_Gest_EtapaSolicitud_OficioSubRegional_Enmienda>
@{
    string chbCheck = "checked";
}


@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}




<table class="table table-striped table-hover" border="0">
    <thead>
        <tr>
            <th scope="col">
                Enmiendas SubRegional
            </th>
            <th>
                Escrita por
            </th>
            <th scope="col">
                Acción
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Descripcion
                </td>
                <td>
                    @if ((bool)item.EstadoEnmiendaTecnico_id)
                    {
                        <label class="text-primary">Técnico</label>
                    }
                    else if ((bool)item.EstadoEnmiendaJuridico_id)
                    {
                        <label class="text-primary">Jurídico</label>
                    }
                    else if ((bool)item.EstadoEnmiendaSubRegional_id)
                    {
                        <label class="text-primary">SubRegional</label>
                    }
                </td>
                <td>
                    @if ((bool)item.Estado_id)
                    {
                        <label class="switch">
                            <input type="checkbox" id="estado_@item.Enmienda_id" name="estado_@item.Enmienda_id" @if ((bool)item.Estado_id) { @chbCheck ; } onchange="cambioEstadoEnmiendaSubRegional( @item.Enmienda_id, @item.CorrelativoEtapa_id)" />
                            <span class="slider round"></span>
                        </label>
                    }
                    else
                    {
                        <label style="color:red;">Enmienda Inactiva</label>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>


