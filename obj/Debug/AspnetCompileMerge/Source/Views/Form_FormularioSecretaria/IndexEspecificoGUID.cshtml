@model IEnumerable<RNF_Web.Models.Tbl_Sol_DocumentoSubido>
@using RNF_Web.Models;


@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}


@{
    Layout = null;

    ViewBag.Estado = 1;

}




@if (Model.Count() > 0)
{
    <div style='height: 70px; width: 100%; background-color: darkgreen; color: white; '>
        <br />
        <h5 style="text-align: center;"> Documentos subido</h5>
    </div>
    <table class="table">
        @foreach (var item in Model)
        {
            <tr>
                <td width="50%"></td>
                <td width="10%"></td>
                <td width="30%"></td>
                <td width="10%"></td>

            </tr>
            <tr>
                <td>
                    Verificado de forma virtual
                </td>
                <td>

                    @if (item.DocumentoVerificado == null)
                    {
                        <input type="checkbox" name="verificado" id="verificado" value="@item.DocumentoVerificado" onclick="cambioestadoverificado('@item.Solicitud_id', '@item.Documento_id', '@item.Tipo_Documento_id', this)" unchecked />
                    }
                    else if ((bool)item.DocumentoVerificado == false)
                    {
                        <input type="checkbox" name="verificado" id="verificado" value="@item.DocumentoVerificado" onclick="cambioestadoverificado('@item.Solicitud_id', '@item.Documento_id', '@item.Tipo_Documento_id', this)" unchecked />
                    }
                    else if ((bool)item.DocumentoVerificado == true)
                    {
                        <input type="checkbox" name="verificado" id="verificado" value="@item.DocumentoVerificado" onclick="cambioestadoverificado('@item.Solicitud_id', '@item.Documento_id', '@item.Tipo_Documento_id', this)" checked />
                    }


                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FileName)
                </td>
                <td>
                    <img src="~/Content/icons/ver.png" onclick="Mostrar('@item.Tipo_Documento_id', '@item.FileName')" width="50" />
                </td>

            </tr>
        }

    </table>
}

