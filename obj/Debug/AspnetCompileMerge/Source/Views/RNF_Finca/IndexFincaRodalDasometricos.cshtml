<script>
        $(document).ready(function () {
            var div_EspeciesForestales_Probosque = document.getElementById("div_EspeciesForestales_Probosque");
            var div_EspeciesForestales_PinpepOld = document.getElementById("div_EspeciesForestales_PinpepOld");
            var div_EspeciesProteger_PinpepOld = document.getElementById("div_EspeciesProteger_PinpepOld");
            var div_EspeciesForestales_Secorf = document.getElementById("div_EspeciesForestales_Secorf");

            if (div_EspeciesForestales_Probosque) {
                $('#div_EspeciesForestales_Probosque').load('/RNF_Finca_ProcedenciaExterna/Probosque_EspeciesForestales?No_Registro=@tbl_RNF_Registro.No_Registro');
            }
            if (div_EspeciesForestales_PinpepOld) {
                $('#div_EspeciesForestales_PinpepOld').load('/RNF_Finca_ProcedenciaExterna/PinpepOld_EspeciesForestales?No_Registro=@tbl_RNF_Registro.No_Registro');
            }
            if (div_EspeciesProteger_PinpepOld) {
                $('#div_EspeciesProteger_PinpepOld').load('/RNF_Finca_ProcedenciaExterna/PinpepOld_EspeciesProteger?No_Registro=@tbl_RNF_Registro.No_Registro');
            }
            if (div_EspeciesForestales_Secorf) {
                $('#div_EspeciesForestales_Secorf').load('/RNF_Finca_ProcedenciaExterna/Secorf_EspeciesForestales?No_Registro=@tbl_RNF_Registro.No_Registro');
            }

        });
</script>
