@using RNF_Web.Models;
@using System.Data.SqlClient;

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    <h3>@this.Url.Action()</h3>
}


@{
    string Guid_id = ViewBag.Guid_id;
    db_RNFEntities db = new db_RNFEntities();

    Tbl_RNF_Registro tbl_RNF_Registro = db.Tbl_RNF_Registro.Where(Obj => Obj.No_Registro == Guid_id).FirstOrDefault();

    ViewBag.SolicitudGuid = tbl_RNF_Registro.GuidSolicitud_id;

    ViewBag.Solicitud_id = tbl_RNF_Registro.Solicitud_id;

    int Categoria_id = tbl_RNF_Registro.Categoria_id ?? 0;

    int intCategoriaPlantacion = db.Tbl_Sol_Solicitud_Categoria.Where(Obj => Obj.Descripcion.Contains("semilleras") && Obj.Categoria_id == tbl_RNF_Registro.Categoria_id).Count();

    int intCategoriaPlantacionesForestales = db.Tbl_Sol_Solicitud_Categoria.Where(Obj => Obj.Categoria_id == tbl_RNF_Registro.Categoria_id && (Obj.Descripcion.Contains("Plantaciones forestales") || Obj.Descripcion.Contains("Sistemas agroforestales") || Obj.Descripcion.Contains("Plantaciones de arboles frutales"))).Count();

    ViewBag.intCategoriaPlantacion = intCategoriaPlantacion;

    ViewBag.intCategoriaPlantacionesForestales = intCategoriaPlantacionesForestales;

    ViewBag.Categoria_id = Categoria_id;

    ViewBag.AreaTotalFincas = tbl_RNF_Registro.AreaTotalFincas ?? 0;


    ViewBag.AreaTotalFincasSegunFincas = db.Tbl_RNF_Finca.Where(Obj => Obj.No_Registro == tbl_RNF_Registro.No_Registro).Sum(Obj => Obj.AreaTotal);


    ViewBag.intCantidadFincas = db.Tbl_RNF_Finca.Where(Obj => Obj.No_Registro == tbl_RNF_Registro.No_Registro).Count();

    EdicionRNFGrants objRNFGrants = (EdicionRNFGrants)Session[Constants.session_EdicionRNFGrants];

    Usuario objUs = new Usuario();
    objUs = (Usuario)Session["User"];
}



<script>
    $(document).ready(function () {

        actualizar();

        $(document).on('change', '#SubRegionFinca_id', function () {
            actualizar();
        });

        $(document).on('change', '#RegionFinca_id', function () {
            var url = "@Url.Action("GetSubRegion", "Sol_Solicitud")";
            var Region = $('#RegionFinca_id').val();
            var data = { Region: Region};

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#SubRegionFinca_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text:  municipio.Text
                    }));

                });
            }).fail(manejarErrorAjax).always(function () {
            });


        }); // -----Fin de Change ddlRegion

    });



    function actualizar()
    {
        var varRegionFinca_id = $('#RegionFinca_id').val();
        var varSubRegionFinca_id = $('#SubRegionFinca_id').val();
        var Guid_id = '@Guid_id';
        var data = {
            regionid: varRegionFinca_id,
            subregionid: varSubRegionFinca_id,
            Guid_id: Guid_id
        };


        var url = "@Url.Action("actualizarregion", "RNF_Finca")";

             $.post(url, data).done(function (jsonRespuesta) {

                var objJSON = JSON.parse(jsonRespuesta);
                var Cod_Respuesta = objJSON.CodRespuesta;
                var Texto_Respuesta = objJSON.strRespuesta;

                if (Cod_Respuesta == 0) {
                    $('#lblMensaje').text(Texto_Respuesta);
                } else if (Cod_Respuesta == 1) {
                    alert(Texto_Respuesta);

                }
            });

    }

    function actualizarArea()
    {

        var varArea = $('#inputArea').val();
        var Guid_id = '@Guid_id';
        var data = {
            areafinca: varArea,
            Guid_id: Guid_id
        };


        var url = "@Url.Action("actualizarArea", "RNF_Finca")";

             $.post(url, data).done(function (jsonRespuesta) {

                var objJSON = JSON.parse(jsonRespuesta);
                var Cod_Respuesta = objJSON.CodRespuesta;
                var Texto_Respuesta = objJSON.strRespuesta;

                if (Cod_Respuesta == 0) {
                    $('#lblMensaje').text(Texto_Respuesta);
                } else if (Cod_Respuesta == 1) {
                    refreshPartialViewGestor();
                    //location.reload();
                    //window.location.replace("/RNF_Registro/RegistroView/?No_RegistroLiteral=@tbl_RNF_Registro.No_RegistroLiteral&No_RegistroCorrelativo=@tbl_RNF_Registro.No_RegistroCorrelativo");
                    //var TdHiddeA = document.getElementById("section_Finca");
                    //TdHiddeA.style.display = "block";

                    //$('#lblMensaje').text(Texto_Respuesta);
                    //reload();
                }
            });

    }


</script>

@if (objRNFGrants.Editar)
{

    <table>
        <tr>
            <td>
                <h4 id="InputArea">Área total de las fincas (ha):</h4>
            </td>
            <td>
                <input type="number" id="inputArea" name="inputArea" value="@ViewBag.AreaTotalFincas" />
            </td>
            <td>
                <input type="button" value="Definir área" class="btn btn-success" onclick="actualizarArea()" />
            </td>
            <td>
                <h4 id="lblMensaje">  Área total definida:@ViewBag.AreaTotalFincas (ha)</h4>
            </td>

        </tr>

    </table>
}
else
{
    <table>
        <tr>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
                <h4 id="lblMensaje">  Área total definida:@ViewBag.AreaTotalFincas (ha)</h4>
            </td>

