            Observaciones: Observaciones,
            swcreatedby: @objUs.intUsuario_id,
            swcreatedbyinterno: @objUs.EsInterno
        };
    $.post(url, data).done(function (Listdata) {
    //  here inicio
    });
    }


</script>

