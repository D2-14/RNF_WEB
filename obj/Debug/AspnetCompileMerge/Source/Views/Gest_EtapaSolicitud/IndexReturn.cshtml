<div class="container mt-3">

    <div class="modal fade" id="mdReactivarEtapa" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
            <div class="modal-content">

                <form id="formEtapa">

                    <div class="modal-header">
                        <button type="button" id="btnHideModal" class="btn-next" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="container mb-4">
                        <div class="row mt-4">

                            <div class="col-md-5 offset-1">
                                <label>Nombre del Solicitante</label>
                                <input type="text" required class="form-control" name="Solicitante" id="Solicitante" />
                            </div>

                            <div class="col-md-3">
                                <label>Fecha de solicitud</label>
                                <input type="date" required class="form-control" name="Fecha" id="Fecha" />
                            </div>



                        </div>

                     

                        <div class="row mt-3">
                            <div class="col-md-10 offset-1">
                                <label>Motivo de la acción</label>
                                <textarea class="form-control" minlength="50" oninvalid="this.setCustomValidity('Debe ingresar al menos 50 caracteres')" oninput="this.setCustomValidity('')" required name="Motivo" id="Motivo" rows="3"></textarea>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" style="min-width:210px;" onclick="returnEtapa_(document.getElementById('Solicitante').value,document.getElementById('Fecha').value,document.getElementById('Motivo').value)"> <i class="fa fa-play" style="margin-right:8px"></i>Procesar Etapa</button>
                        <button type="button" id="mdReactivarEtapa_Close" style="min-width:160px;" class="btn btn-secondary px-lg-3" data-dismiss="modal">Cerrar</button>
                    </div>

                    </form>
            </div>
        </div>
    </div>
</div>


