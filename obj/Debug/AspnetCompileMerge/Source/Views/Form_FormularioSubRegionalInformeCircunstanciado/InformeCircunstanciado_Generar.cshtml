@model Tbl_Gest_EtapaSolicitud_InformeCircunstanciado

@{
    Layout = "~/Views/Shared/_LayoutMenuColaborador.cshtml";
    Layout = null;

    db_RNFEntities db = new db_RNFEntities();
    string GuidEtapa_id = ViewBag.GuidEtapa_id;
    string Guid_id = ViewBag.Guid_id;
    int etapa_id = ViewBag.etapa_id;
    decimal etaparuta_id = ViewBag.etaparuta_id;
    int correlativoetapa_id = ViewBag.correlativoetapa_id;

    int intEtapas = db.Tbl_Gest_EtapaSolicitud.Where(Obj => Obj.Solicitud_Guid_id == Guid_id && Obj.EtapaSolicitud_GUID_id != GuidEtapa_id && Obj.EtapaSolicitudEstado_id == 1).Count();


    Tbl_Sol_Solicitud tbl_Sol_Solicitud = db.Tbl_Sol_Solicitud.Find(Model.Solicitud_id);
    bool HabilitaBitacora = false;
    if ((tbl_Sol_Solicitud.Bitacora_id != null) && (tbl_Sol_Solicitud.Bitacora_id != 0))
    {
        HabilitaBitacora = true;
    }

    SqlParameter[] sqlParams;
    string p0, p1;
    p0 = "@Region_id";
    p1 = "@SubRegion_id";
    string sqlQuery = $"select [dbo].[Fnc_Gral_NombreSubDirectorRegional]({@p0},{@p1})";
    sqlParams = new SqlParameter[]
    {
    new SqlParameter { ParameterName = p0,  Value = tbl_Sol_Solicitud.Region_id, Direction = System.Data.ParameterDirection.Input },
    new SqlParameter { ParameterName = p1,  Value = tbl_Sol_Solicitud.SubRegion_id, Direction = System.Data.ParameterDirection.Input }
                                    };
    string NombreSubDirectorRegional = db.Database.SqlQuery<string>(sqlQuery, sqlParams).FirstOrDefault();

    sqlQuery = "SELECT dbo.Fnc_Gral_FechaTxt(getdate())";
    string strFecha = db.Database.SqlQuery<string>("SELECT dbo.Fnc_Gral_FechaTxt(getdate())").FirstOrDefault();


}
