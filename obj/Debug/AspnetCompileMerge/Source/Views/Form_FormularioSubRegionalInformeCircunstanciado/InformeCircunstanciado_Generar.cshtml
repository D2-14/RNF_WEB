<script>


    function agregarProcedimiento() {
        var Solicitud_id = '@tbl_Sol_Solicitud.Solicitud_id';
        var Procedimiento = document.getElementById("Procedimiento").value;
        var varSolicitud_Guid_id = '@Guid_id';
        var varEtapaSolicitud_GUID_id = '@GuidEtapa_id';

        var data = {
            Solicitud_id: Solicitud_id,
            Procedimiento: Procedimiento,
            Solicitud_Guid_id: varSolicitud_Guid_id,
            EtapaSolicitud_GUID_id: varEtapaSolicitud_GUID_id
        };


        var url = '@Url.Action("AgregarProcedimiento", "Form_FormularioSubRegionalInformeCircunstanciado")'

        $.post(url, data).done(function (RespuestaJSON) {
            var oJSON = RespuestaJSON;
            var Result = oJSON.Result;
            var Mensaje = oJSON.Mensaje;

            if (Result == 1) {
                refreshPartialEnmiendasCreateSolicitudInactivacion();
            } else {
                alert(Mensaje);
            }

        }).fail(function (RespuestaError) {
            console.log(RespuestaError);
            alert(RespuestaError);
        })
    }

    function editarProcedimiento(Procedimiento_id) {
        var Solicitud_id = '@tbl_Sol_Solicitud.Solicitud_id';

        var data = {
            Solicitud_id: Solicitud_id,
            Procedimiento_id: Procedimiento_id
        };

        var url = '@Url.Action("EliminarProcedimiento", "Form_FormularioSubRegionalInformeCircunstanciado")'

        var confirmacion = confirm("¿Desea modificar este procedimiento?");
        if (confirmacion) {
            var Source = '/Form_FormularioSubRegionalInformeCircunstanciado/Procedimientos_Edit?Solicitud_id=' + Solicitud_id + '&Procedimiento_id=' + Procedimiento_id;
            var Titulo = 'Modificación de procedimiento';
            openModalPartial(Source, Titulo);
        }
    }

    function eliminarProcedimiento(Procedimiento_id) {
        var Solicitud_id = '@tbl_Sol_Solicitud.Solicitud_id';

        var data = {
            Solicitud_id: Solicitud_id,
            Procedimiento_id: Procedimiento_id
        };

        var url = '@Url.Action("EliminarProcedimiento", "Form_FormularioSubRegionalInformeCircunstanciado")'

        $.post(url, data).done(function (RespuestaJSON) {
            var oJSON = RespuestaJSON;
            var Result = oJSON.Result;
            var Mensaje = oJSON.Mensaje;

            if (Result == 1) {
                refreshPartialEnmiendasCreateSolicitudInactivacion();
            } else {
                alert(Mensaje);
            }

        }).fail(function (RespuestaError) {
            console.log(RespuestaError);
            alert(RespuestaError);
        })
    }


    function generarBitacora() {
        var div_AgregarHallazgos_RNF = document.getElementById('div_AgregarHallazgos_RNF');
        if (div_AgregarHallazgos_RNF) {
            $('#div_AgregarHallazgos_RNF').load('/RNF_Registro_Reasignacion/AgregarHallazgo?No_Registro=@tbl_Sol_Solicitud.No_Registro&Bitacora_id=@tbl_Sol_Solicitud.Bitacora_id');
        }
    }

    function generarSolicitudInactivacion() {
        var varSolicitud_Guid_id = '@Guid_id';
        var varEtapaSolicitud_GUID_id = '@GuidEtapa_id';

        var data = {
            Solicitud_Guid_id: varSolicitud_Guid_id,
            EtapaSolicitud_GUID_id: varEtapaSolicitud_GUID_id
        }
        var url = "@Url.Action("ObtenerDocumentoInactivacion", "Form_FormularioSubRegionalInformeCircunstanciado")";

        $.post(url, data).done(function (jsonRespuesta) {
            loaderPantalla(false);

            var objJSON = jsonRespuesta;
            var Texto_Respuesta = objJSON.Ubicacion;
            var Result = objJSON.Result;
            var Mensaje = objJSON.Mensaje;
            if (Result == 1) {

                window.open('/Archivos_Generados_Que_Pueden_Borrar/' + Texto_Respuesta, '_blank');

                var TdHiddeA = document.getElementById("btnFirmarDocumento");
                TdHiddeA.style.display = "block";

            } else {
                alert(Mensaje);
            }

        });
    }

