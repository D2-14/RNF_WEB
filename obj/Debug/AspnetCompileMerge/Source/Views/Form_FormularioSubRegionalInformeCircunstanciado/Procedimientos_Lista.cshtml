@using RNF_Web.Models;
@model IEnumerable<RNF_Web.Models.Tbl_Gest_EtapaSolicitud_InformeCircunstanciado_Procedimientos>
@{
    Layout = null;
    long procedimientoid = 0;
}

@if(Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
}
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Procedimiento)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    procedimientoid++;
    <tr>
        <td>
            @procedimientoid @Html.DisplayFor(modelItem => item.Procedimiento)
        </td>
        <td>
            <input type="button" value="Editar" class="btn btn-success" onclick="editarProcedimiento('@item.Procedimiento_id')" />
            <input type="button" value="Eliminar" class="btn btn-primary" onclick="eliminarProcedimiento('@item.Procedimiento_id')" />
        </td>
    </tr>
}

</table>
