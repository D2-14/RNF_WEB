        function refreshMunicipio()
        {
            var url = "@Url.Action("GetMunicipiosRegion", "Sol_Solicitud")";
            var Departamento = $('#Notificacion_Departamento_id').val();
            var SubRegion = $('#SubRegion_id').val();

            var data = { Departamento: Departamento, SubRegionId: SubRegion };

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#Notificacion_Municipio_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text: municipio.Text
                    }));

                });
            }).fail(manejarErrorAjax).always(function () {

            });

        }


        $(document).on('change', '#Departamento_id', function () {
            refreshMunicipio();
        }); // -----Fin de Change ddlDepartamento


        $(document).on('change', '#Region_id', function () {

            var url = "@Url.Action("GetSubRegion", "Sol_Solicitud")";
            var Region = $('#Region_id').val();
            var data = { Region: Region};

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#SubRegion_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text:  municipio.Text
                    }));


                });
                refreshDepartamento();
            }).fail(manejarErrorAjax).always(function () {
            });

            /*///////////////*/





        }); // -----Fin de Change ddlRegion



        $(document).on('change', '#SubRegion_id', function () {
           refreshDepartamento();
        }); // -----Fin de Change ddlRegion



        $(document).on('change', '#Categoria_id', function () {

            var url = "@Url.Action("GetSubCategorias", "Sol_Solicitud")";
            var Categoria = $('#Categoria_id').val();
            var data = { Categoria: Categoria};

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#Sub_Categoria_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, SubCategoria) {
                    select.append($('<option/>', {
                        value: SubCategoria.Value,
                        text: SubCategoria.Text
                    }));

                });

                $('#Sub_Categoria_id').change()

            }).fail(manejarErrorAjax).always(function () {
            });


        }); // -----Fin de Change ddlDepartamento

        $(document).on('change', '#Sub_Categoria_id', function () {
            var Contador = 0;
            var url = "@Url.Action("GetSubSubCategorias", "Sol_Solicitud")";
            var Categoria = $('#Categoria_id').val();
            var SubCategoria = $('#Sub_Categoria_id').val();

            if ((Categoria == 1) && (SubCategoria == 2)) {
                location.replace("/UsuarioExterno/VisualizarMapa")
            }

            var data = { Categoria: Categoria, SubCategoria: SubCategoria  };

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#Sub_Sub_Categoria_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios


                $.each(Listdata, function (index, SubSubCategoria) {
                    Contador = Contador + 1;
                    select.append($('<option/>', {
                        value: SubSubCategoria.Value,
                        text: SubSubCategoria.Text
                    }));

                });

                if (Contador < 1) {
                    select.append($('<option/>', {
                        value: '0',
                        text: '-- No Aplica --'
                    }));
                }

            }).fail(manejarErrorAjax).always(function () {
            });


        }); // -----Fin de Change ddlDepartamento



    $(document).on('change', '#Notificacion_Departamento_id', function () {

            var url = "@Url.Action("GetMunicipios", "Sol_Solicitud")";
        var Departamento = $('#Notificacion_Departamento_id').val();
            var data = { Departamento: Departamento};

            $.post(url, data).done(function (Listdata) {
                //  here inicio

                var select = $("#Notificacion_Municipio_id");
                select.empty();

                //ListData  get the SelectList from GetMunicipios

                $.each(Listdata, function (index, municipio) {
                    select.append($('<option/>', {
                        value: municipio.Value,
                        text: municipio.Text
                    }));

                });


            }).fail(manejarErrorAjax).always(function () {
            });


        }); // -----Fin de Change ddlDepartamento


    }); // -----Fin de document ready function
</script>

