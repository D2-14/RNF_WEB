@using RNF_Web.Models;
@model IEnumerable<RNF_Web.Models.Tbl_Sol_Finca_PinpepOld_EspeciesProteger>
@{
    db_RNFEntities db = new db_RNFEntities();
    Layout = null;
    long Solicitud_id = ViewBag.Solicitud_id;
    Tbl_Sol_Solicitud tbl_Sol_Solicitud = db.Tbl_Sol_Solicitud.Find(Solicitud_id);

    string controllerName = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
    string Nombre_Div = "div_Sol_Permisos_Sol_Finca_Probosque_EspeciesProteger";
    Usuario objUs = (Usuario)Session["User"];
    bool boolEsInterno = false;
    if (objUs.EsInterno == 1)
    {
        boolEsInterno = true;
    }
    fc_Gral_Sol_Configuracion_Result permisos = db.fc_Gral_Sol_Configuracion(tbl_Sol_Solicitud.Solicitud_id, controllerName, boolEsInterno).FirstOrDefault();

}

@if (Constants.VisualizarInformacionDesarrollo == 1)
{
    @Html.Raw(this.Url.Action())
    <div id="@Nombre_Div"></div>
}

@if (((bool)permisos.Agregar) && tbl_Sol_Solicitud.Procedencia_PinpepOld)
{
    <input type="button" class="btn btn-success" value="Agregar Especies Proteger" onclick="AgregarEspecieProtegerPinpepOld()" />
}


@if (Model.Count() > 0)
{
    <table class="table">
        <tr>
            <th>
                Rodal
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Area)
            </th>
            <th>
                Especies a proteger
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Rodal_id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Area)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EspeciesProteger)
                </td>
                <td>
                    @if (((bool)permisos.Agregar) && tbl_Sol_Solicitud.Procedencia_PinpepOld && !(bool)item.RegistroExterno)
                    {
                        <input type="button" class="btn btn-danger" value="Borrar" onclick="BorrarEspecieProtegerPinpepOld('@item.Rodal_id')" />
                    }
                </td>
            </tr>
        }

    </table>
}
