@foreach (var exec in Model.GroupBy(e => e.PROPERTY))
{
    foreach (var loc in Model.Where(l => l.PROPERTY == exec.Key).GroupBy(g => g.NO_GRAPHIC))
    {
        <script type="text/javascript">
            $(document).ready(function () {
                Coor(@loc.Key);
            });
        </script>
    }
}

