<script>
    //MAPA
    var map;
    var ajaxRequest;
    var plotlist;
    var plotlayers = [];
    var clear = false;
    map = new L.Map('map', { zoomControl: false });
    map.setView(new L.LatLng(16, -90), 7);
    let contador = 1;
    let contadormenos = 1;
    let poly = [];
    let ViewSet = [];
    //ESCALA
    L.control.scale().addTo(map);
    //ICONO NORTE
    var north = L.control({ position: "topright" });
    north.onAdd = function (map) {
        var div = L.DomUtil.create("div", "info legend");
        div.innerHTML = '<img src="/Content/icons/FlechaMapa.png" style="max-height: 50px">';
        return div;
    }
    north.addTo(map);

    let vermarca = (lat, lon, label) => {
        let mk = new L.circleMarker([lat, lon], {
            fillOpacity: 0,
            color: 'black',
            weight: 1
        }).bindTooltip(label,
            {
                permanent: true,
                direction: 'center',
                className: 'labelstyle'
            });
        mk.addTo(map);
    }

    let vermapa = () => {

        var group = new L.featureGroup(ViewSet);

        map.fitBounds(group.getBounds(), { padding: [50, 50] });

    }



    function initmap(data, graph, varColor, property) {

        //poly[contador] = L.polygon([data], { color: varColor }).addTo(map);


        poly[contador] = L.polygon([data], {
            fillOpacity: 0,
            color: 'black',
            weight: 1
        }).addTo(map);

        //map.fitBounds(poly[contador].getBounds());

        vermapa()

        poly[contador].bindTooltip(" " + property, { permanent: true, direction: 'center' }).openTooltip();

        contador++;

    }

    function initmap_(data, graph, varColor, property) {

        poly[contador] = L.polygon([data], {
            fillOpacity: 0,
            color: 'black',
            weight: 1
        }).addTo(map);



        poly[contador].bindTooltip(" asdf" + property,
            {
                permanent: true,
                direction: 'center',
                className: 'labelstyle'
            }).openTooltip();


        vermapa()

        contador++;

    }

   const Coor = (ID_COOR) => {
            let miResultado = [];
            let co = ID_COOR;

       fetch("@Url.Content("~/RNF_Locacion/ObtenerFincaCoordenadasPlano?Guid_id="+ Guid_id)")
            .then(function (res) {
                return res.json();
            })
            .then(function (miJson) {
                let property = '';
                let graph = '';
                let area = '';
                let reg = '';
                let strColor = '';

                let start_i = 0;
                let current_co = -1;

                for (let i = 0; i < miJson.length; i++) {
                    if (miJson[i].NO_GRAPHIC == co) {

                        if (current_co != co)
                        {
                            start_i = i - 1;
                            current_co = co;
                        }

                        miResultado.push([miJson[i].LAT, miJson[i].LON])
                        property = miJson[i].PROPERTY
                        graph = miJson[i].NO_GRAPHIC
                        area = miJson[i].AREA
                        reg = '@Guid_id'
                        strColor = miJson[i].COLOR

                        var marker = L.marker([miJson[i].LAT, miJson[i].LON]);

                        vermarca(miJson[i].LAT, miJson[i].LON, (i - start_i).toString());

                        ViewSet.push(marker);

                    }
                }
                initmap(miResultado, graph, strColor, property);
            })

    }

    //// LINEA
    //let polylinear = new L.Polyline([[51.51, -0.10], [51.503, -0.10]], {
    //    color: 'red',
    //    weight: 3,
    //    opacity: 0.5,
    //    smoothFactor: 1
    //});
    //polylinear.addTo(map);


</script>


